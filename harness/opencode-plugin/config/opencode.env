# Environment for an OpenCode shell pointed at the EPYC orchestrator (HS-4 P0.3).
# Source this file before launching OpenCode. Each flag was checked at OpenCode @ 350c726aa.
# Do NOT set OPENCODE_PURE: it skips every external plugin, this one included
# (packages/opencode/src/plugin/index.ts:181), and requests would then go out with no x_* keys.
# Do NOT set OPENCODE_EXPERIMENTAL_NATIVE_LLM (session/llm.ts:226).

# --- EPYC wiring ---
export EPYC_ROOT="${EPYC_ROOT:-/workspace}"
export EPYC_ORCHESTRATOR_BASE_URL="${EPYC_ORCHESTRATOR_BASE_URL:-http://127.0.0.1:8000/v1}"
export EPYC_ORCHESTRATOR_REPO="${EPYC_ORCHESTRATOR_REPO:-/workspace/repos/epyc-orchestrator}"
export EPYC_ORCHESTRATOR_MCP_PYTHON="${EPYC_ORCHESTRATOR_MCP_PYTHON:-/mnt/raid0/llm/epyc-orchestrator/.venv/bin/python}"
: "${EPYC_USER_ID:?EPYC_USER_ID must be set (the plugin refuses to send unkeyed requests)}"
export EPYC_USER_ID

# --- OpenCode autonomy and egress OFF ---
export OPENCODE_DISABLE_MODELS_FETCH=1     # core/src/flag/flag.ts, core/src/models-dev.ts
export OPENCODE_DISABLE_AUTOUPDATE=1       # core/src/flag/flag.ts, cli/upgrade.ts
export OPENCODE_DISABLE_SHARE=1            # share/share-next.ts
export OPENCODE_DISABLE_CLAUDE_CODE=1      # prompt + skills (effect/runtime-flags.ts:22-29)
export OPENCODE_DISABLE_EXTERNAL_SKILLS=1  # effect/runtime-flags.ts:21
export OPENCODE_DISABLE_AUTOCOMPACT=1      # belt-and-braces for compaction.auto=false (config/config.ts)
export OPENCODE_DISABLE_PRUNE=1            # belt-and-braces for compaction.prune=false
export OPENCODE_DISABLE_DEFAULT_PLUGINS=1  # vendor auth plugins; all provider-scoped (plugin/index.ts:66-84)
export OPENCODE_DISABLE_LSP_DOWNLOAD=1     # no network downloads of LSP servers
export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=0
