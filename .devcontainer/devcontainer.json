{
  "name": "Agents Sandbox",
  "init": true,
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:UTC}",
      "CLAUDE_CODE_VERSION": "latest",
      "CODEX_VERSION": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "openai.chatgpt"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "terminal.integrated.defaultProfile.linux": "fish",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "fish": {
            "path": "fish"
          },
          "zsh": {
            "path": "zsh"
          }
        }
      }
    }
  },
  "remoteUser": "node",
  "postCreateCommand": "uv run --no-sync /workspace/.devcontainer/post_install.py",
  "mounts": [
    "source=/mnt/raid0/llm,target=/mnt/raid0/llm,type=bind",
    "source=/opt/AMD,target=/opt/AMD,type=bind,readonly",
    "source=commandhistory-epyc,target=/commandhistory,type=volume",
    "source=claude-code-config-epyc,target=/home/node/.claude,type=volume",
    "source=codex-config-epyc,target=/home/node/.codex,type=volume",
    "source=gh-config-epyc,target=/home/node/.config/gh,type=volume",
    "source=${localEnv:HOME}/.gitconfig,target=/home/node/.gitconfig,type=bind,consistency=cached,readonly",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=/opt/rocm-6.2.0,target=/opt/rocm,type=bind,readonly"
  ],
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "CODEX_HOME": "/home/node/.codex",
    "LD_LIBRARY_PATH": "/opt/AMD/aocc-compiler-5.0.0/lib:/mnt/raid0/llm/llama.cpp/build/bin:/mnt/raid0/llm/llama.cpp-dflash/build/bin:/opt/rocm/lib"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "privileged": true,
  "runArgs": [
    "--shm-size=16g",
    "--network=host",
    "--pid=host",
    "--ipc=host",
    "--ulimit",
    "memlock=-1:-1",
    "--ulimit",
    "core=0:0",
    "--device=/dev/kfd",
    "--device=/dev/dri",
    "--group-add=992"
  ],
  "postStartCommand": "sudo groupmod -g $(stat -c '%g' /var/run/docker.sock) docker 2>/dev/null || true",
  "remoteEnv": {
    "PATH": "/opt/rocm/bin:${containerEnv:PATH}",
    "ROCM_PATH": "/opt/rocm",
    "HIP_PATH": "/opt/rocm"
  }
}
