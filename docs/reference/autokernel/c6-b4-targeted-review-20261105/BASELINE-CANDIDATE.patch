+// Diagnostic-only logical block capture: the caller must provide a fresh private directory.
+// Exclusive creation makes an accidental second invocation fail closed. The external
+// consumer hashes bytes; no verdict or existing property threshold is changed.
+static void c6_capture_tensor(const char * dir, const char * label, const ggml_tensor * t) {
+    if (!t) GGML_ABORT("C6 capture null tensor");
+    const std::string path = std::string(dir) + "/" + label + ".bin";
+    int fd = open(path.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+    if (fd < 0) GGML_ABORT("C6 capture create failed");
+    const int64_t block = ggml_blck_size(t->type);
+    const size_t block_bytes = ggml_type_size(t->type);
+    if (block <= 0 || t->ne[0] % block != 0) GGML_ABORT("C6 capture invalid block shape");
+    std::vector<uint8_t> bytes;
+    for (int64_t i3=0; i3<t->ne[3]; ++i3)
+      for (int64_t i2=0; i2<t->ne[2]; ++i2)
+        for (int64_t i1=0; i1<t->ne[1]; ++i1)
+          for (int64_t i0=0; i0<t->ne[0]; i0+=block) {
+            const size_t offset = i3*t->nb[3] + i2*t->nb[2] + i1*t->nb[1] + (i0/block)*t->nb[0];
+            const size_t pos = bytes.size(); bytes.resize(pos + block_bytes);
+            ggml_backend_tensor_get(t, bytes.data()+pos, offset, block_bytes);
+          }
+    size_t off = 0;
+    while (off < bytes.size()) {
+        ssize_t n = write(fd, bytes.data() + off, bytes.size() - off);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) GGML_ABORT("C6 capture write failed");
+        off += static_cast<size_t>(n);
+    }
+    if (close(fd) != 0) GGML_ABORT("C6 capture close failed");
+    fprintf(stderr, "C6_CAPTURE %s type=%d ne=%" PRId64 ",%" PRId64 ",%" PRId64 ",%" PRId64 " nb=%zu,%zu,%zu,%zu bytes=%zu\n",
+        label, (int)t->type, t->ne[0], t->ne[1], t->ne[2], t->ne[3],
+        t->nb[0], t->nb[1], t->nb[2], t->nb[3], bytes.size());
+}
