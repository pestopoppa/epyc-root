+++ b/tools/server/nemo-profile.h
@@ -0,0 +1,94 @@
+#pragma once
+// Diagnostic timestamp/correlation instrument. Disabled builds retain normal decode.
+// Counts keep native meanings: n_decoded includes EOS/stops, not SSE emitted tokens.
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include <time.h>
+#include <unistd.h>
+#include <sys/syscall.h>
+#ifdef LLAMA_NEMO_BOUNDARY_PROFILE
+#include <roctx.h>
+#endif
+namespace nemo_profile {
+static constexpr const char * signature = "NEMO_SERVER_BOUNDARY_V1_C3_SYNCHRONIZED_DIAGNOSTIC";
+inline uint64_t now_ns() {
+    timespec t{};
+    if (clock_gettime(CLOCK_MONOTONIC, &t)) throw std::runtime_error("NEMO monotonic clock failed");
+    return uint64_t(t.tv_sec)*1000000000ULL + uint64_t(t.tv_nsec);
+}
+inline bool enabled() {
+#ifdef LLAMA_NEMO_BOUNDARY_PROFILE
+    const char * path = std::getenv("LLAMA_NEMO_BOUNDARY_JSONL");
+    return path && *path;
+#else
+    return false;
+#endif
+}
+inline uint64_t allocate() { static std::atomic<uint64_t> next{0}; return ++next; }
+inline void emit(const char * kind, const std::string & payload) {
+#ifdef LLAMA_NEMO_BOUNDARY_PROFILE
+    if (!enabled()) return;
+    static FILE * out = [] {
+        FILE * f = std::fopen(std::getenv("LLAMA_NEMO_BOUNDARY_JSONL"), "wx");
+        if (!f) throw std::runtime_error("NEMO output must be a new writable file");
+        return f;
+    }();
+    static std::mutex lock;
+    std::lock_guard<std::mutex> guard(lock);
+    const int rc = std::fprintf(out,
+        "{\"schema\":\"epyc.nemo.server-boundary.v1\",\"instrument\":\"%s\",\"kind\":\"%s\","
+        "\"clock_domain\":\"CLOCK_MONOTONIC\",\"observed_ns\":%llu,\"pid\":%ld,\"tid\":%ld,\"data\":%s}\n",
+        signature, kind, (unsigned long long)now_ns(), (long)getpid(),
+        (long)syscall(SYS_gettid), payload.c_str());
+    if (rc < 0 || std::fflush(out)) throw std::runtime_error("NEMO JSONL write failed");
+#else
+    (void) kind; (void) payload;
+#endif
+}
+inline void fiducial(uint64_t id, const char * edge) {
+#ifdef LLAMA_NEMO_BOUNDARY_PROFILE
+    const std::string label = std::string(signature) + ":clock_sync:" + std::to_string(id) + ":" + edge;
+    const auto before = now_ns(); roctxMarkA(label.c_str()); const auto after = now_ns();
+    emit("clock_sync", "{\"marker\":\"" + label + "\",\"before_ns\":" + std::to_string(before) +
+        ",\"after_ns\":" + std::to_string(after) + "}");
+#else
+    (void) id; (void) edge;
+#endif
+}
+class decode_range {
+    uint64_t id_, begin_ = 0, range_ = 0;
+    bool done_ = false;
+public:
+    explicit decode_range(uint64_t id): id_(id) {
+#ifdef LLAMA_NEMO_BOUNDARY_PROFILE
+        fiducial(id_, "before");
+        const std::string label = std::string(signature) + ":decode:" + std::to_string(id_);
+        begin_ = now_ns(); range_ = roctxRangeStartA(label.c_str());
+#endif
+    }
+    decode_range(const decode_range &) = delete;
+    ~decode_range() {
+#ifdef LLAMA_NEMO_BOUNDARY_PROFILE
+        if (!done_) { roctxRangeStop(range_); emit("decode_incomplete", "{\"decode_id\":" + std::to_string(id_) + "}"); }
+#endif
+    }
+    void finish(int rc) {
+#ifdef LLAMA_NEMO_BOUNDARY_PROFILE
+        const auto end = now_ns(); roctxRangeStop(range_); done_ = true;
+        emit("decode_end", "{\"decode_id\":" + std::to_string(id_) + ",\"start_ns\":" +
+            std::to_string(begin_) + ",\"completion_ns\":" + std::to_string(end) +
+            ",\"llama_decode_rc\":" + std::to_string(rc) +
+            ",\"completion_semantics\":\"host_after_llama_synchronize_on_success\",\"synchronized\":" +
+            (rc == 0 ? "true" : "false") + "}");
+        fiducial(id_, "after");
+#else
+        (void) rc;
+#endif
+    }
+};
+} // namespace nemo_profile
