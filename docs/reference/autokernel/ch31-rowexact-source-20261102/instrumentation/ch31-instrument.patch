--- /dev/null
+++ b/ggml/src/ggml-cpu/ch31_trace.h
@@ -0,0 +1,46 @@
+// CH31 diagnostic; Linux only. Set CH31_TRACE_DIR to an exclusive scratch dir.
+// This is an intrusive diagnostic, not a timing instrument.
+#if defined(__linux__)
+#include <unistd.h>
+static int ch31_hex256(const char *s) {
+    if (!s || strlen(s)!=64) return 0;
+    for (int i=0;i<64;i++) if (!((s[i]>='0' && s[i]<='9') || (s[i]>='a' && s[i]<='f'))) return 0;
+    return 1;
+}
+static int ch31_requested(const struct ggml_tensor * dst) {
+    const char * d=getenv("CH31_TRACE_DIR");
+    return d && *d && strcmp(dst->name,"node_13")==0 && dst->op==GGML_OP_MUL_MAT;
+}
+static int ch31_capture(const struct ggml_compute_params * params, const struct ggml_tensor * dst, char * stem, size_t cap) {
+    const char * dir = getenv("CH31_TRACE_DIR");
+    if (!dir || !*dir || params->ith != 0 || strcmp(dst->name, "node_13") != 0 || dst->op != GGML_OP_MUL_MAT) return 0;
+    static atomic_uint count = 0;
+    unsigned event = atomic_fetch_add(&count, 1);
+    if (event >= 64) { fprintf(stderr, "CH31 capture cap reached\n"); abort(); }
+    const char * model_sha=getenv("CH31_MODEL_SHA256"), * receipt_sha=getenv("CH31_PREGRANT_RECEIPT_SHA256"), * patch_sha=getenv("CH31_PATCH_SHA256");
+    if (dir[0] != '/' || !ch31_hex256(model_sha) || !ch31_hex256(receipt_sha) || !ch31_hex256(patch_sha)) { fprintf(stderr,"CH31 missing pregrant identity\n"); abort(); }
+    const struct ggml_tensor * a = dst->src[0], * b = dst->src[1];
+    if (!a || !b) { fprintf(stderr,"CH31 tensor metadata unavailable\n"); abort(); }
+    int n=snprintf(stem,cap,"%s/ch31-%ld-%04u",dir,(long)getpid(),event);
+    if (n<0 || (size_t)n+12>=cap) abort();
+    char path[4096];
+    snprintf(path, sizeof path, "%s-meta.txt", stem);
+    FILE * f = fopen(path, "wx"); if (!f) abort();
+    fprintf(f,"node=%s\nbase_source_commit=c72ec82f5417bb2937310326120f149b665e8400\ninstrumentation_patch_sha256=%s\nmodel_sha256=%s\npregrant_receipt_sha256=%s\nrowexact_n=%d\ndisable_rowexact=%d\nactivation_capture=UNAVAILABLE\n",dst->name,patch_sha,model_sha,receipt_sha,ggml_cpu_rowexact_n(),params->disable_rowexact);
+    for (int i=0; i<2; ++i) {
+        const struct ggml_tensor * t=i ? b : a;
+        fprintf(f,"src%d name=%s type=%s ne=%" PRId64 ",%" PRId64 ",%" PRId64 ",%" PRId64 " nb=%zu,%zu,%zu,%zu bytes=%zu contiguous=%d\n",i,t->name,ggml_type_name(t->type),t->ne[0],t->ne[1],t->ne[2],t->ne[3],t->nb[0],t->nb[1],t->nb[2],t->nb[3],ggml_nbytes(t),ggml_is_contiguous(t));
+    }
+    if (fclose(f)) abort(); return 1;
+}
+static void ch31_path(int enabled, const char * stem, const char * route) {
+    if (!enabled) return;
+    char path[4096]; if (snprintf(path,sizeof path,"%s-route.txt",stem) >= (int)sizeof path) abort();
+    FILE * f=fopen(path,"wx"); if (!f) abort();
+    if (fprintf(f,"%s\n",route)<0 || fclose(f)) abort();
+}
+#else
+static int ch31_requested(const struct ggml_tensor * t) { (void)t; return 0; }
+static int ch31_capture(const struct ggml_compute_params * p, const struct ggml_tensor * t, char * s, size_t n) { (void)p;(void)t;(void)s;(void)n;return 0; }
+static void ch31_path(int e, const char * s, const char * r) { (void)e;(void)s;(void)r; }
+#endif
