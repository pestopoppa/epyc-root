+    # -----------------------------------------------------------------------
+    # Command registration
+    # -----------------------------------------------------------------------
+
+    @staticmethod
+    def _normalize_command_name(name: str) -> str:
+        normalized = name.strip().lower().lstrip("/")
+        if not normalized:
+            raise ValueError("Plugin command name cannot be empty")
+        if any(ch.isspace() for ch in normalized):
+            raise ValueError(f"Plugin command name cannot contain whitespace: {name!r}")
+        return normalized
+
+    def register_command(
+        self,
+        *,
+        plugin_name: str,
+        name: str,
+        handler: Callable[[str], str | None],
+        description: str,
+        category: str = "Tools & Skills",
+        aliases: tuple[str, ...] = (),
+        args_hint: str = "",
+        subcommands: tuple[str, ...] = (),
+        cli_only: bool = False,
+        gateway_only: bool = False,
+    ) -> None:
+        """Register a plugin-defined slash command and handler."""
+        from hermes_cli.commands import CommandDef, register_plugin_command, resolve_command
+
+        command_name = self._normalize_command_name(name)
+        command_aliases = tuple(self._normalize_command_name(alias) for alias in aliases)
+        all_names = (command_name, *command_aliases)
+
+        for candidate in all_names:
+            if candidate in self._plugin_commands:
+                owner = self._plugin_command_owner.get(candidate, "another plugin")
+                raise ValueError(
+                    f"Plugin command '/{candidate}' already registered by {owner}"
+                )
+            if resolve_command(candidate) is not None:
+                raise ValueError(
+                    f"Plugin command '/{candidate}' conflicts with an existing command"
+                )
+
+        cmd = CommandDef(
+            name=command_name,
+            description=description,
+            category=category,
+            aliases=command_aliases,
+            args_hint=args_hint,
+            subcommands=subcommands,
+            cli_only=cli_only,
+            gateway_only=gateway_only,
+        )
+        register_plugin_command(cmd)
+
+        self._plugin_command_names.add(command_name)
+        for candidate in all_names:
+            self._plugin_commands[candidate] = handler
+            self._plugin_command_owner[candidate] = plugin_name
+
     def _load_directory_module(self, manifest: PluginManifest) -> types.ModuleType:
         """Import a directory-based plugin as ``hermes_plugins.<name>``."""
         plugin_dir = Path(manifest.path)  # type: ignore[arg-type]
