+    def test_register_command_adds_to_registry_and_handler(
+        self, tmp_path, monkeypatch, restore_command_registry
+    ):
+        """PluginContext.register_command() wires the command registry and handler."""
+        plugins_dir = tmp_path / "hermes_test" / "plugins"
+        plugin_dir = plugins_dir / "cmd_plugin"
+        plugin_dir.mkdir(parents=True)
