+def get_plugin_command_handler(name: str) -> Callable | None:
+    """Return the handler for a plugin slash command name or alias."""
+    normalized = PluginManager._normalize_command_name(name)
+    return get_plugin_manager()._plugin_commands.get(normalized)
+
+
+def invoke_plugin_command(name: str, args: str, **context: Any) -> Any:
+    """Invoke a plugin command handler with optional execution context.
+
+    Backwards compatible handlers that accept only ``args`` continue to work.
+    Context-aware handlers can accept ``context=...``, specific keyword names,
+    or ``**kwargs``.
+    """
+    handler = get_plugin_command_handler(name)
+    if handler is None:
+        return None
+
+    try:
+        sig = inspect.signature(handler)
+    except (TypeError, ValueError):
+        return handler(args)
+
+    params = sig.parameters
+    if any(p.kind == inspect.Parameter.VAR_KEYWORD for p in params.values()):
+        return handler(args, **context)
+    if "context" in params:
+        return handler(args, context=context)
+
+    kwargs = {
+        key: value
+        for key, value in context.items()
+        if key in params
+    }
+    if kwargs:
+        return handler(args, **kwargs)
+    return handler(args)
+
+
