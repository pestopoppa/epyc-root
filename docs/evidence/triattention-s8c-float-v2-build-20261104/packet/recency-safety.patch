diff --git a/src/llama-kv-compress-plan.h b/src/llama-kv-compress-plan.h
new file mode 100644
index 000000000..b7eb3d98a
--- /dev/null
+++ b/src/llama-kv-compress-plan.h
@@ -0,0 +1,84 @@
+#pragma once
+#include "llama-kv-cells.h"
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <limits>
+#include <vector>
+
+namespace llama_kv_compress_plan {
+struct cell { int pos; uint32_t index; };
+inline bool occupied(const llama_kv_cells & cells, int seq_id, std::vector<cell> & out) {
+    out.clear();
+    if (seq_id < 0 || seq_id >= LLAMA_MAX_SEQ || size_t(cells.size()) > size_t(std::numeric_limits<int>::max())) return false;
+    for (uint32_t i = 0; i < cells.size(); ++i) {
+        if (!cells.is_empty(i)) {
+            if (!cells.seq_has(i, seq_id) || cells.seq_count(i) != 1 || cells.pos_get(i) != int(i)) return false;
+            out.push_back({cells.pos_get(i), i});
+        }
+    }
+    std::sort(out.begin(), out.end(), [](const cell & a, const cell & b) { return a.pos < b.pos; });
+    for (size_t i = 0; i < out.size(); ++i) if (out[i].pos != int(i)) return false;
+    return true;
+}
+inline bool select(const std::vector<cell> & cells, const std::vector<float> & scores,
+                   int n_sink, float ratio, int keep_recent, float recency_ratio, std::vector<int> & out) {
+    out.clear();
+    if (n_sink < 0 || keep_recent < 0 || !std::isfinite(ratio) || ratio < 0 || ratio > 1 ||
+        !std::isfinite(recency_ratio) || recency_ratio < 0 || recency_ratio > 1 ||
+        (keep_recent > 0 && recency_ratio > 0)) return false;
+    for (size_t i = 0; i < cells.size(); ++i) {
+        if (cells[i].pos < 0 || (i && cells[i-1].pos >= cells[i].pos) ||
+            size_t(cells[i].pos) >= scores.size() || !std::isfinite(scores[cells[i].pos])) return false;
+    }
+    size_t sink = 0; while (sink < cells.size() && cells[sink].pos < n_sink) ++sink;
+    if (cells.size() - sink > size_t(INT32_MAX)) return false;
+    const int active = int(cells.size() - sink);
+    // Match the original size_t * float arithmetic: promoting the ratio to
+    // double changes integer boundaries for otherwise identical requests.
+    const float target_float = float(active) * ratio;
+    if (!std::isfinite(target_float) || double(target_float) > double(INT32_MAX)) return false;
+    const int target = int(target_float);
+    if (target > active) return false;
+    if (target <= 0) return true;
+    const int kept = int(cells.size()) - target;
+    const int requested = recency_ratio > 0 ? int(double(kept) * double(recency_ratio)) : keep_recent;
+    const int recent = std::min(requested, active - target);
+    const size_t end = cells.size() - recent;
+    std::vector<float> ordered;
+    for (size_t i = sink; i < end; ++i) ordered.push_back(scores[cells[i].pos]);
+    std::sort(ordered.begin(), ordered.end());
+    if (recent > 0 && target >= int(ordered.size())) {
+        for (size_t i = sink; i < end; ++i) out.push_back(cells[i].pos);
+    } else {
+        const float threshold = ordered[std::min(target, int(ordered.size())-1)];
+        for (size_t i = sink; i < end; ++i) if (scores[cells[i].pos] < threshold) out.push_back(cells[i].pos);
+    }
+    return true;
+}
+inline bool matches(const llama_kv_cells & after, int seq_id, const std::vector<cell> & before, const std::vector<int> & removed) {
+    if (after.size() < before.size()) return false;
+    std::vector<bool> expected(before.size(), true);
+    for (int p : removed) { if (p < 0 || size_t(p) >= expected.size()) return false; expected[p] = false; }
+    for (uint32_t i = 0; i < after.size(); ++i) {
+        const bool present = !after.is_empty(i);
+        if (i >= expected.size()) { if (present) return false; continue; }
+        if (present != expected[i] || (present && (after.pos_get(i) != int(i) || !after.seq_has(i, seq_id) || after.seq_count(i) != 1))) return false;
+    }
+    return true;
+}
+inline bool layout_ok(bool plain, unsigned streams, bool transposed, bool alias, bool shifted) {
+    return plain && streams == 1 && !transposed && !alias && !shifted;
+}
+// A failed callback stops immediately. Earlier successful ranges are NOT rolled back.
+struct removal { int removed; bool ok; };
+template<class Remove> removal remove(const std::vector<int> & pos, Remove fn) {
+    int removed = 0;
+    for (size_t i = 0; i < pos.size();) {
+        size_t j = i+1; while (j < pos.size() && pos[j] == pos[j-1]+1) ++j;
+        if (!fn(pos[i], pos[j-1]+1)) return {removed, false};
+        removed += int(j-i); i = j;
+    }
+    return {removed, true};
+}
+}
