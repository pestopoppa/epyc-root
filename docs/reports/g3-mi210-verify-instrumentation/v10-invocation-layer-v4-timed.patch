+// Diagnostic-only host-thread scope. Backend callbacks on another thread see 0
+// and remain uncorrelated instead of inheriting a process-global ID.
+static thread_local uint64_t ggml_g3_trace_invocation_id = 0;
+
+uint64_t ggml_g3_trace_set_invocation(uint64_t invocation_id) {
+    const uint64_t previous = ggml_g3_trace_invocation_id;
+    ggml_g3_trace_invocation_id = invocation_id;
+    return previous;
+}
+
+uint64_t ggml_g3_trace_get_invocation(void) {
+    return ggml_g3_trace_invocation_id;
+}
