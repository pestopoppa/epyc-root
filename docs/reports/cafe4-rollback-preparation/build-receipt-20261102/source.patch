+// CAFE-4 diagnostic: never use environment state to select a context.
+static llama_memory_recurrent * cafe4_recurrent(const struct llama_context * ctx) {
+    if (!ctx) return nullptr;
+    llama_memory_t mem = ctx->get_memory();
+    if (auto * r = dynamic_cast<llama_memory_recurrent *>(mem)) return r;
+    if (auto * h = dynamic_cast<llama_memory_hybrid *>(mem)) return h->get_mem_recr();
+    if (auto * h = dynamic_cast<llama_memory_hybrid_iswa *>(mem)) return h->get_mem_recr();
+    return nullptr;
+}
+
+bool llama_cafe4_target_configure(struct llama_context * ctx, int mode) {
+    if (mode < 0 || mode > 2) return false;
+    auto * r = cafe4_recurrent(ctx);
+    if (!r || r->n_rs_seq == 0) return false;
+    r->cafe4_selected.store(0);
+    r->cafe4_faulted.store(0);
+    r->cafe4_mode.store(mode);
+    return true;
+}
+
+bool llama_cafe4_target_counts(const struct llama_context * ctx, uint64_t * selected, uint64_t * faulted) {
+    auto * r = cafe4_recurrent(ctx);
+    if (!r || !selected || !faulted) return false;
+    *selected = r->cafe4_selected.load();
+    *faulted = r->cafe4_faulted.load();
+    return true;
+}
