diff --git a/tools/server/server-kpf-raw-logits.h b/tools/server/server-kpf-raw-logits.h
new file mode 100644
index 000000000..8c1531965
--- /dev/null
+++ b/tools/server/server-kpf-raw-logits.h
@@ -0,0 +1,74 @@
+#pragma once
+// Diagnostic only: one full-vocabulary float32 vector at the first ordinary
+// sampling step of each request. Caller owns request/task binding and custody.
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <cerrno>
+#include <filesystem>
+#include <sstream>
+#if defined(__unix__) || defined(__APPLE__)
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+inline std::vector<uint32_t> kpf_first_logits_snapshot(const float * logits, int n_vocab) {
+    static_assert(sizeof(float) == sizeof(uint32_t), "float32 required");
+    static_assert(std::numeric_limits<float>::is_iec559, "IEEE-754 required");
+    if (!logits || n_vocab <= 0) throw std::runtime_error("KPF first logits: missing vector");
+    std::vector<uint32_t> bits(n_vocab);
+    for (int i = 0; i < n_vocab; ++i) {
+        if (!std::isfinite(logits[i])) throw std::runtime_error("KPF first logits: nonfinite value");
+        std::memcpy(&bits[i], logits + i, sizeof(bits[i]));
+    }
+    return bits;
+}
+
+inline void kpf_first_logits_emit(const char * path, int slot, int task, int pos, int input_token,
+                                   int selected, const std::vector<uint32_t> & bits) {
+    if (!path || !*path || !std::filesystem::path(path).is_absolute() ||
+        slot < 0 || task < 0 || pos < 0 || bits.empty())
+        throw std::runtime_error("KPF first logits: invalid output or binding");
+#if defined(__unix__) || defined(__APPLE__)
+    // Open the already-created file itself, refusing a final-component symlink.
+    // O_NONBLOCK ensures a malicious FIFO cannot hang the server before fstat.
+    const int fd = ::open(path, O_WRONLY | O_APPEND | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK);
+    if (fd < 0) throw std::runtime_error("KPF first logits: cannot open output");
+    struct fd_owner {
+        int fd;
+        ~fd_owner() { if (fd >= 0) ::close(fd); }
+    } file{fd};
+    struct stat st;
+    if (::fstat(fd, &st) != 0 || !S_ISREG(st.st_mode))
+        throw std::runtime_error("KPF first logits: output is not a regular file");
+    std::ostringstream out;
+    out << "{\"schema\":\"kpf.first_logits.v1\",\"scope\":\"first_token_speculation_disabled\",\"slot\":" << slot
+        << ",\"task\":" << task << ",\"position\":" << pos << ",\"input_token\":" << input_token
+        << ",\"selected_token\":" << selected << ",\"n_vocab\":" << bits.size() << ",\"float32_bits_u32\":[";
+    for (size_t i = 0; i < bits.size(); ++i) {
+        if (i) out << ',';
+        out << bits[i];
+    }
+    out << "]}\n";
+    if (!out) throw std::runtime_error("KPF first logits: cannot serialize output");
+    const std::string record = out.str();
+    size_t off = 0;
+    while (off < record.size()) {
+        const ssize_t n = ::write(fd, record.data() + off, record.size() - off);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) throw std::runtime_error("KPF first logits: write failed");
+        off += static_cast<size_t>(n);
+    }
+    // Observe close errors as well as write errors. The caller must check that
+    // each record is complete and use a private directory and a single writer.
+    file.fd = -1;
+    if (::close(fd) != 0) throw std::runtime_error("KPF first logits: close failed");
+#else
+    throw std::runtime_error("KPF first logits: unsupported platform");
+#endif
+}
