-int main() {
+// Caller supplies a new path inside its already claimed output directory.
+// Do not follow symlinks or overwrite any earlier capture.
+static bool emit_blob(const char * path, const std::vector<uint8_t> & data) {
+    int fd = open(path, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+    if (fd < 0) return false;
+    size_t pos = 0;
+    bool ok = true;
+    while (pos < data.size()) {
+        ssize_t n = write(fd, data.data() + pos, data.size() - pos);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) { ok = false; break; }
+        pos += static_cast<size_t>(n);
+    }
+    if (ok && fsync(fd) != 0) ok = false;
+    if (close(fd) != 0) ok = false;
+    return ok;
+}
+
