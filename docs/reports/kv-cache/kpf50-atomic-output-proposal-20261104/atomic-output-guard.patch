+def write_evidence(output: Path, rendered: str) -> None:
+    """Atomically publish to a new name; never truncate or replace a file.
+
+    The destination must not already exist. Creating a private temporary inode
+    with O_EXCL, then linking it into place with no-replace semantics, closes
+    the check-then-write alias race: if the destination is or becomes an input
+    alias, publication fails without writing through that alias.
+    """
+    output = Path(output)
+    name = output.name
+    if name in ("", ".", ".."):
+        raise EvidenceError("output must name a new file")
+    output.parent.mkdir(parents=True, exist_ok=True)
+    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
+    dir_fd = os.open(output.parent, flags)
+    temp_name = None
+    fd = None
+    try:
+        for _ in range(100):
+            candidate = f".kpf50-evidence-{secrets.token_hex(12)}.tmp"
+            try:
+                fd = os.open(candidate, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600, dir_fd=dir_fd)
+                temp_name = candidate
+                break
+            except FileExistsError:
+                continue
+        if fd is None or temp_name is None:
+            raise EvidenceError("could not allocate atomic output temporary")
+        with os.fdopen(fd, "w", encoding="utf-8", closefd=True) as stream:
+            fd = None
+            stream.write(rendered)
+            stream.flush()
+            os.fsync(stream.fileno())
+        # link() is atomic and fails if any destination entry already exists,
+        # including a symlink or hard link to the source JSONL.
+        os.link(temp_name, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd, follow_symlinks=False)
+        os.fsync(dir_fd)
+    except FileExistsError as exc:
+        raise EvidenceError("output already exists; refusing overwrite or source alias") from exc
+    finally:
+        if fd is not None:
+            os.close(fd)
+        if temp_name is not None:
+            try:
+                os.unlink(temp_name, dir_fd=dir_fd)
+            except FileNotFoundError:
+                pass
+        os.close(dir_fd)
 
 
