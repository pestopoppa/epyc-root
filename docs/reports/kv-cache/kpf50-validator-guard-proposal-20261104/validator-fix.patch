+def write_evidence(source: Path, output: Path, rendered: str) -> None:
+    """Write evidence only when the destination is a distinct file."""
+    source = Path(source)
+    output = Path(output)
+    try:
+        aliases = source.resolve() == output.resolve()
+        if not aliases and output.exists():
+            aliases = source.samefile(output)
+    except OSError as exc:
+        raise EvidenceError(f"cannot verify output path is distinct from source: {exc}") from exc
+    if aliases:
+        raise EvidenceError("output path aliases source JSONL; refusing to overwrite raw evidence")
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(rendered)
+
+
