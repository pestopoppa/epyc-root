+// Test-only accounting of state_write_data, not a chunk-export or transfer API.
+// Expected inventory is supplied independently; no model measurement follows.
+bool llama_kv_cache::count_state_data_for_test(
+        const cell_ranges_t & cr, const std::vector<kpf60::expected_tensor> & expected,
+        kpf60::totals & output) const {
+    if (other != nullptr || n_swa != 0 || swa_type != LLAMA_SWA_TYPE_NONE ||
+        v_trans || cr.strm >= v_cells.size() || cr.data.empty()) return false;
+    uint32_t prev_end = 0;
+    for (const auto & range : cr.data) {
+        if (range.first >= range.second || range.second > v_cells[cr.strm].size() || range.first < prev_end) return false;
+        prev_end = range.second;
+    }
+    for (const auto & layer : layers) {
+        if (cr.strm >= layer.k_stream.size() || cr.strm >= layer.v_stream.size()) return false;
+        auto * k = layer.k_stream[cr.strm];
+        auto * v = layer.v_stream[cr.strm];
+        if (!k || k->type != GGML_TYPE_F16 || !ggml_is_contiguous(k)) return false;
+        if (v && (v->type != GGML_TYPE_F16 || !ggml_is_contiguous(v))) return false;
+    }
+    // Refuse an externally supplied inventory that doesn't bind the exact selection.
+    for (const auto & item : expected) {
+        if (item.id.stream != cr.strm || item.cells.size() != cr.data.size()) return false;
+        for (size_t i = 0; i < cr.data.size(); ++i) {
+            if (item.cells[i].begin != cr.data[i].first || item.cells[i].end != cr.data[i].second) return false;
+        }
+    }
+    struct null_sink final : llama_io_write_i {
+        size_t bytes = 0;
+        bool valid = true;
+        void add(size_t n) {
+            if (n > std::numeric_limits<size_t>::max() - bytes) { valid = false; return; }
+            bytes += n;
+        }
+        void write(const void *, size_t n) override { add(n); }
+        void write_tensor(ggml_tensor *, size_t, size_t n) override { add(n); }
+        size_t n_bytes() override { return bytes; }
+    } sink;
+    struct adapter final : state_data_observer_i {
+        kpf60::checked_counter counter;
+        const std::vector<kpf60::expected_tensor> & expected;
+        std::map<kpf60::key, size_t> next;
+        bool valid = true;
+        explicit adapter(const std::vector<kpf60::expected_tensor> & e) : expected(e) {}
+        void metadata(size_t n) override { if (!counter.metadata(n)) valid = false; }
+        void tensor(uint32_t layer, bool is_key, uint32_t stream,
+                    ggml_tensor * tensor, size_t offset, size_t size) override {
+            if (!valid || !tensor) { valid = false; return; }
+            kpf60::key id{layer, stream, !is_key};
+            const kpf60::expected_tensor * match = nullptr;
+            for (const auto & item : expected) {
+                if (!(item.id < id) && !(id < item.id)) {
+                    if (match) { valid = false; return; }
+                    match = &item;
+                }
+            }
+            if (!match) { valid = false; return; }
+            size_t & i = next[id];
+            if (i >= match->cells.size()) { valid = false; return; }
+            const auto range = match->cells[i++];
+            // nb[1] is the cell stride on the checked contiguous F16 view.
+            const bool contiguous = ggml_is_contiguous(tensor);
+            if (!counter.tensor(layer, !is_key, stream, tensor->type == GGML_TYPE_F16,
+                                contiguous, tensor->nb[1], ggml_nbytes(tensor),
+                                range.begin, range.end, offset, size)) valid = false;
+        }
+    } observer(expected);
+    state_write_data(sink, cr, &observer);
+    kpf60::totals candidate{};
+    if (!sink.valid || !observer.valid || !observer.counter.finish(expected, candidate) ||
+        candidate.serialized != sink.n_bytes()) return false;
+    output = candidate;
+    return true;
+}
