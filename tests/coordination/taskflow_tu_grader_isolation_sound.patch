--- /dev/null
+++ b/scripts/autopilot/evals/dtap/tests/test_grader_isolation.py
@@ -0,0 +1,52 @@
+import errno
+from pathlib import Path
+import secrets
+import subprocess
+
+import pytest
+
+from scripts.autopilot.evals.dtap.harness.isolation import (
+    GraderReachable,
+    assert_grader_unreachable,
+    probe_grader_access,
+)
+
+
+@pytest.fixture
+def sentinel(tmp_path):
+    grader = tmp_path / "grader"
+    grader.mkdir()
+    path = grader / "sentinel"
+    path.write_text(secrets.token_hex(16), encoding="utf-8")
+    return path
+
+
+def test_reachable_grader_is_flagged(sentinel):
+    result = probe_grader_access(sentinel, launcher=[])
+    assert result["open_ok"] is True
+    with pytest.raises(GraderReachable):
+        assert_grader_unreachable(result)
+
+
+def test_isolated_launch_denies(sentinel):
+    scratch = sentinel.parent.parent
+    launcher = [
+        "unshare", "--user", "--map-root-user", "--mount",
+        "sh", "-c", 'mount -t tmpfs none "$1" && shift && exec "$@"', "--", str(scratch),
+    ]
+    try:
+        result = probe_grader_access(sentinel, launcher)
+    except subprocess.CalledProcessError as exc:
+        diagnostic = exc.stderr.strip()
+        if diagnostic in {
+            "unshare: write failed /proc/self/uid_map: Operation not permitted",
+            "unshare: unshare failed: Operation not permitted",
+        }:
+            pytest.skip(diagnostic)
+        raise
+
+    assert result["open_ok"] is False
+    assert result["open_errno"] in {errno.ENOENT, errno.EACCES}
+    assert result["listdir_ok"] is False
+    assert result["listdir_errno"] in {errno.ENOENT, errno.EACCES}
+    assert_grader_unreachable(result)
