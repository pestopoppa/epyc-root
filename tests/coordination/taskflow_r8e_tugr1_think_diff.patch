+++ b/scripts/autopilot/evals/dtap/tests/test_grader_isolation.py
@@ -0,0 +1,63 @@
+"""Grader-isolation tests for the DTAP tool-use harness.
+
+Proves that the ``probe_grader_access`` + ``assert_grader_unreachable``
+infrastructure works by:
+
+1. Running a probe with ``launcher=[]`` (current process) where a sentinel
+   file deliberately placed on-disk is reachable -- the assertion must raise.
+2. Running a probe inside a user/mount namespace via ``unshare`` where the
+   sentinel directory is remounted as an empty tmpfs -- the probe must report
+   denial (ENOENT).
+"""
+import os
+import subprocess
+import tempfile
+import uuid
+from pathlib import Path
+
+import pytest
+
+from harness.isolation import GraderReachable, probe_grader_access, assert_grader_unreachable
+
+
+def test_reachable_grader_is_flagged(tmp_path: Path) -> None:
+    """Probe with launcher=[] in the current process: sentinel is reachable, so the
+    assertion must raise GraderReachable."""
+    token = uuid.uuid4().hex
+    sentinel = tmp_path / token
+    sentinel.touch()
+
+    result = probe_grader_access(sentinel, launcher=[])
+    assert result.get("ok") is True
+    with pytest.raises(GraderReachable) as exc_info:
+        assert_grader_unreachable(result)
+    assert isinstance(exc_info.value.probe_result, dict)
+
+
+def test_isolated_launch_denies(tmp_path: Path) -> None:
+    """Probe inside an unshare namespace: the sentinel directory is remounted
+    as an empty tmpfs, so the file is not found.  If unshare is not available
+    the test is skipped."""
+    token = uuid.uuid4().hex
+    sentinel = tmp_path / token
+    sentinel.touch()
+
+    # unshare flags; directory substitution
+    sentinel_dir = str(sentinel.parent)
+    mount_cmd = f"mount -t tmpfs none {sentinel_dir} && exec $0 {sentinel}"
+    launcher = [
+        "unshare", "--user", "--map-root-user", "--mount",
+        "sh", "-c", mount_cmd,
+        sentinel_dir,  # becomes $0 for exec; rest is $@
+    ]
+
+    # Skip if unshare is not available (never pass vacuously).
+    try:
+        subprocess.run(["unshare", "--help"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
+    except (FileNotFoundError, subprocess.TimeoutExpired):
+        pytest.skip("unshare not available on this host")
+
+    result = probe_grader_access(sentinel, launcher=launcher)
+    # The mount hides the sentinel file; open should report ENOENT.
+    assert result.get("ok") is False
+    assert_grader_unreachable(result)  # should pass silently (no exception)
