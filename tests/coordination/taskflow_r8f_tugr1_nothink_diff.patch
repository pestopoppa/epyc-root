+++ b/scripts/autopilot/evals/dtap/tests/test_grader_isolation.py
@@ -0,0 +1,84 @@
+"""Grader isolation tests for TU-GR-1.
+
+Proves the harness's judge/grader isolation boundary is reachable
+(fails on a deliberately reachable grader) and that an isolated
+launch denies access.
+
+Two cases:
+  1. test_reachable_grader_is_flagged  – launcher=[] (plain subprocess),
+     the sentinel is reachable, assert_grader_unreachable must raise.
+  2. test_isolated_launch_denies        – launcher with unshare, expects
+     ENOENT/EACCES; skipped if unshare is not permitted.
+"""
+from __future__ import annotations
+
+import shutil
+from pathlib import Path
+
+import pytest
+
+from harness.isolation import (
+    GraderReachable,
+    assert_grader_unreachable,
+    probe_grader_access,
+)
+
+
+# ------------------------------------------------------------------ fixtures
+
+
+@pytest.fixture(scope="module")
+def sentinel():
+    """Create a random sentinel file in /tmp (outside any git worktree)."""
+    tmp_dir = Path("/tmp")
+    token = "grader-isolation-sentinel-"
+    sentinel = tmp_dir / f"{token}"
+    sentinel.write_text("", encoding="utf-8")
+    try:
+        yield sentinel
+    finally:
+        sentinel.unlink(missing_ok=True)
+
+
+# ------------------------------------------------------------------ tests
+
+
+def test_reachable_grader_is_flagged(sentinel):
+    """Control: launcher=[] means no isolation at all. The child process
+    can plainly read the sentinel, so assert_grader_unreachable must raise
+    GraderReachable. This is the 'fails on a deliberately reachable grader'
+    control required by TU-GR-1."""
+    launcher: list[str] = []
+    result = probe_grader_access(sentinel, launcher=launcher)
+    with pytest.raises(GraderReachable, match="grader sentinel was reachable"):
+        assert_grader_unreachable(result)
+
+
+def test_isolated_launch_denies(sentinel):
+    """Launch a child inside a new user + mount namespace via unshare.
+    The child should NOT be able to read the sentinel (outside the mount
+    namespace it is not visible), so assert_grader_unreachable must NOT raise.
+
+    If unshare is not available on this host, the test is skipped.
+    """
+    unshare = shutil.which("unshare")
+    if unshare is None:
+        pytest.skip("unshare not available on this host")
+
+    tmpdir = str(sentinel.parent)
+    launcher = [
+        unshare,
+        "--user",
+        "--map-root-user",
+        "--mount",
+        "sh", "-c",
+        f"mount -t tmpfs none {tmpdir} && exec python3 -c 'import sys; sys.exit(0)' --",
+    ]
+
+    try:
+        result = probe_grader_access(sentinel, launcher=launcher)
+    except FileNotFoundError:
+        pytest.skip("unshare command not found at expected path")
+
+    # The unshare child should fail to see the sentinel
+    assert_grader_unreachable(result)  # should NOT raise
