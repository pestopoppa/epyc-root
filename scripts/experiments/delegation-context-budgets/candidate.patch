@@ -0,0 +1,138 @@
+"""Offline controls for opt-in specialist input component budgets."""
+
+import json
+from dataclasses import replace
+from unittest.mock import MagicMock
+
+import pytest
+from src.api.routes import chat_delegation as CD
+from src.api.routes.chat_delegation_config import (
+    DelegationConfig,
+    DelegationContextBudget,
+    _delegation_context_budget,
+)
+
+ENV = "ORCHESTRATOR_DELEGATION_CONTEXT_BUDGETS"
+
+
+@pytest.fixture(autouse=True)
+def clean_environment(monkeypatch):
+    monkeypatch.delenv(ENV, raising=False)
+    monkeypatch.setattr(
+        "src.api.routes.chat_delegation_config._valid_delegate_roles",
+        lambda: frozenset({"worker_general", "coder_escalation"}),
+    )
+
+
+def test_defaults_and_role_mode_isolation(monkeypatch):
+    cfg = DelegationConfig.from_env()
+    legacy = DelegationContextBudget(cfg.specialist_context_chars, 2000)
+    assert _delegation_context_budget("worker_general", "repl", cfg) == legacy
+    monkeypatch.setenv(
+        ENV, json.dumps({"worker_general": {"repl": {"context_chars": 17, "discovery_budget": 31}}})
+    )
+    assert _delegation_context_budget("worker_general", "repl", cfg) == DelegationContextBudget(
+        17, 31
+    )
+    assert _delegation_context_budget("worker_general", "react", cfg) == legacy
+    assert _delegation_context_budget("coder_escalation", "repl", cfg) == legacy
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "[",
+        "[]",
+        "null",
+        '{"unknown":{}}',
+        '{"worker_general":[]}',
+        '{"worker_general":{"debug":{}}}',
+        '{"worker_general":{"repl":[]}}',
+        '{"worker_general":{"repl":{"typo":1}}}',
+        '{"worker_general":{"repl":{"context_chars":true}}}',
+        '{"worker_general":{"repl":{"context_chars":-1}}}',
+        '{"worker_general":{"repl":{"context_chars":100000}}}',
+        '{"worker_general":{"repl":{"discovery_budget":2001}}}',
+        '{"worker_general":{"repl":{"discovery_budget":1.5}}}',
+    ],
+)
+def test_invalid_configuration_fails_before_execution(monkeypatch, raw):
+    monkeypatch.setenv(ENV, raw)
+    repl = MagicMock()
+    monkeypatch.setattr(CD, "REPLEnvironment", repl)
+    with pytest.raises(ValueError):
+        CD._run_specialist_loop(
+            "q", "context", "brief", "worker_general", "repl", MagicMock(), None
+        )
+    repl.assert_not_called()
+
+
+def test_zero_budget_skips_discovery_before_feature_lookup(monkeypatch):
+    monkeypatch.setattr("src.features.features", lambda: pytest.fail("discovery must not run"))
+    assert CD._maybe_dcp_seed_context("q", code_search_fn=None, base_ctx="base", budget=0) == "base"
+
+
+@pytest.mark.parametrize("mode", ["repl", "react"])
+@pytest.mark.parametrize("chars,discovery", [(0, 0), (17, 31), (None, None)])
+def test_real_loop_passes_selected_caps_without_touching_question_or_brief(
+    monkeypatch, mode, chars, discovery
+):
+    cfg = replace(
+        DelegationConfig.from_env(),
+        compact_specialist_prompt=False,
+        specialist_corpus_context=False,
+    )
+    monkeypatch.setattr(CD, "_delegation_config", lambda: cfg)
+    if chars is not None:
+        monkeypatch.setenv(
+            ENV,
+            json.dumps(
+                {"worker_general": {mode: {"context_chars": chars, "discovery_budget": discovery}}}
+            ),
+        )
+    env = MagicMock()
+    repl = MagicMock(return_value=env)
+    seed = MagicMock(return_value="seeded corpus")
+    builder = MagicMock(return_value="assembled prompt")
+    monkeypatch.setattr(CD, "REPLEnvironment", repl)
+    monkeypatch.setattr(CD, "_maybe_dcp_seed_context", seed)
+    monkeypatch.setattr("src.prompt_builders.build_root_lm_prompt", builder)
+    primitives = MagicMock()
+    primitives.llm_call.side_effect = OSError("fixture stop; no model")
+    result = CD._run_specialist_loop(
+        "verbatim question", "x" * 1000, "verbatim brief", "worker_general", mode, primitives, None
+    )
+    assert "fixture stop" in result[0]
+    cap = cfg.specialist_context_chars if chars is None else chars
+    expected = CD._trim_block("x" * 1000, cap)
+    assert repl.call_args.kwargs["context"] == (
+        "verbatim brief" + ("\n\nContext:\n" + expected if expected else "")
+    )
+    assert seed.call_args.kwargs["budget"] == (2000 if discovery is None else discovery)
+    assert builder.call_args.kwargs["original_prompt"].startswith("verbatim question")
+    assert builder.call_args.kwargs["corpus_context"] == "seeded corpus"
+
+
+def test_partial_override_keeps_other_component_and_global_ceiling(monkeypatch):
+    cfg = replace(DelegationConfig.from_env(), specialist_context_chars=123)
+    monkeypatch.setenv(ENV, '{"worker_general":{"repl":{"discovery_budget":5}}}')
+    assert _delegation_context_budget("worker_general", "repl", cfg) == DelegationContextBudget(
+        123, 5
+    )
+    monkeypatch.setenv(ENV, '{"worker_general":{"repl":{"context_chars":124}}}')
+    with pytest.raises(ValueError):
+        _delegation_context_budget("worker_general", "repl", cfg)
+
+
+def test_unused_policy_is_validated(monkeypatch):
+    monkeypatch.setenv(ENV, '{"coder_escalation":{"react":{"discovery_budget":-1}}}')
+    with pytest.raises(ValueError):
+        _delegation_context_budget("worker_general", "repl", DelegationConfig.from_env())
+
+
+def test_empty_policy_preserves_defaults(monkeypatch):
+    cfg = DelegationConfig.from_env()
+    monkeypatch.setenv(ENV, '{"worker_general":{"repl":{}}}')
+    assert _delegation_context_budget("worker_general", "repl", cfg) == DelegationContextBudget(
+        cfg.specialist_context_chars
+    )
