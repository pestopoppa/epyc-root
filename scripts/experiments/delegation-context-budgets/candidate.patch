+@dataclass(frozen=True)
+class DelegationContextBudget:
+    """Input component caps; discovery uses packer estimates, never exact tokens."""
+
+    context_chars: int
+    discovery_budget: int = 2000
+
+
+def _delegation_context_budget(
+    delegate_to: str, delegate_mode: str, cfg: DelegationConfig,
+) -> DelegationContextBudget:
+    """Resolve an opt-in role/mode cap without enlarging legacy global limits.
+
+    ORCHESTRATOR_DELEGATION_CONTEXT_BUDGETS is a JSON object, for example
+    {"worker_general": {"repl": {"context_chars": 600, "discovery_budget": 1000}}}.
+    Missing entries retain legacy limits. Invalid configuration fails before
+    specialist execution; all entries are validated, including unselected ones.
+    Question/brief, reactive tool output and corpus budgets are unchanged.
+    """
+    defaults = DelegationContextBudget(cfg.specialist_context_chars)
+    raw = os.environ.get("ORCHESTRATOR_DELEGATION_CONTEXT_BUDGETS", "").strip()
+    if not raw:
+        return defaults
+    try:
+        policies = json.loads(raw)
+    except (ValueError, TypeError) as exc:
+        raise ValueError("invalid delegation context budgets JSON") from exc
+    if not isinstance(policies, dict):
+        raise ValueError("delegation context budgets must be an object")
+    resolved = {}
+    limits = {"context_chars": defaults.context_chars, "discovery_budget": 2000}
+    for role, modes in policies.items():
+        if role not in _valid_delegate_roles() or not isinstance(modes, dict):
+            raise ValueError("invalid delegation context budget role or modes")
+        for mode, values in modes.items():
+            if mode not in {"react", "repl"} or not isinstance(values, dict):
+                raise ValueError("invalid delegation context budget mode or values")
+            if set(values) - limits.keys():
+                raise ValueError("unknown delegation context budget field")
+            caps = dict(limits)
+            for key, value in values.items():
+                if type(value) is not int or not 0 <= value <= limits[key]:
+                    raise ValueError(f"invalid delegation context budget {key}")
+                caps[key] = value
+            resolved[(role, mode)] = DelegationContextBudget(**caps)
+    return resolved.get((delegate_to, delegate_mode), defaults)
