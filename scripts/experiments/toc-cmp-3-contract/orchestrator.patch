diff --git a/tests/unit/test_toc_cmp3_contract.py b/tests/unit/test_toc_cmp3_contract.py
new file mode 100644
index 00000000..b638a9f7
--- /dev/null
+++ b/tests/unit/test_toc_cmp3_contract.py
@@ -0,0 +1,98 @@
+"""Offline contract and history-arm integration checks."""
+import asyncio
+import hashlib
+import re
+
+import pytest
+
+from src.features import Features, set_features
+from src.graph import context_arm_ab as ab
+from src.graph.compaction_artifacts import (
+    ExecutionBrief, PinnedGovernance, render_contract, set_contract, validate_contract,
+)
+from tests.unit.test_toc_mp2i_context_arms import add, case  # noqa: F401, F811
+
+
+def artifacts():
+    return ExecutionBrief('task', 'intent', 'plan', 'finish', 'artifact', 'pointer'), PinnedGovernance('PIN\nexact')
+
+
+def enable(state):
+    set_features(Features(session_log=True, session_log_verbatim=True, context_arm_ab=True,
+                          context_compaction_contract=True, output_spill_to_file=True,
+                          trajectory_artifact=True))
+    brief, pin = artifacts()
+    set_contract(state, brief, pin)
+    return brief, pin
+
+
+def test_contract_exact_and_fail_closed():
+    brief, pin = artifacts()
+    text = render_contract(brief, pin)
+    validate_contract(text + 'history', brief, pin)
+    for damaged in (text.replace('PIN\nexact', 'PIN exact'), text.replace('finish', ''), 'history' + text):
+        with pytest.raises(ValueError):
+            validate_contract(damaged, brief, pin)
+    with pytest.raises(ValueError):
+        render_contract(ExecutionBrief('task', '', 'p', 'c', 'a', 'r'), pin)
+
+
+def test_missing_contract_fails_before_boundary(case):  # noqa: F811
+    state, repl, ctx, _ = case
+    set_features(Features(session_log=True, session_log_verbatim=True, context_arm_ab=True,
+                          context_compaction_contract=True, output_spill_to_file=True, trajectory_artifact=True))
+    add(state, 'history')
+    with pytest.raises(ValueError):
+        asyncio.run(ab.boundary(ctx, force=True))
+    assert not state.history_boundaries
+
+
+def test_manifest_exact_spans_and_pinned_after_fold(case, monkeypatch):  # noqa: F811
+    state, repl, ctx, _ = case
+    monkeypatch.setenv('ORCHESTRATOR_CONTEXT_ARM', 'verbatim_manifest')
+    brief, pin = enable(state)
+    for n in range(5):
+        add(state, f'output-{n}-é' + 'z' * 500)
+    asyncio.run(ab.boundary(ctx, force=True))
+    rendered = ab.render(state, repl)
+    validate_contract(rendered, brief, pin)
+    assert state.history_tail_start > 0
+    entries = re.findall(r'Turn (\d+) (code|output|error) chars=(\d+) sha256=([0-9a-f]+) peek\((\d+), file_path="([^"]+)", offset=(\d+)\)', rendered)
+    assert len(entries) == state.history_tail_start * 3
+    for turn, field, length, digest, count, path, offset in entries:
+        value = state.history_turns[int(turn) - 1][field]
+        assert int(length) == int(count) == len(value)
+        assert hashlib.sha256(value.encode()).hexdigest() == digest
+        assert repl._peek(int(count), file_path=path, offset=int(offset)) == value
+    assert f'Turn {state.history_turns[-1]["turn"]} output chars=' not in rendered
+
+
+@pytest.mark.parametrize('arm', sorted(ab.ARMS))
+def test_contract_preserved_for_each_arm(case, monkeypatch, arm):  # noqa: F811
+    state, repl, ctx, _ = case
+    monkeypatch.setenv('ORCHESTRATOR_CONTEXT_ARM', arm)
+    brief, pin = enable(state)
+    for _ in range(5):
+        add(state, 'history ' * 100)
+    asyncio.run(ab.boundary(ctx, force=True))
+    validate_contract(ab.render(state, repl), brief, pin)
+
+
+def test_contract_rejects_unsafe_control_tokens():
+    from src.security.control_tokens import neutralise_control_tokens
+    sample = '<|im_start|>'
+    if neutralise_control_tokens(sample) == sample:
+        pytest.skip('control token vocabulary differs')
+    brief, _ = artifacts()
+    with pytest.raises(ValueError, match='unsafe'):
+        render_contract(brief, PinnedGovernance(sample))
+
+
+def test_default_off_render_legacy_equality(case):  # noqa: F811
+    state, repl, ctx, _ = case
+    for _ in range(5):
+        add(state, 'legacy ' * 100)
+    before = ab._render_history(state, repl)
+    assert ab.render(state, repl) == before
+    asyncio.run(ab.boundary(ctx, force=True))
+    assert ab.render(state, repl) == ab._render_history(state, repl)
