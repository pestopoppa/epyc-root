+"""Explicit, lossless execution context supplied by the experiment's caller.
+
+This verifies exact preservation, not model understanding or semantic entailment.
+"""
+from dataclasses import asdict, dataclass
+
+
+@dataclass(frozen=True)
+class ExecutionBrief:
+    verbatim_task: str
+    current_intent: str
+    plan: str
+    completion_requirements: str
+    artifacts: str
+    pointers: str
+
+
+@dataclass(frozen=True)
+class PinnedGovernance:
+    text: str
+
+
+def render_contract(brief: ExecutionBrief, governance: PinnedGovernance) -> str:
+    from src.security.control_tokens import neutralise_control_tokens
+
+    values = asdict(brief)
+    if any(not isinstance(v, str) or not v.strip() for v in values.values()):
+        raise ValueError('execution brief requires six nonempty strings')
+    if not isinstance(governance.text, str) or not governance.text.strip():
+        raise ValueError('pinned governance requires nonempty text')
+    if any(neutralise_control_tokens(v) != v for v in (*values.values(), governance.text)):
+        raise ValueError('unsafe control tokens in compaction contract')
+    # Length framing permits arbitrary delimiters and preserves whitespace verbatim.
+    fields = ''.join(f'{name} {len(value)}\n{value}\n' for name, value in values.items())
+    return '[Execution brief v1]\n' + fields + f'[Pinned governance {len(governance.text)}]\n{governance.text}\n[End contract]\n'
+
+
+def validate_contract(rendered: str, brief: ExecutionBrief, governance: PinnedGovernance) -> None:
+    """Fail closed unless the exact contract is at the start of the presented view."""
+    expected = render_contract(brief, governance)
+    if not rendered.startswith(expected):
+        raise ValueError('compaction contract missing or altered')
+
+
+def set_contract(state, brief: ExecutionBrief, governance: PinnedGovernance) -> None:
+    """Validate then install serializable, caller-supplied contract state."""
+    render_contract(brief, governance)
+    state.compaction_execution_brief = asdict(brief)
+    state.compaction_pinned_governance = asdict(governance)
