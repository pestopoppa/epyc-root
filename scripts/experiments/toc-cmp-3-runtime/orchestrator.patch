diff --git a/tests/unit/test_toc_cmp3_semantic_runtime.py b/tests/unit/test_toc_cmp3_semantic_runtime.py
new file mode 100644
index 00000000..81656d74
--- /dev/null
+++ b/tests/unit/test_toc_cmp3_semantic_runtime.py
@@ -0,0 +1,143 @@
+import asyncio
+import json
+
+import pytest
+
+from src.features import Features, set_features
+from src.graph import context_arm_ab as ab
+from src.graph.compaction_semantic import FIELDS, configure_semantic_check
+from tests.unit.test_toc_cmp3_contract import enable
+from tests.unit.test_toc_mp2i_context_arms import add, case  # noqa: F401
+
+
+def configure(state, callback, timeout=.1):
+    configure_semantic_check(state, callback, 'offline-test', timeout)
+
+
+def flags():
+    set_features(Features(session_log=True, session_log_verbatim=True, context_arm_ab=True,
+                          context_compaction_contract=True, context_compaction_semantic=True,
+                          output_spill_to_file=True, trajectory_artifact=True))
+
+
+def answer(case, verdict='entailed', quote=None):
+    text = case['observed_messages'][0]['content']
+    return json.dumps({'request_id': case['request_id'], 'judgments': {
+        f: {'verdict': verdict, 'rationale': 'checked', 'evidence': [{'message': 0, 'quote': quote or text[:10]}]}
+        for f in FIELDS}}).encode()
+
+
+def test_disabled_and_no_boundary(case):
+    state, repl, ctx, _ = case
+    enable(state)
+    calls = []
+    async def evaluator(case):
+        calls.append(case)
+        return answer(case)
+    configure(state, evaluator)
+    add(state, 'history')
+    asyncio.run(ab.boundary(ctx, force=True))
+    assert not calls and not state.compaction_semantic_outcomes
+    flags()
+    asyncio.run(ab.boundary(ctx, force=True))  # already folded at this turn
+    assert not calls
+
+
+def test_success_checked_after_fold(case):
+    state, repl, ctx, _ = case
+    enable(state); flags()
+    add(state, 'history')
+    seen = []
+    async def evaluator(payload):
+        seen.append((list(state.history_boundaries), payload))
+        return answer(payload)
+    configure(state, evaluator)
+    asyncio.run(ab.boundary(ctx, force=True))
+    assert seen[0][0] == [state.turns]
+    assert seen[0][1]['observed_messages'][1]['content'] in ab.render(state, repl)
+    assert state.compaction_semantic_outcomes[-1]['semantic_verdict'] == 'entailed'
+
+
+@pytest.mark.parametrize('mode', ['contradicted', 'missing', 'fabricated', 'error', 'timeout', 'absent'])
+def test_fail_closed_and_retry_cannot_bypass(case, mode):
+    state, repl, ctx, _ = case
+    enable(state); flags()
+    add(state, 'history')
+    async def evaluator(payload):
+        if mode == 'error':
+            raise ValueError('failure')
+        if mode == 'timeout':
+            await asyncio.sleep(1)
+        if mode == 'missing':
+            raw = json.loads(answer(payload)); raw['judgments']['plan']['evidence'] = []
+            return json.dumps(raw).encode()
+        return answer(payload, 'contradicted' if mode == 'contradicted' else 'entailed',
+                      'fabricated evidence' if mode == 'fabricated' else None)
+    if mode != 'absent':
+        configure(state, evaluator, .001)
+    for _ in range(2):
+        with pytest.raises(RuntimeError, match='blocked'):
+            asyncio.run(ab.boundary(ctx, force=True))
+    assert state.compaction_semantic_outcomes[-1]['semantic_verdict'] == ('contradicted' if mode == 'contradicted' else 'unknown')
+    with pytest.raises(RuntimeError, match='blocked'):
+        ab.render(state, repl)
+    assert ab.render(state, repl, _allow_blocked=True).startswith('[Execution brief v1]')
+
+
+def test_cancelled_check_records_custody_and_blocks_retry(case):
+    state, repl, ctx, _ = case
+    enable(state); flags()
+    add(state, 'history')
+    async def run():
+        started = asyncio.Event()
+        async def evaluator(payload):
+            started.set()
+            await asyncio.Event().wait()
+        configure(state, evaluator)
+        checking = asyncio.create_task(ab.boundary(ctx, force=True))
+        await started.wait()
+        checking.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await checking
+        with pytest.raises(RuntimeError, match='blocked'):
+            ab.render(state, repl)
+        with pytest.raises(RuntimeError, match='blocked'):
+            await ab.boundary(ctx, force=True)
+    asyncio.run(run())
+    outcome = state.compaction_semantic_outcomes[0]
+    assert outcome['reason'] == 'cancelled'
+    assert outcome['semantic_verdict'] == 'unknown'
+    assert outcome['case']['observed_messages'][0]['content'].startswith('[Execution brief v1]')
+    assert outcome['case']['reference']['plan'] == 'plan'
+
+
+def test_audit_retains_raw_judgment_and_exact_case(case):
+    import base64
+    state, repl, ctx, _ = case
+    enable(state); flags()
+    add(state, 'history')
+    async def evaluator(payload):
+        return answer(payload)
+    configure(state, evaluator)
+    asyncio.run(ab.boundary(ctx, force=True))
+    outcome = state.compaction_semantic_outcomes[-1]
+    raw = base64.b64decode(outcome['evaluator_output_base64'])
+    assert json.loads(raw)['request_id'] == outcome['case']['request_id']
+    evidence = outcome['judgments']['plan']['evidence'][0]
+    content = outcome['case']['observed_messages'][evidence['message']]['content']
+    assert content[evidence['start_char']:evidence['end_char']] == evidence['quote']
+
+
+def test_invalid_contract_does_not_clear_block(case):
+    from src.graph.compaction_semantic import check_post_fold
+    state, repl, ctx, _ = case
+    enable(state); flags()
+    add(state, 'history')
+    with pytest.raises(RuntimeError, match='blocked'):
+        asyncio.run(ab.boundary(ctx, force=True))
+    previous = state.compaction_semantic_outcomes[-1]
+    with pytest.raises(ValueError):
+        asyncio.run(check_post_fold(state, 'damaged frame'))
+    assert state.compaction_semantic_outcomes[-1] is previous
+    with pytest.raises(RuntimeError, match='blocked'):
+        ab.render(state, repl)
