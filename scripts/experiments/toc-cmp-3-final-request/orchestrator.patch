diff --git a/src/graph/final_request_semantic.py b/src/graph/final_request_semantic.py
new file mode 100644
index 00000000..bdc2d5b5
--- /dev/null
+++ b/src/graph/final_request_semantic.py
@@ -0,0 +1,155 @@
+"""Request-bound opt-in semantic enforcement at the REPL's HTTP dispatch."""
+import asyncio
+import base64
+import copy
+import inspect
+import json
+import math
+import weakref
+from contextvars import ContextVar
+from threading import Event
+
+from src.graph.compaction_artifacts import ExecutionBrief, PinnedGovernance, render_contract
+from src.graph.compaction_semantic import canonical, digest, import_judgment, make_case
+
+
+class FinalRequestBlocked(Exception):
+    """A semantic failure is terminal for this guarded trajectory."""
+
+
+active_guard = ContextVar("compaction_final_request_guard", default=None)
+_evaluators = {}
+
+
+def configure_final_request_check(state, evaluator, evaluator_id, timeout_s):
+    """Install an explicit process-local evaluator for exactly this task state."""
+    if (not inspect.iscoroutinefunction(evaluator) or not isinstance(evaluator_id, str)
+            or not evaluator_id.strip() or isinstance(timeout_s, bool)
+            or not isinstance(timeout_s, (int, float)) or not math.isfinite(timeout_s)
+            or timeout_s <= 0):
+        raise ValueError("an async evaluator, identifier and finite positive timeout are required")
+    key = id(state)
+
+    def discard(ref):
+        if _evaluators.get(key, (None,))[0] is ref:
+            _evaluators.pop(key, None)
+
+    _evaluators[key] = (weakref.ref(state, discard), evaluator, evaluator_id, timeout_s)
+
+
+class FinalRequestGuard:
+    def __init__(self, state):
+        self.state = state
+        self.loop = asyncio.get_running_loop()
+        self.cancelled = Event()
+
+    @property
+    def outcomes(self):
+        return self.state.compaction_final_request_outcomes
+
+    def require_unblocked(self):
+        if self.outcomes and self.outcomes[-1]["blocked"]:
+            raise FinalRequestBlocked(self.outcomes[-1]["block_reason"])
+        if self.cancelled.is_set():
+            self.block("cancelled")
+
+    def block(self, reason):
+        self.outcomes.append({
+            "unit": self.unit(), "semantic_verdict": "unknown", "blocked": True,
+            "block_reason": reason,
+        })
+        raise FinalRequestBlocked(reason)
+
+    def unit(self):
+        return {
+            "task_id": self.state.task_id,
+            "boundary_turn": self.state.history_boundaries[-1],
+            "graph_turn": self.state.turns,
+            "attempt": len(self.outcomes) + 1,
+        }
+
+    def verify(self, endpoint, payload):
+        self.require_unblocked()
+        # The HTTP client receives only this private JSON copy. Neither a mutable
+        # caller-owned payload nor the evaluator's copy is reused for dispatch.
+        try:
+            if endpoint not in ("/completion", "/v1/chat/completions"):
+                raise ValueError("unsupported endpoint")
+            snapshot = json.loads(canonical(payload))
+            request = {"endpoint": endpoint, "payload": snapshot}
+            observed = (snapshot["messages"] if endpoint == "/v1/chat/completions"
+                        else [{"role": "prompt", "content": snapshot["prompt"]}])
+            if endpoint == "/v1/chat/completions" and (
+                len(observed) != 1 or observed[0]["role"] != "user" or "tools" in snapshot
+            ):
+                raise ValueError("unsupported REPL chat payload")
+            governance = PinnedGovernance(**self.state.compaction_pinned_governance)
+            reference = {**self.state.compaction_execution_brief, "pinned_governance": governance.text}
+            contract = render_contract(ExecutionBrief(**self.state.compaction_execution_brief), governance)
+            literal = sum(msg["content"].count(contract) for msg in observed) == 1
+            case = make_case(self.unit(), reference, observed, literal,
+                             {"final_request_sha256": digest(canonical(request))})
+        except (AttributeError, KeyError, TypeError, ValueError):
+            self.block("invalid_request_or_contract")
+
+        raw = None
+        reason = None
+        evaluator_id = None
+        config = _evaluators.get(id(self.state))
+        if config is None or config[0]() is not self.state:
+            reason = "missing_evaluator"
+        else:
+            _, evaluator, evaluator_id, timeout_s = config
+            try:
+                raw = self.evaluate(evaluator, case, timeout_s)
+                if not isinstance(raw, bytes):
+                    raw = None
+                    reason = "invalid_evaluator_response"
+            except TimeoutError:
+                reason = "timeout"
+            except FinalRequestBlocked as exc:
+                reason = str(exc)
+            except Exception:
+                reason = "evaluator_error"
+
+        result = import_judgment(case, raw, evaluator_id)
+        if self.cancelled.is_set():
+            reason = "cancelled"
+            result = import_judgment(case, None, evaluator_id)
+        block_reason = (reason or result.get("reason")
+                        or ("literal_contract" if not literal else None)
+                        or (result["semantic_verdict"] if result["semantic_verdict"] != "entailed" else None))
+        result.update(case=case, final_request=copy.deepcopy(request), blocked=block_reason is not None,
+                      block_reason=block_reason)
+        if raw is not None:
+            result["evaluator_output_base64"] = base64.b64encode(raw).decode("ascii")
+        self.outcomes.append(result)
+        if block_reason is not None:
+            raise FinalRequestBlocked(block_reason)
+        return snapshot
+
+    def evaluate(self, evaluator, case, timeout_s):
+        # The REPL event loop awaits the worker thread while the worker submits
+        # the judge coroutine back to that loop. Never block any event loop.
+        try:
+            asyncio.get_running_loop()
+        except RuntimeError:
+            pass
+        else:
+            raise FinalRequestBlocked("unsupported_inline_dispatch")
+        coroutine = evaluator(copy.deepcopy(case))
+        try:
+            pending = asyncio.run_coroutine_threadsafe(coroutine, self.loop)
+        except RuntimeError:
+            coroutine.close()
+            raise FinalRequestBlocked("evaluator_loop_unavailable") from None
+        try:
+            return pending.result(timeout=timeout_s)
+        except TimeoutError:
+            pending.cancel()
+            raise
+
+
+def verify_final_payload(endpoint, payload):
+    guard = active_guard.get()
+    return guard.verify(endpoint, payload) if guard is not None else payload
