+spec=importlib.util.spec_from_file_location('g3_gate_outcome_integration',PATH)
+gate=importlib.util.module_from_spec(spec);spec.loader.exec_module(gate)
+
+class Integration(unittest.TestCase):
+    def setUp(self):
+        self.tmp=tempfile.TemporaryDirectory();self.addCleanup(self.tmp.cleanup)
+        p=Path(self.tmp.name);self.task=p/'tasks';self.out=p/'outcomes';self.seg=p/'segments'
+        self.expected={'q':{}}
+        self.tasks=[{'id':'q','metric':'exact_token_match','target_tokens':[1,2,3]}]
+        self.outcomes=[{'id':'q','arm':a,'output_tokens':[1,2,3],'output_text':'ok','complete':True,'finish_reason':'eog'} for a in ('full','reuse')]
+        self.segments=[{'id':'q','arm':a,'segment':i,'start':start,'tokens':tokens,'finish_reason':reason}
+                       for a in ('full','reuse') for i,start,tokens,reason in ((0,0,[1,2],'continue'),(1,2,[3],'eog'))]
+        self.write()
+    def write(self):
+        for path,rows in ((self.task,self.tasks),(self.out,self.outcomes),(self.seg,self.segments)):
+            path.write_text(''.join(json.dumps(row)+'\n' for row in rows))
+    def test_legacy_unchanged_and_segmented_valid(self):
+        for o in self.outcomes:o.pop('finish_reason')
+        self.write();legacy=gate.paired_retention(self.out,self.task,self.expected)
+        self.assertEqual(legacy['retention'],1);self.assertNotIn('outcome_segments_sha256',legacy)
+        for o in self.outcomes:o['finish_reason']='eog'
+        self.write();result=gate.paired_retention(self.out,self.task,self.expected,segments_path=self.seg)
+        self.assertEqual(result['retention'],1)
+        self.assertEqual(result['outcome_segments_sha256'],hashlib.sha256(self.seg.read_bytes()).hexdigest())
+    def test_refuses_interruption_exhaustion_mismatch_duplicates(self):
+        variants=[self.segments[:-1],self.segments+self.segments[:1],
+                  [dict(x,finish_reason='length') if x['arm']=='reuse' and x['segment']==1 else x for x in self.segments],
+                  [dict(x,tokens=[9]) if x['arm']=='reuse' and x['segment']==1 else x for x in self.segments]]
+        for rows in variants:
+            self.segments=rows;self.write()
+            with self.subTest(rows=rows),self.assertRaises(ValueError):
+                gate.paired_retention(self.out,self.task,self.expected,segments_path=self.seg)
