+++ b/tests/kpf62-outcome-budget.h
@@ -0,0 +1,45 @@
+#pragma once
+// Pure bounded continuation engine. Segments are persisted by emit before the
+// next segment starts. A missing final row therefore remains incomplete.
+#include <algorithm>
+#include <cstddef>
+#include <string>
+#include <vector>
+
+namespace kpf62_outcome {
+template<class Token> struct result {
+    std::vector<Token> tokens;
+    std::string finish_reason;
+    bool complete = false;
+};
+template<class Token, class IsEog, class Advance, class Emit>
+result<Token> generate(Token next, int max_tokens, int segment_tokens,
+                       IsEog is_eog, Advance advance, Emit emit) {
+    result<Token> result;
+    if (max_tokens <= 0 || segment_tokens <= 0 || segment_tokens > max_tokens) {
+        result.finish_reason = "invalid_budget";
+        return result;
+    }
+    int segment = 0;
+    for (;;) {
+        const auto start = result.tokens.size();
+        const auto bound = std::min<std::size_t>(start + segment_tokens, max_tokens);
+        bool decode_error = false;
+        while (result.tokens.size() < bound && !is_eog(next)) {
+            result.tokens.push_back(next);
+            if (!advance(next, result.tokens.size() - 1)) { decode_error = true; break; }
+        }
+        result.complete = !decode_error && is_eog(next);
+        const char * reason = decode_error ? "decode_error" : result.complete ? "eog" :
+                              result.tokens.size() == std::size_t(max_tokens) ? "length" : "continue";
+        result.finish_reason = reason;
+        std::vector<Token> chunk(result.tokens.begin() + start, result.tokens.end());
+        if (!emit(segment++, start, chunk, reason)) {
+            result.complete = false;
+            result.finish_reason = "write_error";
+            return result;
+        }
+        if (decode_error || result.complete || result.tokens.size() == std::size_t(max_tokens)) return result;
+    }
+}
+}
