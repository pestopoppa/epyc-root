diff --git a/scripts/chunk-kv/g3_outcome_guard.py b/scripts/chunk-kv/g3_outcome_guard.py
new file mode 100644
index 000000000..f7f8e556f
--- /dev/null
+++ b/scripts/chunk-kv/g3_outcome_guard.py
@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+"""Refuse incomplete or unpaired G3 outcome inputs; does not score quality."""
+import argparse
+import json
+from pathlib import Path
+
+
+def validate(ids, outcomes, segments):
+    ids = list(ids)
+    if not ids or len(ids) != len(set(ids)) or any(not isinstance(x, str) or not x for x in ids):
+        raise ValueError('invalid expected ids')
+    expected = {(x, arm) for x in ids for arm in ('full', 'reuse')}
+    indexed = {}
+    for row in outcomes:
+        key = (row.get('id'), row.get('arm'))
+        if key not in expected or key in indexed:
+            raise ValueError('unexpected or duplicate outcome')
+        if row.get('complete') is not True or row.get('finish_reason') != 'eog':
+            raise ValueError('incomplete outcome')
+        if not isinstance(row.get('output_tokens'), list):
+            raise ValueError('missing outcome tokens')
+        indexed[key] = row
+    if set(indexed) != expected:
+        raise ValueError('missing paired outcome')
+    ledger = {key: [] for key in expected}
+    for row in segments:
+        key = (row.get('id'), row.get('arm'))
+        if key not in ledger:
+            raise ValueError('unexpected segment')
+        ledger[key].append(row)
+    for key, rows in ledger.items():
+        if not rows:
+            raise ValueError('missing segment ledger')
+        tokens = []
+        for i, row in enumerate(rows):
+            if row.get('segment') != i or row.get('start') != len(tokens) or not isinstance(row.get('tokens'), list):
+                raise ValueError('out-of-order or malformed segment')
+            expected_reason = 'eog' if i == len(rows) - 1 else 'continue'
+            if row.get('finish_reason') != expected_reason:
+                raise ValueError('incomplete segment ledger')
+            tokens.extend(row['tokens'])
+        if tokens != indexed[key]['output_tokens']:
+            raise ValueError('segment/output token mismatch')
+    return {'pairs': len(ids), 'outcomes': len(indexed), 'segments': sum(map(len, ledger.values()))}
+
+
+def rows(path):
+    return [json.loads(line) for line in Path(path).read_text().splitlines() if line.strip()]
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--ids', required=True, help='JSON array of predeclared request IDs')
+    p.add_argument('--outcomes', required=True)
+    p.add_argument('--segments', required=True)
+    a = p.parse_args()
+    try:
+        print(json.dumps(validate(json.loads(Path(a.ids).read_text()), rows(a.outcomes), rows(a.segments)), sort_keys=True))
+    except (OSError, ValueError, TypeError, json.JSONDecodeError) as e:
+        p.exit(2, f'INVALID: {e}\n')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/scripts/chunk-kv/tests/test_g3_outcome_guard_integration.py b/scripts/chunk-kv/tests/test_g3_outcome_guard_integration.py
new file mode 100644
index 000000000..01519f59c
--- /dev/null
+++ b/scripts/chunk-kv/tests/test_g3_outcome_guard_integration.py
@@ -0,0 +1,53 @@
+"""Opt-in ledger validation occurs before exact or canonical text scoring."""
+import hashlib
+import importlib.util
+import json
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+PATH=Path(__file__).resolve().parents[1]/'g3_gate.py'
+spec=importlib.util.spec_from_file_location('g3_gate_outcome_integration',PATH)
+gate=importlib.util.module_from_spec(spec);spec.loader.exec_module(gate)
+
+class Integration(unittest.TestCase):
+    def setUp(self):
+        self.tmp=tempfile.TemporaryDirectory();self.addCleanup(self.tmp.cleanup)
+        p=Path(self.tmp.name);self.task=p/'tasks';self.out=p/'outcomes';self.seg=p/'segments'
+        self.expected={'q':{}}
+        self.tasks=[{'id':'q','metric':'exact_token_match','target_tokens':[1,2,3]}]
+        self.outcomes=[{'id':'q','arm':a,'output_tokens':[1,2,3],'output_text':'ok','complete':True,'finish_reason':'eog'} for a in ('full','reuse')]
+        self.segments=[{'id':'q','arm':a,'segment':i,'start':start,'tokens':tokens,'finish_reason':reason}
+                       for a in ('full','reuse') for i,start,tokens,reason in ((0,0,[1,2],'continue'),(1,2,[3],'eog'))]
+        self.write()
+    def write(self):
+        for path,rows in ((self.task,self.tasks),(self.out,self.outcomes),(self.seg,self.segments)):
+            path.write_text(''.join(json.dumps(row)+'\n' for row in rows))
+    def test_legacy_unchanged_and_segmented_valid(self):
+        for o in self.outcomes:o.pop('finish_reason')
+        self.write();legacy=gate.paired_retention(self.out,self.task,self.expected)
+        self.assertEqual(legacy['retention'],1);self.assertNotIn('outcome_segments_sha256',legacy)
+        for o in self.outcomes:o['finish_reason']='eog'
+        self.write();result=gate.paired_retention(self.out,self.task,self.expected,segments_path=self.seg)
+        self.assertEqual(result['retention'],1)
+        self.assertEqual(result['outcome_segments_sha256'],hashlib.sha256(self.seg.read_bytes()).hexdigest())
+    def test_refuses_interruption_exhaustion_mismatch_duplicates(self):
+        variants=[self.segments[:-1],self.segments+self.segments[:1],
+                  [dict(x,finish_reason='length') if x['arm']=='reuse' and x['segment']==1 else x for x in self.segments],
+                  [dict(x,tokens=[9]) if x['arm']=='reuse' and x['segment']==1 else x for x in self.segments]]
+        for rows in variants:
+            self.segments=rows;self.write()
+            with self.subTest(rows=rows),self.assertRaises(ValueError):
+                gate.paired_retention(self.out,self.task,self.expected,segments_path=self.seg)
+    def test_text_scorer_interface_and_no_score_on_invalid(self):
+        self.tasks=[{'id':'q','metric':'orchestrator_text_v1','scorer_sha256':'a'*64,'scoring_method':'exact_match','expected':'ok','scoring_config':{}}]
+        self.write()
+        with patch.object(gate,'_load_pinned_scorer',return_value=lambda a,b,c,d: a==b) as load:
+            result=gate.paired_retention(self.out,self.task,self.expected,'scorer.py',self.seg)
+            self.assertEqual(result['retention'],1);load.assert_called_once_with('scorer.py','a'*64)
+        self.segments=self.segments[:-1];self.write()
+        with patch.object(gate,'_load_pinned_scorer') as load:
+            with self.assertRaises(ValueError):gate.paired_retention(self.out,self.task,self.expected,'scorer.py',self.seg)
+            load.assert_not_called()
+if __name__=='__main__':unittest.main()
