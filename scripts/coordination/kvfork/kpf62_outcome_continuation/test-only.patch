diff --git a/tests/test-kpf62-outcome-budget.cpp b/tests/test-kpf62-outcome-budget.cpp
new file mode 100644
index 000000000..0f8f17ee4
--- /dev/null
+++ b/tests/test-kpf62-outcome-budget.cpp
@@ -0,0 +1,27 @@
+#include "kpf62-outcome-budget.h"
+#include <cassert>
+#include <string>
+#include <vector>
+using namespace kpf62_outcome;
+struct record { int segment; size_t start; std::vector<int> tokens; std::string reason; };
+static result<int> run(int initial, int max, int seg, int eog, int fail_at, int emit_limit, std::vector<record> & records) {
+    int advances = 0;
+    return generate<int>(initial, max, seg, [=](int t) { return t == eog; },
+        [&](int & t, size_t) { if (advances++ == fail_at) return false; ++t; return true; },
+        [&](int i, size_t start, const std::vector<int> & tokens, const char * reason) {
+            if (i >= emit_limit) return false;
+            records.push_back({i,start,tokens,reason}); return true;
+        });
+}
+int main() {
+    std::vector<record> r;
+    auto e = run(9,8,3,9,-1,10,r); assert(e.complete && e.tokens.empty() && r.size()==1 && r[0].reason=="eog");
+    r.clear(); auto c = run(0,8,2,5,-1,10,r); assert(c.complete && c.tokens.size()==5 && r.size()==3 && r[0].reason=="continue" && r[1].start==2 && r[2].reason=="eog");
+    r.clear(); auto b = run(0,4,2,4,-1,10,r); assert(b.complete && b.tokens.size()==4 && r.back().reason=="eog");
+    r.clear(); auto x = run(0,4,2,20,-1,10,r); assert(!x.complete && x.tokens.size()==4 && x.finish_reason=="length" && r.size()==2);
+    r.clear(); auto d = run(0,8,2,20,2,10,r); assert(!d.complete && d.finish_reason=="decode_error" && r.size()==2 && r.back().start==2);
+    r.clear(); auto w = run(0,8,2,20,-1,1,r); assert(!w.complete && w.finish_reason=="write_error" && r.size()==1);
+    r.clear(); auto invalid = run(0,4,5,20,-1,10,r); assert(!invalid.complete && invalid.finish_reason=="invalid_budget" && r.empty());
+    std::vector<record> full, reuse; auto f=run(0,8,2,3,-1,10,full); auto z=run(4,8,3,8,-1,10,reuse);
+    assert(f.complete && z.complete && f.tokens != z.tokens && full.front().start==0 && reuse.front().start==0);
+}
