# epyc-root pre-commit extras — sourced by the generated .git/hooks/pre-commit.
#
# CONTRACT (from the wrapper): accumulate into $status, never `exit` directly, so
# every check runs and one failure cannot hide another.
#
# Installed to .git/hooks/pre-commit.extras by scripts/hooks/install_git_hooks.sh.
# Versioned here because .git/ reaches no clone.

# Observation contract: no new name-pattern watchdog without a registry row, and no
# silently-dropped deferral for an existing one. See the header of
# scripts/hooks/observer_census_precommit.sh for why this is a hook and not a rule.
"${HOOK_SRC_DIR}/observer_census_precommit.sh" "$@" || status=1

# Vacuous-pass guard: a test file that can report success while executing nothing.
# CHANGED FILES ONLY, deliberately -- the legacy count is large (2026-08-20: 18
# epyc-root / 127 research / 26 orchestrator blocking) and gating the whole tree
# would block every commit until a repo-wide cleanup lands. Grandfathering the
# backlog while refusing NEW instances is what makes this adoptable today; the
# backlog is tracked as its own handoff.
_vac_staged=$(git diff --cached --name-only --diff-filter=ACM -- '*test_*.py' 2>/dev/null || true)
if [ -n "$_vac_staged" ]; then
    # shellcheck disable=SC2086
    python3 "${HOOK_SRC_DIR}/check_test_collectability.py" \
        "$(git rev-parse --show-toplevel)" $_vac_staged || status=1
fi
unset _vac_staged
