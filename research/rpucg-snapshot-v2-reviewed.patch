+import copy
+import hashlib
+import json
+import unittest
+from rpucg_snapshot import validate_snapshot
+
+
+def snapshot():
+    return {'schema':'epyc.rpucg.snapshot.v2', 'promotable':False,
+            'task_id':'task', 'evaluator_id':'eval', 'recipe_id':'recipe',
+            'tie_rule':'id', 'inspiration_count':1,
+            'evaluator_sha256':hashlib.sha256(b'evaluator').hexdigest(),
+            'recipe_sha256':hashlib.sha256(b'recipe').hexdigest(),
+            'candidates':[{'id':'a', 'source_sha256':'a'*64, 'creation_order':0,
+                'chain_id':'c', 'parent_ids':[], 'correctness_passed':True, 'normalized_reward':1},
+                {'id':'b', 'source_sha256':'b'*64, 'creation_order':1,
+                 'chain_id':'c', 'parent_ids':['a'], 'correctness_passed':True, 'normalized_reward':2}],
+            'eligible_ids':['a','b'], 'incumbent_choice_ids':['b'],
+            'capture':{'producer_id':'producer', 'policy_source_revision':'revision',
+                       'semantics':'producer_asserted_atomic_pre_selection'},
+            'chain_visit_counts':{'c':{'a':1}}, 'chain_total_expansions':{'c':1}}
+
+
+def admit(obj):
+    raw=json.dumps(obj).encode()
+    return validate_snapshot(raw,hashlib.sha256(raw).hexdigest(), evaluator_bytes=b'evaluator', recipe_bytes=b'recipe')
+
+
+class TestAdmission(unittest.TestCase):
+    def test_round_trip_full_counter_state_without_history_assumptions(self):
+        obj = snapshot()
+        obj['chain_visit_counts'] = {'c': {'a': 7, 'b': 2, 'past-node': 3}, 'empty': {}}
+        obj['chain_total_expansions'] = {'c': 1, 'empty': 0}
+        result = admit(obj)
+        self.assertEqual(result['chain_visit_counts'], obj['chain_visit_counts'])
+        self.assertEqual(result['chain_total_expansions'], obj['chain_total_expansions'])
+        # A checkpoint can have independent counters; no fresh-history rule applies.
+        obj['chain_total_expansions']['c'] = 0
+        self.assertEqual(admit(obj)['chain_total_expansions']['c'], 0)
+        obj['chain_visit_counts'] = {'c': {}}
+        obj['chain_total_expansions'] = {'c': 0}
+        self.assertEqual(admit(obj)['chain_visit_counts'], {'c': {}})
+
+    def test_counter_shapes_and_capture_are_required(self):
+        changes = [
+            lambda x: x.update(schema='epyc.rpucg.snapshot.v1'),
+            lambda x: x.update(chain_visit_counts={'c': 1}),
+            lambda x: x.update(chain_total_expansions=1),
+            lambda x: x.update(chain_total_expansions={'other': 1}),
+            lambda x: x.update(chain_visit_counts={'other': {}}, chain_total_expansions={'other': 0}),
+            lambda x: x.update(chain_visit_counts={'c': {'a': True}}),
+            lambda x: x.update(chain_visit_counts={'c': {'': 1}}),
+            lambda x: x.update(chain_visit_counts={'c': {'a': -1}}),
+            lambda x: x.update(chain_total_expansions={'c': False}),
+            lambda x: x.update(chain_total_expansions={'c': -1}),
+            lambda x: x.pop('capture'),
+            lambda x: x['capture'].update(producer_id=' '),
+            lambda x: x['capture'].update(policy_source_revision=''),
+            lambda x: x['capture'].update(semantics='atomic'),
+        ]
+        for change in changes:
+            obj = copy.deepcopy(snapshot())
+            change(obj)
+            with self.subTest(obj=obj), self.assertRaises(ValueError):
+                admit(obj)
+
+    def test_identity_bytes_must_match(self):
+        obj = snapshot()
+        for key in ('evaluator_sha256', 'recipe_sha256'):
+            for bad in (None, '0' * 64, 'not-a-hash'):
+                copy_obj = copy.deepcopy(obj)
+                if bad is None:
+                    del copy_obj[key]
+                else:
+                    copy_obj[key] = bad
+                with self.subTest(key=key, value=bad), self.assertRaises(ValueError):
+                    admit(copy_obj)
+        raw = json.dumps(obj).encode()
+        for evaluator, recipe in ((b'changed', b'recipe'), (b'evaluator', b'changed')):
+            with self.subTest(evaluator=evaluator, recipe=recipe), self.assertRaises(ValueError):
+                validate_snapshot(raw, hashlib.sha256(raw).hexdigest(), evaluator_bytes=evaluator, recipe_bytes=recipe)
+
+    def test_valid(self):
+        self.assertEqual(admit(snapshot())['incumbent_choice_ids'], ['b'])
+    def test_failed_ineligible_ancestor_is_represented(self):
+        obj = snapshot()
+        obj['candidates'][0]['correctness_passed'] = False
+        del obj['candidates'][0]['normalized_reward']
+        obj['eligible_ids'] = ['b']
+        self.assertEqual(admit(obj)['candidates'][0]['correctness_passed'], False)
+
+    def test_failed_eligible_candidate_is_refused(self):
+        obj = snapshot()
+        obj['candidates'][0]['correctness_passed'] = False
+        with self.assertRaises(ValueError):
+            admit(obj)
+
+    def test_bad_digest_and_duplicate_keys(self):
+        with self.assertRaises(ValueError): validate_snapshot(b'{}', '0'*64, evaluator_bytes=b'evaluator', recipe_bytes=b'recipe')
+        raw=b'{"schema":1,"schema":2}'
+        with self.assertRaises(ValueError): validate_snapshot(raw,hashlib.sha256(raw).hexdigest(), evaluator_bytes=b'evaluator', recipe_bytes=b'recipe')
+    def test_incomplete_and_invented_inputs_refused(self):
+        changes=[lambda x:x['candidates'][1].update(parent_ids=['absent']),
+                 lambda x:x['candidates'][0].update(parent_ids=['b']),
+                 lambda x:x.update(eligible_ids=['unknown']),
+                 lambda x:x.update(incumbent_choice_ids=['absent']),
+                 lambda x:x.update(chain_visit_counts={}),
+                 lambda x:x['candidates'][0].update(correctness_passed=False),
+                 lambda x:x['candidates'][0].update(normalized_reward=float('nan')),
+                 lambda x:x.update(promotable=True)]
+        for change in changes:
+            obj=copy.deepcopy(snapshot()); change(obj)
+            with self.subTest(obj=obj), self.assertRaises(ValueError): admit(obj)
+
+if __name__ == '__main__': unittest.main()
