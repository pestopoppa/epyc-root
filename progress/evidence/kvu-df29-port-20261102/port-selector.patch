+++ b/scripts/benchmark/df29/df29_client.py
@@ -0,0 +1,206 @@
+#!/usr/bin/env python3
+"""DF2-9 request driver for df29_server.sh / df2_e2e.sh (stdlib only).
+
+Modes
+  seq   send prompts one at a time; per prompt attribute the server-log lines written during
+        that request (byte window) and classify: non-finite log hits, garbage/empty text, HTTP error.
+        Exit 0 = all requested prompts done, 10 = server died (resume index in <out>/resume_at),
+        11 = deadline reached (untested prompts remain).
+  conc  fire C identical-shape requests concurrently (one per prompt in the list, C at a time),
+        report aggregate generated tok/s and acceptance (df2_e2e.sh).
+"""
+import argparse
+import concurrent.futures as cf
+import json
+import os
+import re
+import time
+import urllib.error
+import urllib.request
+
+PAT_NONFINITE = re.compile(r"non-finite target features")
+PAT_SANITIZED = re.compile(r"sanitized \d+ isolated non-finite")
+PAT_SPECFAIL = re.compile(r"failed to process speculative batch")
+PAT_NAN = re.compile(r"\b(nan|inf)\b", re.IGNORECASE)
+PAT_ERR = re.compile(r"(^| )E (?!.*this warning is normal)|GGML_ASSERT|terminate called|Aborted|error:", re.MULTILINE)
+PAT_ACC = re.compile(r"draft acceptance\s*=\s*([0-9.]+)\s*\(\s*(\d+) accepted /\s*(\d+) generated\)")
+
+
+def alive(pid: int) -> bool:
+    try:
+        os.kill(pid, 0)
+    except OSError:
+        return False
+    try:
+        with open(f"/proc/{pid}/stat") as fh:
+            return fh.read().split()[2] != "Z"
+    except OSError:
+        return False
+
+
+def log_size(path: str) -> int:
+    try:
+        return os.path.getsize(path)
+    except OSError:
+        return 0
+
+
+def log_window(path: str, a: int, b: int) -> str:
+    try:
+        with open(path, "rb") as fh:
+            fh.seek(a)
+            return fh.read(max(0, b - a)).decode("utf-8", "replace")
+    except OSError:
+        return ""
+
+
+def garbage(text: str) -> str:
+    """'' if plausible text, else a reason. NaN logits on Qwen decode to token 0 = '!'."""
+    if text is None or not text.strip():
+        return "empty"
+    t = text.strip()
+    if t.count("!") >= max(4, 0.5 * len(t)):
+        return "bang-run(NaN-logits-signature)"
+    if len(set(t)) <= 2 and len(t) >= 8:
+        return "single-char-run"
+    return ""
+
+
+def post(port: int, body: dict, timeout: float):
+    req = urllib.request.Request(f"http://127.0.0.1:{port}/v1/chat/completions",
+                                 data=json.dumps(body).encode(),
+                                 headers={"Content-Type": "application/json"})
+    t0 = time.time()
+    try:
+        with urllib.request.urlopen(req, timeout=timeout) as r:
+            return r.status, json.loads(r.read()), time.time() - t0, ""
+    except urllib.error.HTTPError as e:
+        try:
+            msg = e.read().decode("utf-8", "replace")[:400]
+        except Exception:
+            msg = ""
+        return e.code, None, time.time() - t0, msg
+    except Exception as e:  # timeout, connection reset (server died), ...
+        return 0, None, time.time() - t0, f"{type(e).__name__}: {e}"[:400]
+
+
+def make_body(item: dict, sampling: str, max_tokens: int) -> dict:
+    body = {"messages": [{"role": "user", "content": item["content"]}],
+            "max_tokens": max_tokens, "stream": False, "seed": 42,
+            "chat_template_kwargs": {"enable_thinking": False}}
+    if sampling == "orig":   # DF2-5 runner / df2_req_bisect.sh
+        body.update({"temperature": 0.6, "top_p": 0.95, "top_k": 20})
+    else:                    # greedy
+        body.update({"temperature": 0.0, "top_k": 1})
+    return body
+
+
+def run_seq(a) -> int:
+    items = json.load(open(a.prompts))
+    if a.kinds:
+        kinds = set(a.kinds.split(","))
+        items = [it for it in items if it["kind"] in kinds]
+    rows_path = os.path.join(a.out, "requests.jsonl")
+    start = a.start
+    rc = 0
+    with open(rows_path, "a") as rows:
+        for idx in range(start, len(items)):
+            it = items[idx]
+            remaining = a.deadline - time.time()
+            if remaining < 5:
+                open(os.path.join(a.out, "resume_at"), "w").write(str(idx))
+                return 11
+            if not alive(a.pid):
+                open(os.path.join(a.out, "resume_at"), "w").write(str(idx))
+                return 10
+            off0 = log_size(a.log)
+            status, d, dt, err = post(a.port, make_body(it, a.sampling, a.max_tokens), min(a.req_timeout, remaining - 2))
+            time.sleep(0.3)  # let the server flush its log lines for this task
+            off1 = log_size(a.log)
+            win = log_window(a.log, off0, off1)
+            text, t = "", {}
+            if d:
+                try:
+                    text = d["choices"][0]["message"].get("content") or ""
+                except Exception:
+                    text = ""
+                t = d.get("timings") or {}
+            acc = PAT_ACC.findall(win)
+            row = {
+                "idx": idx, "id": it["id"], "kind": it["kind"], "chars": len(it["content"]),
+                "http": status, "err": err, "wall_s": round(dt, 2),
+                "log_nonfinite": len(PAT_NONFINITE.findall(win)),
+                "log_sanitized": len(PAT_SANITIZED.findall(win)),
+                "log_specfail": len(PAT_SPECFAIL.findall(win)),
+                "log_nan_words": len(PAT_NAN.findall(win)),
+                "garbage": garbage(text) if status == 200 else "",
+                "text_head": text[:160],
+                "prompt_n": t.get("prompt_n"), "predicted_n": t.get("predicted_n"),
+                "prompt_per_second": t.get("prompt_per_second"),
+                "predicted_per_second": t.get("predicted_per_second"),
+                "draft_n": t.get("draft_n"), "draft_n_accepted": t.get("draft_n_accepted"),
+                "log_acceptance": acc[-1] if acc else None,
+                "server_alive_after": alive(a.pid),
+            }
+            bad = (row["log_nonfinite"] > 0 or row["log_specfail"] > 0 or status != 200 or row["garbage"] != "")
+            row["finite_ok"] = not bad
+            rows.write(json.dumps(row) + "\n")
+            rows.flush()
+            print(f"  [{idx:2d}] {it['kind']:7s} {it['id'][:38]:38s} http={status} nonfinite_log={row['log_nonfinite']} "
+                  f"sanitized={row['log_sanitized']} garbage={row['garbage'] or '-'} pn={row['prompt_n']} "
+                  f"tg={row['predicted_n']} tps={row['predicted_per_second']} draft={row['draft_n_accepted']}/{row['draft_n']} "
+                  f"{'OK' if not bad else 'BAD'}", flush=True)
+            if not row["server_alive_after"]:
+                open(os.path.join(a.out, "resume_at"), "w").write(str(idx + 1))
+                return 10
+    return rc
+
+
+def run_conc(a) -> int:
+    items = json.load(open(a.prompts))
+    if a.kinds:
+        kinds = set(a.kinds.split(","))
+        items = [it for it in items if it["kind"] in kinds]
+    items = (items * ((a.conc + len(items) - 1) // len(items)))[: a.conc]
+    t0 = time.time()
+    remaining = a.deadline - time.time()
+    with cf.ThreadPoolExecutor(max_workers=a.conc) as ex:
+        futs = [ex.submit(post, a.port, make_body(it, a.sampling, a.max_tokens), min(a.req_timeout, remaining - 2)) for it in items]
+        res = [f.result() for f in futs]
+    wall = time.time() - t0
+    n_gen = sum((d or {}).get("timings", {}).get("predicted_n", 0) or 0 for _, d, _, _ in res)
+    dn = sum((d or {}).get("timings", {}).get("draft_n", 0) or 0 for _, d, _, _ in res)
+    da = sum((d or {}).get("timings", {}).get("draft_n_accepted", 0) or 0 for _, d, _, _ in res)
+    ok = sum(1 for s, _, _, _ in res if s == 200)
+    bad_text = sum(1 for s, d, _, _ in res if s == 200 and garbage(((d or {}).get("choices") or [{}])[0].get("message", {}).get("content")))
+    out = {"conc": a.conc, "ok": ok, "n": len(res), "garbage": bad_text, "wall_s": round(wall, 2),
+           "gen_tokens": n_gen, "agg_tok_s": round(n_gen / wall, 2) if wall > 0 else None,
+           "draft_n": dn, "draft_accepted": da, "acceptance": round(da / dn, 4) if dn else None,
+           "per_req_tps": [round(((d or {}).get("timings") or {}).get("predicted_per_second") or 0, 2) for _, d, _, _ in res]}
+    with open(os.path.join(a.out, "conc.jsonl"), "a") as fh:
+        fh.write(json.dumps(out) + "\n")
+    print(f"  conc={a.conc} ok={ok}/{len(res)} garbage={bad_text} agg_tok_s={out['agg_tok_s']} acceptance={out['acceptance']} wall={out['wall_s']}s", flush=True)
+    return 0 if ok == len(res) else 12
+
+
+def main() -> int:
+    p = argparse.ArgumentParser()
+    p.add_argument("--mode", choices=["seq", "conc"], default="seq")
+    p.add_argument("--port", type=int, required=True)
+    p.add_argument("--pid", type=int, required=True)
+    p.add_argument("--log", required=True)
+    p.add_argument("--prompts", required=True)
+    p.add_argument("--kinds", default="")
+    p.add_argument("--out", required=True)
+    p.add_argument("--sampling", choices=["orig", "greedy"], default="greedy")
+    p.add_argument("--max-tokens", type=int, default=32)
+    p.add_argument("--req-timeout", type=float, default=60)
+    p.add_argument("--deadline", type=float, required=True, help="epoch seconds")
+    p.add_argument("--start", type=int, default=0)
+    p.add_argument("--conc", type=int, default=1)
+    a = p.parse_args()
+    return run_seq(a) if a.mode == "seq" else run_conc(a)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/benchmark/df29/df29_lib.sh b/scripts/benchmark/df29/df29_lib.sh
new file mode 100644
--- /dev/null
+++ b/scripts/benchmark/df29/df29_lib.sh
@@ -0,0 +1,174 @@
+#!/bin/bash
+# Shared helpers for df29_server.sh / df2_e2e.sh / run_probe.sh. Sourced, never executed.
+# Contract: every process this library starts is recorded by PID, and df29_cleanup kills exactly
+# those PIDs (SIGTERM -> wait -> SIGKILL -> verify with ps -p). No name-pattern kills, ever.
+
+DF29_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
+DF29_TARGET=/mnt/raid0/llm/models/Qwen3.8-27B-Q8_0.gguf
+DF29_DRAFTER=/mnt/raid0/llm/models/Qwen3.8-27B-DFlash2-Q8_0.gguf
+DF29_TEMPLATE=/mnt/raid0/llm/models/chat-templates/epyc-qwen3x-v1-terse.jinja
+DF29_LINKAGE=/workspace/repos/epyc-inference-research/scripts/utils/verify_ggml_linkage.sh
+# 27B Q8_0 27.05 GiB + DFlash2 Q8_0 1.92 GiB + KV/compute/HIP context headroom.
+DF29_VRAM_NEED_GIB=${DF29_VRAM_NEED_GIB:-38}
+
+DF29_PIDS=()          # every background PID we own (server, sampler, client)
+DF29_SERVER_PID=""
+DF29_SAMPLER_PID=""
+
+df29_ts() { date -u +%FT%TZ; }
+df29_log() { echo "[$(df29_ts)] $*"; }
+
+# MI210 sysfs node: the card whose vram_total is the largest (64 GiB board).
+df29_vram_node() {
+    local best="" bestv=0 f v
+    for f in /sys/class/drm/card*/device/mem_info_vram_total; do
+        [ -r "$f" ] || continue
+        v=$(cat "$f" 2>/dev/null || echo 0)
+        if [ "$v" -gt "$bestv" ]; then bestv=$v; best=$(dirname "$f"); fi
+    done
+    echo "$best"
+}
+
+df29_vram_used() { local n; n=$(df29_vram_node); [ -n "$n" ] && cat "$n/mem_info_vram_used" 2>/dev/null || echo -1; }
+df29_vram_total() { local n; n=$(df29_vram_node); [ -n "$n" ] && cat "$n/mem_info_vram_total" 2>/dev/null || echo -1; }
+
+# KFD process list (read-only). Each /sys/class/kfd/kfd/proc/<pid> is a process holding the GPU.
+df29_kfd_procs() {
+    local d p
+    for d in /sys/class/kfd/kfd/proc/*; do
+        [ -d "$d" ] || continue
+        p=$(basename "$d")
+        printf '  kfd pid=%s %s\n' "$p" "$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | cut -c1-160)"
+    done
+}
+
+# Refuse to run if the GPU lacks room for the 27B + drafter. Prints the reason; returns 1 on refusal.
+df29_vram_preflight() {
+    local used total free_gib
+    used=$(df29_vram_used); total=$(df29_vram_total)
+    if [ "$used" -lt 0 ] || [ "$total" -le 0 ]; then echo "VRAM sysfs unreadable"; return 1; fi
+    free_gib=$(( (total - used) / 1073741824 ))
+    echo "VRAM used=$((used / 1048576)) MiB total=$((total / 1048576)) MiB free=${free_gib} GiB need=${DF29_VRAM_NEED_GIB} GiB"
+    df29_kfd_procs
+    [ "$free_gib" -ge "$DF29_VRAM_NEED_GIB" ]
+}
+
+df29_port_busy() { ss -Hltn "sport = :$1" 2>/dev/null | grep -q .; }
+
+# background VRAM sampler: one line per second "epoch used_bytes" into $1
+df29_start_sampler() {
+    local out=$1 node
+    node=$(df29_vram_node)
+    ( while :; do printf '%s %s\n' "$(date +%s)" "$(cat "$node/mem_info_vram_used" 2>/dev/null || echo -1)"; sleep 1; done ) > "$out" 2>/dev/null &
+    DF29_SAMPLER_PID=$!
+    DF29_PIDS+=("$DF29_SAMPLER_PID")
+}
+
+df29_vram_peak_gib() {  # $1 = sampler file; prints peak and baseline (first sample) in GiB
+    awk 'NR==1{b=$2} {if($2>m)m=$2} END{if(NR==0){print "peak=NA base=NA"} else printf "peak=%.2f base=%.2f\n", m/1073741824, b/1073741824}' "$1" 2>/dev/null
+}
+
+# watchdog: TERM the calling script ($$) after $1 s, but only if $$ is still that script ($2 in its cmdline),
+# so a recycled PID can never be hit. The watchdog's own sleep is killed with it.
+df29_start_watchdog() {
+    local secs=$1 marker=$2
+    ( sp=""; trap '[ -n "$sp" ] && kill "$sp" 2> /dev/null; exit 0' TERM
+      sleep "$secs" & sp=$!; wait "$sp"
+      if tr '\0' ' ' < "/proc/$$/cmdline" 2> /dev/null | grep -q -- "$marker"; then
+          echo "[watchdog] wall cap ${secs}s hit -> TERM $$"; kill -TERM $$ 2> /dev/null
+      fi ) &
+    DF29_PIDS+=($!)
+}
+
+# kill exactly one PID we own: TERM, wait up to $2 s, KILL, verify.
+df29_kill_pid() {
+    local pid=$1 grace=${2:-20} i
+    [ -n "$pid" ] || return 0
+    ps -p "$pid" > /dev/null 2>&1 || return 0
+    kill -TERM "$pid" 2>/dev/null || true
+    for ((i = 0; i < grace * 2; i++)); do ps -p "$pid" > /dev/null 2>&1 || break; sleep 0.5; done
+    if ps -p "$pid" > /dev/null 2>&1; then kill -KILL "$pid" 2>/dev/null || true; sleep 1; fi
+    wait "$pid" 2>/dev/null || true
+    if ps -p "$pid" > /dev/null 2>&1; then echo "WARNING: pid $pid survived SIGKILL"; return 1; fi
+    return 0
+}
+
+df29_stop_server() {
+    if [ -n "$DF29_SERVER_PID" ]; then
+        df29_log "stopping server pid $DF29_SERVER_PID"
+        df29_kill_pid "$DF29_SERVER_PID" 30 && df29_log "server pid $DF29_SERVER_PID confirmed dead"
+        DF29_SERVER_PID=""
+    fi
+}
+
+df29_cleanup() {
+    local p
+    df29_stop_server
+    for p in "${DF29_PIDS[@]}"; do df29_kill_pid "$p" 5 > /dev/null || true; done
+    DF29_PIDS=()
+}
+
+# flag mapping per build (champion fork vs upstream master), decided from the binaries' STRINGS — never by
+# executing them (a HIP-linked llama-server --help would initialise ROCm / open /dev/kfd).
+# Sets DF29_MMAP_FLAG (array), DF29_HAS_DFLASH (0/1), DF29_HAS_NONFINITE_CHECK (0/1).
+df29_probe_flags() {
+    local bin=$1 strs
+    local f
+    strs=$(for f in "$bin"/libllama-common.so* "$bin/llama-server" "$bin/libllama-server-impl.so"; do
+               [ -f "$f" ] && strings "$f"
+           done 2> /dev/null || true)
+    if grep -q -F -- '--no-mmap' <<< "$strs"; then DF29_MMAP_FLAG=(--no-mmap)
+    elif grep -q -F -- '--load-mode' <<< "$strs"; then DF29_MMAP_FLAG=(-lm none)   # master: --no-mmap -> --load-mode
+    else DF29_MMAP_FLAG=(); fi
+    if grep -q -F 'draft-dflash' <<< "$strs"; then DF29_HAS_DFLASH=1; else DF29_HAS_DFLASH=0; fi
+    # the reject-on-non-finite guard is a champion-fork addition (common/speculative.cpp:1542); upstream has none
+    if grep -q -F 'non-finite target features' <<< "$strs"; then DF29_HAS_NONFINITE_CHECK=1; else DF29_HAS_NONFINITE_CHECK=0; fi
+}
+
+# start llama-server: $1=bin dir, $2=log, $3=port, rest = server args (without binary/host/port).
+# Exec chain env -> numactl -> taskset -> llama-server keeps $! == server PID.
+df29_start_server() {
+    local bin=$1 log=$2 port=$3; shift 3
+    local pin=()
+    if [ "${DF29_PIN:-1}" = 1 ] && command -v numactl > /dev/null; then
+        pin=(numactl --membind=3 -- taskset -c 184-191)   # production :8083 placement (GPU host lane)
+    fi
+    env -u LD_LIBRARY_PATH -u HSA_OVERRIDE_GFX_VERSION \
+        LD_LIBRARY_PATH="$bin:/opt/rocm/lib" \
+        OMP_PROC_BIND=spread OMP_PLACES=cores OMP_WAIT_POLICY=active OMP_DYNAMIC=false \
+        "${pin[@]}" "$bin/llama-server" --host 127.0.0.1 --port "$port" "$@" > "$log" 2>&1 &
+    DF29_SERVER_PID=$!
+    DF29_SERVER_START_TIME=$(python3 "$DF29_DIR/port_owner.py" --pid "$DF29_SERVER_PID" || true)
+    DF29_PIDS+=("$DF29_SERVER_PID")
+    echo "$DF29_SERVER_PID" > "$log.pid"
+    printf '%s\n' "$bin/llama-server --host 127.0.0.1 --port $port $*" > "$log.argv"
+}
+
+# wait for /health == 200; returns 0 ok, 1 died, 2 timeout
+df29_wait_health() {
+    local port=$1 deadline=$2 code
+    while [ "$(date +%s)" -lt "$deadline" ]; do
+        ps -p "$DF29_SERVER_PID" > /dev/null 2>&1 || return 1
+        local owner_rc=0
+        python3 "$DF29_DIR/port_owner.py" --pid "$DF29_SERVER_PID" --port "$port" \
+            --birth "$DF29_SERVER_START_TIME" || owner_rc=$?
+        if [ "$owner_rc" = 2 ]; then return 3; fi
+        if [ "$owner_rc" = 0 ]; then
+            code=$(curl -s -m 2 -o /dev/null -w '%{http_code}' "http://127.0.0.1:$port/health" || true)
+            if [ "$code" = 200 ]; then
+                # Recheck after the response: a foreign listener must not inherit readiness.
+                python3 "$DF29_DIR/port_owner.py" --pid "$DF29_SERVER_PID" --port "$port" \
+                    --birth "$DF29_SERVER_START_TIME" || return 3
+                return 0
+            fi
+        fi
+        sleep 1
+    done
+    return 2
+}
+
+# proof of which libs the RUNNING server mapped (read-only /proc)
+df29_server_maps() {
+    local pid=$1
+    grep -o -E '/[^ ]*lib(ggml[^ /]*|llama[^ /]*)\.so[^ ]*' "/proc/$pid/maps" 2>/dev/null | sort -u
+}
