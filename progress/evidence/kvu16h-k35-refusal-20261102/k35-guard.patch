+    """Give request-no-spec cells their own server without draft state."""
+    if scenario.request_spec_n_max != 0:
+        return scenario
+    # Unknown extras may re-enable drafting after the canonical arguments.
+    # Admit only the two combinations used by the checked-in no-spec cells.
+    if scenario.extra_args not in ((), ("-b", "512", "--no-repack", "--no-warmup")):
+        raise ValueError("unreviewed extra arguments for dedicated no-draft server")
+    return dataclasses.replace(
+        scenario, request_spec_n_max=None, draft_model=None, spec_type="none",
+        spec_draft_n_max=None, spec_draft_threads=None, spec_draft_device=None,
+        spec_draft_ngl=None,
+    )
