+def process_birth(pid: int) -> int:
+    raw = Path(f"/proc/{pid}/stat").read_text(encoding="ascii")
+    return int(raw.rsplit(") ", 1)[1].split()[19])
+
+
+def owns_loopback_listener(pid: int, birth: int, port: int) -> bool:
+    """Prove this captured process holds the loopback listener, at this instant."""
+    proc = Path(f"/proc/{pid}")
+    if process_birth(pid) != birth:
+        return False
+    inodes = set()
+    for fd in (proc / "fd").iterdir():
+        try:
+            target = os.readlink(fd)
+        except FileNotFoundError:
+            continue
+        match = re.fullmatch(r"socket:\[(\d+)\]", target)
+        if match:
+            inodes.add(match.group(1))
+    local = f"0100007F:{port:04X}"
+    with (proc / "net" / "tcp").open(encoding="ascii") as tcp:
+        next(tcp, None)
+        for line in tcp:
+            fields = line.split()
+            if len(fields) < 10:
+                raise ValueError("malformed TCP table")
+            if fields[1].upper() == local and fields[3] == "0A" and fields[9] in inodes:
+                return process_birth(pid) == birth
+    return False
+
+
