+import copy
+import hashlib
+import json
+import unittest
+from rpucg_snapshot import validate_snapshot
+
+
+def snapshot():
+    return {'schema':'epyc.rpucg.snapshot.v1', 'promotable':False,
+            'task_id':'task', 'evaluator_id':'eval', 'recipe_id':'recipe',
+            'tie_rule':'id', 'inspiration_count':1,
+            'candidates':[{'id':'a', 'source_sha256':'a'*64, 'creation_order':0,
+                'chain_id':'c', 'parent_ids':[], 'correctness_passed':True, 'normalized_reward':1},
+                {'id':'b', 'source_sha256':'b'*64, 'creation_order':1,
+                 'chain_id':'c', 'parent_ids':['a'], 'correctness_passed':True, 'normalized_reward':2}],
+            'eligible_ids':['a','b'], 'incumbent_choice_ids':['b'],
+            'visit_counts':{'c':1}, 'total_expansions':1}
+
+
+def admit(obj):
+    raw=json.dumps(obj).encode()
+    return validate_snapshot(raw,hashlib.sha256(raw).hexdigest())
+
+
+class TestAdmission(unittest.TestCase):
+    def test_valid(self):
+        self.assertEqual(admit(snapshot())['incumbent_choice_ids'], ['b'])
+    def test_failed_ineligible_ancestor_is_represented(self):
+        obj = snapshot()
+        obj['candidates'][0]['correctness_passed'] = False
+        del obj['candidates'][0]['normalized_reward']
+        obj['eligible_ids'] = ['b']
+        self.assertEqual(admit(obj)['candidates'][0]['correctness_passed'], False)
+
+    def test_failed_eligible_candidate_is_refused(self):
+        obj = snapshot()
+        obj['candidates'][0]['correctness_passed'] = False
+        with self.assertRaises(ValueError):
+            admit(obj)
+
+    def test_bad_digest_and_duplicate_keys(self):
+        with self.assertRaises(ValueError): validate_snapshot(b'{}', '0'*64)
+        raw=b'{"schema":1,"schema":2}'
+        with self.assertRaises(ValueError): validate_snapshot(raw,hashlib.sha256(raw).hexdigest())
+    def test_incomplete_and_invented_inputs_refused(self):
+        changes=[lambda x:x['candidates'][1].update(parent_ids=['absent']),
+                 lambda x:x['candidates'][0].update(parent_ids=['b']),
+                 lambda x:x.update(eligible_ids=['unknown']),
+                 lambda x:x.update(incumbent_choice_ids=['absent']),
+                 lambda x:x.update(visit_counts={}),
+                 lambda x:x['candidates'][0].update(correctness_passed=False),
+                 lambda x:x['candidates'][0].update(normalized_reward=float('nan')),
+                 lambda x:x.update(promotable=True)]
+        for change in changes:
+            obj=copy.deepcopy(snapshot()); change(obj)
+            with self.subTest(obj=obj), self.assertRaises(ValueError): admit(obj)
+
+if __name__ == '__main__': unittest.main()
