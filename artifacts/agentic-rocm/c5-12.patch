+"""Deterministic three-of-five selection over *predictions*, not results.
+
+Selection is a planning aid only. It does not evaluate a kernel or alter the
+correctness, integrity, profiling, or promotion gates.
+"""
+from math import isfinite
+from numbers import Real
+from collections.abc import Mapping, Sequence
+
+
+def select_three(proposals: Sequence[Mapping]) -> list[dict]:
+    """Pick innovation, optimistic bound, then conservative bound, without replacement.
+
+    Each proposal supplies a unique string ``id``, and finite numeric
+    ``innovation``, ``predicted_min`` and ``predicted_max`` scores. Higher is
+    better for all three; scores and bounds are estimates on one common scale.
+    Lexicographic id resolves ties independently of input ordering.
+    """
+    if len(proposals) != 5:
+        raise ValueError("exactly five proposals are required")
+    remaining = []
+    seen = set()
+    for item in proposals:
+        if not isinstance(item, Mapping):
+            raise ValueError("proposal must be a mapping")
+        key = item.get('id')
+        if not isinstance(key, str) or not key.strip() or key in seen:
+            raise ValueError("proposal ids must be unique nonempty strings")
+        seen.add(key)
+        for field in ('innovation', 'predicted_min', 'predicted_max'):
+            v = item.get(field)
+            if isinstance(v, bool) or not isinstance(v, Real) or not isfinite(v):
+                raise ValueError(f"{field} must be finite numeric")
+        if item['predicted_min'] > item['predicted_max']:
+            raise ValueError("predicted bounds are reversed")
+        remaining.append(item)
+    result = []
+    for reason, field in (('innovation', 'innovation'),
+                          ('highest_max', 'predicted_max'),
+                          ('highest_min', 'predicted_min')):
+        chosen = min(remaining, key=lambda item: (-item[field], item['id']))
+        result.append({'id': chosen['id'], 'reason': reason})
+        remaining.remove(chosen)
+    return result
diff --git a/scripts/kernel_rnd/autokernel/controller/test_c512_diversity.py b/scripts/kernel_rnd/autokernel/controller/test_c512_diversity.py
