@@ -0,0 +1,35 @@
+import unittest
+from c512_diversity import select_three
+
+
+class TestSelection(unittest.TestCase):
+    def setUp(self):
+        self.proposals = [dict(id=k, innovation=i, predicted_min=lo, predicted_max=hi)
+                          for k, i, lo, hi in [('a', 9, 8, 10), ('b', 8, 7, 11),
+                                               ('c', 7, 9, 9), ('d', 6, 6, 8),
+                                               ('e', 5, 5, 7)]]
+
+    def test_without_replacement_and_order(self):
+        self.assertEqual(select_three(self.proposals), [
+            {'id': 'a', 'reason': 'innovation'},
+            {'id': 'b', 'reason': 'highest_max'},
+            {'id': 'c', 'reason': 'highest_min'}])
+
+    def test_ties_are_order_independent(self):
+        rows = [dict(id=k, innovation=1, predicted_min=1, predicted_max=1)
+                for k in 'edcba']
+        self.assertEqual(select_three(rows), select_three(rows[::-1]))
+        self.assertEqual([r['id'] for r in select_three(rows)], list('abc'))
+
+    def test_invalid_inputs_fail_closed(self):
+        for invalid in (self.proposals[:4], self.proposals + self.proposals[:1],
+                        self.proposals[:4] + [self.proposals[0]],
+                        [dict(self.proposals[0], innovation=float('nan'))] + self.proposals[1:],
+                        [dict(self.proposals[0], predicted_min=11)] + self.proposals[1:],
+                        [dict(self.proposals[0], innovation=True)] + self.proposals[1:]):
+            with self.subTest(invalid=invalid), self.assertRaises(ValueError):
+                select_three(invalid)
+
+
+if __name__ == '__main__':
+    unittest.main()
