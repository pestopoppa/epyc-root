+// The scheduler does not split graphs at view ops, so a view of a CPU result
+// may occur inside a meta split. It remains owned by its host buffer and is a
+// no-op; it must not be projected through a meta buffer.
+static bool ggml_backend_meta_is_foreign_host_view(const ggml_tensor * node) {
+    if (!node->view_src) {
+        return false;
+    }
+    if (node->view_src->op == GGML_OP_NONE && ggml_backend_buffer_is_host(node->view_src->buffer)) {
+        return true; // preserve the existing s_copy_main exception
+    }
+    if (!node->buffer || node->buffer != node->view_src->buffer ||
+            ggml_backend_buffer_is_meta(node->buffer) || !ggml_backend_buffer_is_host(node->buffer)) {
+        return false;
+    }
+    const bool view_op = node->op == GGML_OP_VIEW || node->op == GGML_OP_RESHAPE ||
+                         node->op == GGML_OP_PERMUTE || node->op == GGML_OP_TRANSPOSE;
+    if (!view_op || !node->view_src->data || !node->data) {
+        return false;
+    }
+    const size_t src_size = ggml_nbytes(node->view_src);
+    const size_t node_size = ggml_nbytes(node);
+    const uintptr_t base = (uintptr_t) ggml_backend_buffer_get_base(node->buffer);
+    const uintptr_t src = (uintptr_t) node->view_src->data;
+    const size_t buffer_size = ggml_backend_buffer_get_size(node->buffer);
+    if (src < base || src - base > buffer_size || src_size > buffer_size - (src - base) ||
+            node->view_offs > src_size || node_size > src_size - node->view_offs ||
+            node->view_offs > UINTPTR_MAX - src) {
+        return false;
+    }
+    return (uintptr_t) node->data == src + node->view_offs;
+}
