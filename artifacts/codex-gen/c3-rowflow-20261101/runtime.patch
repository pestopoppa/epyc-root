+#!/usr/bin/env python3
+"""Publish host-only C3 outputs into the rowflow-visible shared scratch tree."""
+from __future__ import annotations
+import datetime as dt
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import sys
+
+HOST_ROOT = Path('/mnt/micron/refactor-c3-native-profile-r4-20261101')
+SHARED_ROOT = Path('/mnt/raid0/llm/tmp/refactor-c3-native-profile-r4-20261101')
+
+def sha(path: Path) -> str:
+    h = hashlib.sha256()
+    with path.open('rb') as f:
+        for block in iter(lambda: f.read(1 << 20), b''):
+            h.update(block)
+    return h.hexdigest()
+
+def main() -> int:
+    if len(sys.argv) != 2:
+        raise SystemExit('usage: publish-result-v2.py HOST_RUN_DIR')
+    source = Path(sys.argv[1])
+    if source.parent != HOST_ROOT or not source.name.startswith('run-') or source.is_symlink() or not source.is_dir():
+        raise SystemExit('refusing unexpected host run path')
+    source_pass = source / 'pass-B'
+    names = ('capture.json', 'belief-receipt.json')
+    for name in names:
+        p = source_pass / name
+        if p.is_symlink() or not p.is_file():
+            raise SystemExit(f'missing or unsafe source artifact: {p}')
+        json.loads(p.read_text())
+    results = SHARED_ROOT / 'results'
+    results.mkdir(parents=True, exist_ok=True)
+    dest = results / source.name
+    stage = results / f'.{source.name}.tmp-{os.getpid()}'
+    if dest.exists() or stage.exists():
+        raise SystemExit(f'result destination already exists: {dest}')
+    try:
+        stage_pass = stage / 'pass-B'
+        stage_pass.mkdir(parents=True)
+        artifacts = {}
+        for name in names:
+            src = source_pass / name
+            dst = stage_pass / name
+            shutil.copyfile(src, dst)
+            source_sha, copied_sha = sha(src), sha(dst)
+            if source_sha != copied_sha:
+                raise SystemExit(f'copy hash mismatch: {name}')
+            artifacts[name] = {'host_source': str(src), 'shared_copy': str(dest / 'pass-B' / name),
+                               'sha256': source_sha}
+        provenance = {
+            'schema': 'c3-native-r4-shared-result-provenance-v1',
+            'run_id': source.name,
+            'host_run_path': str(source),
+            'shared_run_path': str(dest),
+            'copied_at_utc': dt.datetime.now(dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
+            'artifacts': artifacts,
+        }
+        (stage / 'source-provenance.json').write_text(json.dumps(provenance, sort_keys=True, indent=2) + '\n')
+        os.rename(stage, dest)  # publish only after artifacts + provenance are complete
+    except BaseException:
+        shutil.rmtree(stage, ignore_errors=True)
+        raise
+    print(dest)
+    return 0
+
+if __name__ == '__main__':
+    raise SystemExit(main())
