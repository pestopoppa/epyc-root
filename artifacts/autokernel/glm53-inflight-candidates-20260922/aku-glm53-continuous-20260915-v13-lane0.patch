+struct iqk_numa_owner_map {
+    const int64_t ne01;
+    const int64_t ne02;
+    const int64_t units_per_expert;
+    const int64_t slab_gran;
+    const size_t  nb01;
+    const size_t  nb02;
+    bool valid;
+    std::vector<int> owner;
+};
+
+const iqk_numa_owner_map * iqk_get_numa_owner_map(
+        const void * data, int64_t ne01, int64_t ne02, size_t nb01, size_t nb02,
+        int64_t units_per_expert, int64_t slab_gran) {
+    static std::mutex cache_mutex;
+    static std::unordered_map<const void *, std::unique_ptr<iqk_numa_owner_map>> cache;
+
+    std::lock_guard<std::mutex> lock(cache_mutex);
+    auto found = cache.find(data);
+    if (found != cache.end()) {
+        const iqk_numa_owner_map * map = found->second.get();
+        return map->ne01 == ne01 && map->ne02 == ne02 && map->nb01 == nb01 && map->nb02 == nb02 &&
+               map->units_per_expert == units_per_expert && map->slab_gran == slab_gran ? map : nullptr;
+    }
+
+    auto map = std::make_unique<iqk_numa_owner_map>(iqk_numa_owner_map{
+        ne01, ne02, units_per_expert, slab_gran, nb01, nb02, true,
+        std::vector<int>((size_t) ne02 * units_per_expert, -1)
+    });
+
+    constexpr size_t query_batch = 4096;
+    std::vector<void *> pages;
+    std::vector<int> status(query_batch);
+    std::vector<size_t> tile_index;
+    pages.reserve(query_batch);
+    tile_index.reserve(query_batch);
+
+    const uintptr_t page_size = (uintptr_t) sysconf(_SC_PAGESIZE);
+    if (page_size == 0 || (page_size & (page_size - 1)) != 0) {
+        map->valid = false;
+    }
+
+    auto query = [&]() {
+        if (pages.empty() || !map->valid) return;
+        const long rc = syscall(SYS_move_pages, 0, pages.size(), pages.data(), nullptr, status.data(), 0);
+        if (rc < 0) {
+            map->valid = false;
+        } else {
+            for (size_t i = 0; i < pages.size(); ++i) {
+                map->owner[tile_index[i]] = status[i] >= 0 ? status[i] : -1;
+            }
+        }
+        pages.clear();
+        tile_index.clear();
+    };
+
+    // A row tile can straddle pages. Its middle page is stable for immutable weights and
+    // avoids making the query itself proportional to the bytes consumed by the kernel.
+    for (int64_t expert = 0; map->valid && expert < ne02; ++expert) {
+        for (int64_t unit = 0; unit < units_per_expert; ++unit) {
+            const uintptr_t begin = (uintptr_t) data + (size_t) expert * nb02 +
+                (size_t) unit * slab_gran * nb01;
+            const uintptr_t end = begin + (size_t) slab_gran * nb01;
+            const uintptr_t middle_page = (begin + (end - begin) / 2) & ~(page_size - 1);
+            pages.push_back((void *) middle_page);
+            tile_index.push_back((size_t) expert * units_per_expert + unit);
+            if (pages.size() == query_batch) query();
+        }
+    }
+    query();
+
+    const iqk_numa_owner_map * result = map.get();
+    cache.emplace(data, std::move(map));
+    return result;
+}
