 static bool ggml_cpu_disable_fusion = false;  // initialized once in ggml_cpu_init(), read-only afterwards
 
+#if defined(GGML_USE_IQK_MULMAT)
+#define GGML_TYPE_Q8_2_X4 99
+
+void quantize_row_q8_2_x4(const float * x, void * y, int64_t k);
+bool iqk_moe_fused_up_gate(long Nx, long Ny, long ne00, int ne11, bool allow_rowexact, int unary_op,
+        int typeA, const void * Aup, const void * Agate, long strideA,
