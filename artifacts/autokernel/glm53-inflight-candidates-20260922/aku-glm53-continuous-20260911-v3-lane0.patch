+        float * C, long nb1, long nb2, const void * vrow_mapping, float limit, int ith, int nth);
+
+static bool ggml_cpu_iqk_fused_moe_swiglu(
+        const struct ggml_compute_params * params,
+        const struct ggml_tensor * gate,
+        const struct ggml_tensor * up,
+        struct ggml_tensor * dst) {
+    const struct ggml_tensor * wgate = gate->src[0];
+    const struct ggml_tensor * wup   = up->src[0];
+    const struct ggml_tensor * x     = gate->src[1];
+    const struct ggml_tensor * ids   = gate->src[2];
+
+    const char * iqk = getenv("GGML_IQK");
+    if (iqk == NULL || atoi(iqk) == 0 || params->use_ref || params->disable_rowexact) {
+        return false;
+    }
+    if (gate->type != GGML_TYPE_F32 || up->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 ||
+        x->type != GGML_TYPE_F32 || ids->type != GGML_TYPE_I32 || wgate->type != wup->type ||
+        (wgate->type != GGML_TYPE_Q4_K && wgate->type != GGML_TYPE_Q5_K && wgate->type != GGML_TYPE_Q6_K) ||
+        wgate->ne[0] != x->ne[0] || wup->ne[0] != x->ne[0] ||
+        wgate->ne[1] != wup->ne[1] || wgate->ne[2] != wup->ne[2] ||
+        wgate->nb[1] != wup->nb[1] || x->ne[0] % 32 != 0 || x->ne[3] != 1 ||
+        gate->ne[0] != dst->ne[0] || gate->ne[1] != dst->ne[1] || gate->ne[2] != dst->ne[2] ||
+        up->ne[0] != dst->ne[0] || up->ne[1] != dst->ne[1] || up->ne[2] != dst->ne[2] ||
+        dst->nb[0] != sizeof(float)) {
+        return false;
+    }
+
+    const int64_t n_ids = ids->ne[0];
+    const int n_as = (int) wgate->ne[2];
+    const size_t act_row = (size_t) (x->ne[0] / 32) * 36;
+    const size_t act_size = act_row * x->ne[1] * x->ne[2];
+
+    char * base = (char *) params->wdata;
+    if (base == NULL) {
+        return false;
+    }
+    char * cur = base + GGML_PAD(act_size, sizeof(int64_t));
+    int64_t * row_counts = (int64_t *) cur;
+    cur += GGML_PAD((size_t) n_as * sizeof(int64_t), sizeof(int64_t));
+    struct mmid_row_mapping * rows = (struct mmid_row_mapping *) cur;
+    cur += (size_t) n_as * n_ids * ids->ne[1] * sizeof(struct mmid_row_mapping);
+    if (params->wsize < (size_t) (cur - base)) {
+        return false;
+    }
+
+    for (int64_t i12 = 0; i12 < x->ne[2]; ++i12) {
+        for (int64_t i11 = params->ith; i11 < x->ne[1]; i11 += params->nth) {
+            quantize_row_q8_2_x4(
+                    (const float *) ((const char *) x->data + i12*x->nb[2] + i11*x->nb[1]),
+                    base + i12*act_row*x->ne[1] + i11*act_row, x->ne[0]);
+        }
+    }
+
+    for (int64_t i = params->ith; i < ids->ne[1]; i += params->nth) {
+        for (int64_t id = 0; id < n_ids; ++id) {
+            const int32_t expert = *(const int32_t *) ((const char *) ids->data + i*ids->nb[1] + id*ids->nb[0]);
+            if (expert < 0 || expert >= n_as) {
+                memset((char *) dst->data + id*dst->nb[1] + i*dst->nb[2], 0, dst->ne[0]*sizeof(float));
+            }
+        }
+    }
+
+    if (params->ith == 0) {
+        memset(row_counts, 0, (size_t) n_as * sizeof(int64_t));
+        for (int64_t i = 0; i < ids->ne[1]; ++i) {
+            for (int64_t id = 0; id < n_ids; ++id) {
+                const int32_t expert = *(const int32_t *) ((const char *) ids->data + i*ids->nb[1] + id*ids->nb[0]);
+                if (expert < 0 || expert >= n_as) {
+                    continue;
+                }
+                rows[(size_t) expert*n_ids*ids->ne[1] + row_counts[expert]++] =
+                    (struct mmid_row_mapping) { (int32_t) id, (int32_t) i };
+            }
+        }
+    }
+    ggml_barrier(params->threadpool);
+
+    const bool global_rowexact = ids->ne[1] > 1 && ids->ne[1] <= ggml_cpu_rowexact_n();
+    if (!global_rowexact) {
+        for (int expert = 0; expert < n_as; ++expert) {
+            const int64_t nr = row_counts[expert];
+            if (nr > 1 && nr <= ggml_cpu_rowexact_n()) {
+                return false;
+            }
+        }
+    }
+
+    for (int expert = 0; expert < n_as; ++expert) {
+        const int64_t nr = row_counts[expert];
+        if (nr == 0) {
+            continue;
+        }
+        const struct mmid_row_mapping * mapping = rows + (size_t) expert*n_ids*ids->ne[1];
+        if (!iqk_moe_fused_up_gate(
+                    wup->ne[1], nr, x->ne[0], (int) x->ne[1], global_rowexact, GGML_UNARY_OP_SILU,
+                    (int) wup->type,
+                    (const char *) wup->data + (size_t) expert*wup->nb[2],
+                    (const char *) wgate->data + (size_t) expert*wgate->nb[2], wup->nb[1],
+                    GGML_TYPE_Q8_2_X4, base, act_row, NULL, NULL,
+                    (float *) dst->data, dst->nb[1], dst->nb[2], mapping, 10.0f,
+                    params->ith, params->nth)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+#undef GGML_TYPE_Q8_2_X4
+#endif
