+#ifndef GGML_USE_CPU_RISCV64_SPACEMIT
+static bool ggml_cpu_node_is_rowcol_f32(const struct ggml_tensor * node) {
+    if (node->type != GGML_TYPE_F32 || !ggml_is_contiguous(node) ||
+        !node->src[0] || node->src[0]->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(node->src[0]) || !ggml_are_same_shape(node, node->src[0])) {
+        return false;
+    }
+
+    switch (node->op) {
+        case GGML_OP_ADD:
+        case GGML_OP_SUB:
+        case GGML_OP_MUL:
+        case GGML_OP_DIV:
+            return node->src[1] && node->src[1]->type == GGML_TYPE_F32 &&
+                   ggml_is_contiguous(node->src[1]);
+        case GGML_OP_SQR:
+        case GGML_OP_SQRT:
+        case GGML_OP_LOG:
+        case GGML_OP_SIN:
+        case GGML_OP_COS:
+            return true;
+        case GGML_OP_UNARY:
+            switch (ggml_get_unary_op(node)) {
+                case GGML_UNARY_OP_ABS:
+                case GGML_UNARY_OP_SGN:
+                case GGML_UNARY_OP_NEG:
+                case GGML_UNARY_OP_STEP:
+                case GGML_UNARY_OP_TANH:
+                case GGML_UNARY_OP_ELU:
+                case GGML_UNARY_OP_RELU:
+                case GGML_UNARY_OP_SIGMOID:
+                case GGML_UNARY_OP_HARDSWISH:
+                case GGML_UNARY_OP_HARDSIGMOID:
+                case GGML_UNARY_OP_EXP:
+                case GGML_UNARY_OP_EXPM1:
+                case GGML_UNARY_OP_SOFTPLUS:
+                case GGML_UNARY_OP_XIELU:
+                case GGML_UNARY_OP_FLOOR:
+                case GGML_UNARY_OP_CEIL:
+                case GGML_UNARY_OP_ROUND:
+                case GGML_UNARY_OP_TRUNC:
+                    return true;
+                default:
+                    return false;
+            }
+        default:
+            return false;
+    }
+}
+
+static bool ggml_cpu_can_chain_rowcol_f32(
+        const struct ggml_cgraph * cgraph,
+        int producer_n,
+        int consumer_n) {
+    if (consumer_n >= cgraph->n_nodes || !ggml_node_has_n_uses(cgraph, producer_n, 1)) {
+        return false;
+    }
+
+    const struct ggml_tensor * producer = cgraph->nodes[producer_n];
+    const struct ggml_tensor * consumer = cgraph->nodes[consumer_n];
+
+    return (consumer->flags & GGML_TENSOR_FLAG_COMPUTE) != 0 &&
+           consumer->src[0] == producer &&
+           ggml_are_same_shape(producer, consumer) &&
+           ggml_cpu_node_is_rowcol_f32(producer) &&
+           ggml_cpu_node_is_rowcol_f32(consumer);
+}
+#endif
