+def test_pre_rectification_rows_are_named_synthetic_id_verdicts(tmp_path):
+    """Rows with no `classifier` came from the fake-token client (uniq/top/run vacuous):
+    the census must say so instead of letting the verdict read as a full v1 check."""
+    runs = make_arm(tmp_path)
+    tup = reader.project(reader.native_rows(write(runs))[0])
+    assert tup.extra["coherence_classifier"] == {capture.LEGACY_CLASSIFIER: 4}
+    # informational only: the grade is unchanged
+    assert ct.grade(tup)[:2] == ("Witnessed", "Attested")
+
