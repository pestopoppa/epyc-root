+const CUDA_MARKER_RE = /__global__|__device__|__host__|__launch_bounds__|__forceinline__|__noinline__|<<</;
+export function maskCudaSyntax(text) {
+    if (typeof text !== 'string' || !CUDA_MARKER_RE.test(text))
+        return text;
+    const out = text.split('');
+    const blank = (from, to) => {
+        for (let i = from; i < to; i++)
