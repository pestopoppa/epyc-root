+        for (; i < text.length; i++) {
+            if (text[i] === '(')
+                depth++;
+            else if (text[i] === ')' && --depth === 0)
+                break;
+        }
+        if (i >= text.length)
+            break;
+        blank(m.index, i + 1);
+        lb.lastIndex = i + 1;
+    }
+    const kw = /\b(?:__global__|__device__|__host__|__forceinline__|__noinline__)\b/g;
+    while ((m = kw.exec(text)) !== null)
+        blank(m.index, m.index + m[0].length);
+    let from = 0;
+    for (;;) {
+        const open = text.indexOf('<<<', from);
+        if (open < 0)
+            break;
+        const close = text.indexOf('>>>', open + 3);
+        if (close < 0)
+            break;
+        if (!/[;{}]/.test(text.slice(open + 3, close)))
+            blank(open, close + 3);
+        from = open + 3;
+    }
