name: NI37 native DTAP timeout report fixtures
on:
  push:
    branches: ['codex/ni37-dtap-timeout-validation-20261005']
permissions:
  contents: read
env:
  SOURCE_SHA: a2494f019d5d662f56971142ccfd9b1d4610bc0c
  APP_SOURCE_SHA: 4238a82eee82a38d5fe5b868949649dcc5c7e5d1
jobs:
  timeout-report:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ env.SOURCE_SHA }}
          path: source
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.sha }}
          path: recipe
      - uses: actions/checkout@v4
        with:
          repository: pestopoppa/epyc-orchestrator
          ref: ${{ env.APP_SOURCE_SHA }}
          path: app-source
      - uses: actions/setup-python@v5
        with:
          python-version: '3.13'
      - name: Install and identify the exact fixture runner
        run: |
          python -m pip install pytest==9.1.1 PyYAML==6.0.3
          python -c 'from importlib.metadata import version; print("pytest=" + version("pytest")); print("PyYAML=" + version("PyYAML"))'
      - name: Declare original offline scope and prepare bounded capture caller
        working-directory: source
        run: |
          set -euo pipefail
          mkdir -m 700 "$HOME/ni37-private-fixtures"
          test -f "$GITHUB_WORKSPACE/app-source/scripts/autopilot/evals/dtap/harness/runner.py"
          test -f scripts/vidya/adapters/dtap_timeout_report.py
          cat > ni37-capture-phase.sh <<'CAPTURE'
          #!/bin/bash
          set -u
          phase=$1
          shift
          python - "$phase" <<'PY'
          import json, os, sys
          from pathlib import Path
          phase = sys.argv[1]
          context = {
              "phase": phase,
              "scope": "approved synthetic DTAP fixture command; real trusted producer/judges and sole verifier reader, no endpoint request",
              "app_source_sha": os.environ["APP_SOURCE_SHA"],
              "root_source_sha": os.environ["SOURCE_SHA"],
              "dependency_scope": "pytest9.1.1 plus PyYAML6.0.3 from the checked-in app uv.lock; selected recorded dependency alignment, not a full frozen lock install",
              "native_write_boundary": "opt-in run_matrix original pre-request before any endpoint factory/run; original traces and terminal recomputation before receipt",
              "primary_metrics": "benign task_success higher; attack_success lower; count/rate components descriptive",
              "censoring": "actual terminal native TimeoutError only; recovered retries not censored; non-timeout errors retained in finished denominator; empty rate null",
              "private_custody": "owned 0700 test hierarchy under runner HOME; original source/trace/request/terminal/receipt bodies remain private and are not uploaded",
              "public_proof": "existing CI original JUnit/log/readset; root phase generated safe five-unit fixture projection and native artifact digests only, no private filenames/body/argv",
              "applicability": "synthetic reviewed dry-run fixtures and typed fault controls only; network calls replaced by named urlopen fixture",
              "command_time_limit_s": 180,
              "termination_policy": "inner SIGINT then SIGKILL after 15 seconds",
              "outer_capture_time_limit_s": 240,
              "outer_termination_policy": "native CI producer SIGTERM then SIGKILL after 15 seconds; interrupted or incomplete originals remain diagnostic",
              "exclusions": ["live transport applicability", "inference", "production/provider access", "performance", "promotion", "field robustness rates", "entire dependency completeness", "private body/filename/argv export", "old-run backfill"]}
          with open(phase + "-context.json", "x") as output:
              json.dump(context, output, indent=2, sort_keys=True)
              output.write("\n")
          PY
          read_args=(--read-path "$phase-context.json"
            --read-path "$GITHUB_WORKSPACE/recipe/.github/workflows/ni37-dtap-timeout-validation.yml"
            --read-path ni37-capture-phase.sh --read-path scripts/ci/native_conformance.py
            --read-path scripts/vidya/adapters/dtap_timeout_report.py
            --read-path scripts/vidya/adapters/ci_conformance.py
            --read-path scripts/vidya/claim_tuple.py --read-path scripts/vidya/canonical.py
            --read-path scripts/vidya/frames.py --read-path scripts/vidya/ledger.py
            --read-path scripts/vidya/cli.py --read-path scripts/vidya/ingest_sources.py
            --read-path tests/vidya/test_dtap_timeout_report.py
            --read-path tests/vidya/test_ingest_sources.py
            --read-path "$GITHUB_WORKSPACE/app-source/uv.lock"
            --read-path "$GITHUB_WORKSPACE/app-source/scripts/autopilot/evals/dtap/cases.json"
            --read-path "$GITHUB_WORKSPACE/app-source/scripts/autopilot/evals/dtap/README.md"
            --read-path "$GITHUB_WORKSPACE/app-source/scripts/autopilot/evals/dtap/tests/conftest.py"
            --read-path "$GITHUB_WORKSPACE/app-source/scripts/autopilot/evals/dtap/tests/test_dtap_harness.py"
            --read-path "$GITHUB_WORKSPACE/app-source/scripts/autopilot/evals/dtap/tests/test_judge_guard.py")
          for input in "$PWD"/scripts/vidya/adapters/*.py \
            "$GITHUB_WORKSPACE"/app-source/scripts/autopilot/evals/dtap/harness/*.py \
            "$GITHUB_WORKSPACE"/app-source/scripts/autopilot/evals/dtap/harness/shims/*.py \
            "$GITHUB_WORKSPACE"/app-source/scripts/autopilot/evals/dtap/judges/*/judge.py \
            "$GITHUB_WORKSPACE"/app-source/scripts/autopilot/evals/dtap/fixtures/*.json; do
            read_args+=(--read-path "$input")
          done
          generated_args=()
          if test "$phase" = ni37-app-fixtures; then
            select_args=(--select scripts/autopilot/evals/dtap/tests/test_dtap_harness.py
              --select scripts/autopilot/evals/dtap/tests/test_judge_guard.py)
          else
            select_args=(--select tests/vidya/test_dtap_timeout_report.py
              --select tests/vidya/test_ingest_sources.py)
            generated_args=(--generated-output ni37-safe-native-projection.json)
          fi
          timeout --signal=TERM --kill-after=15s 240s python scripts/ci/native_conformance.py \
            --cwd "$PWD" --junit "$phase.xml" --output "native-$phase" \
            --repo "root_source=$PWD" --repo "recipe=$GITHUB_WORKSPACE/recipe" \
            --repo "app_source=$GITHUB_WORKSPACE/app-source" \
            "${read_args[@]}" "${select_args[@]}" "${generated_args[@]}" -- \
            timeout --signal=INT --kill-after=15s 180s "$@"
          status=$?
          if test -f "native-$phase/command.log"; then cat "native-$phase/command.log"; fi
          exit "$status"
          CAPTURE
      - name: Prospectively capture DTAP semantics, replay and judge guards
        working-directory: source
        run: |
          bash ni37-capture-phase.sh ni37-app-fixtures python -m pytest -q \
            "$GITHUB_WORKSPACE/app-source/scripts/autopilot/evals/dtap/tests/test_dtap_harness.py" \
            "$GITHUB_WORKSPACE/app-source/scripts/autopilot/evals/dtap/tests/test_judge_guard.py" \
            --basetemp="$HOME/ni37-private-fixtures/app" --junitxml=ni37-app-fixtures.xml
      - name: Preserve first original execution prefix immediately
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: ni37-${{ github.run_id }}-${{ github.run_attempt }}-app-fixtures
          path: |
            source/native-ni37-app-fixtures/
            source/ni37-app-fixtures.xml
            source/ni37-app-fixtures-context.json
            source/ni37-capture-phase.sh
      - name: Prospectively capture original-report reader, CLI privacy and enrollment
        if: always()
        working-directory: source
        env:
          NI37_APP_ROOT: ${{ github.workspace }}/app-source
          NI37_PROJECTION_OUTPUT: ${{ github.workspace }}/source/ni37-safe-native-projection.json
        run: |
          bash ni37-capture-phase.sh ni37-reader-fixtures python -m pytest -q \
            tests/vidya/test_dtap_timeout_report.py \
            tests/vidya/test_ingest_sources.py \
            --basetemp="$HOME/ni37-private-fixtures/reader" --junitxml=ni37-reader-fixtures.xml
      - name: Preserve second original execution prefix immediately
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: ni37-${{ github.run_id }}-${{ github.run_attempt }}-reader-fixtures
          path: |
            source/native-ni37-reader-fixtures/
            source/ni37-reader-fixtures.xml
            source/ni37-reader-fixtures-context.json
            source/ni37-safe-native-projection.json
      - name: Reopen original CI findings with sole shared carrier and grader
        if: always()
        working-directory: source
        run: |
          python - <<'PY'
          import json
          from pathlib import Path
          from scripts.ci.native_conformance import read_receipt
          from scripts.vidya.adapters.ci_conformance import native_rows, project_ci_conformance
          from claim_tuple import grade
          results = []
          for phase in ("ni37-app-fixtures", "ni37-reader-fixtures"):
              path = Path("native-" + phase) / "receipt.json"
              try:
                  record, sha = read_receipt(path)
                  rows = native_rows(path)
                  cases = record["summary"]["cases"] if record["summary"] else []
                  modules = sorted({case["classname"].rsplit(".", 1)[-1] for case in cases})
                  per_module = {module: {status: sum(case["classname"].rsplit(".", 1)[-1] == module
                      and case["status"] == status for case in cases)
                      for status in ("passed", "failure", "error", "skipped")} for module in modules}
                  results.append({"phase": phase, "receipt_file_sha256": sha,
                      "conformant": record["fixture_execution_conformant"],
                      "diagnostic": record["diagnostic"],
                      "counts": record["summary"]["counts"] if record["summary"] else None,
                      "counts_by_module": per_module,
                      "grade": list(grade(project_ci_conformance(rows[0]))) if rows else None})
              except (OSError, ValueError) as exc:
                  results.append({"phase": phase, "original_custody_refused": type(exc).__name__})
          with open("ni37-ci-native-projections.json", "x") as output:
              json.dump(results, output, indent=2, sort_keys=True)
          print(json.dumps(results, sort_keys=True))
          for result in results:
              if (result.get("conformant") is not True or result["counts"]["skipped"]
                      or result["counts"]["failure"] or result["counts"]["error"]):
                  raise ValueError("original fixture phase is not successful; original false/diagnostic outcomes remain unchanged")
          if results[1]["counts_by_module"].get("test_dtap_timeout_report", {}).get("passed") != 24:
              raise ValueError("reader phase does not have the reviewed 24 native controls; generic ingestion counts are independent")
          PY
      - name: Preserve original public projection
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: ni37-${{ github.run_id }}-${{ github.run_attempt }}-native-projections
          path: source/ni37-ci-native-projections.json
