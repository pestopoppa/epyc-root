name: NI10 explicit client-class fixture custody

on:
  push:
    branches:
      - codex/ni10-client-class-validation-20261005

permissions:
  contents: read

env:
  ROOT_PRODUCER_SHA: adbbe58e591f5e6dc444019551c91a9d6cd10a11
  APP_BASE_SHA: 300cf5817edccc4f82089f0faa477828496068b6
  APP_SOURCE_SHA: 37e3cd507c78dbb76a458282c30b00aafee71706
  APP_SYNTHETIC_SHA: 8e0a1d4e8072df6787151abfc21ea9506fc4820c
  CAPTURE_ROOT: artifacts/ni10-client-class-validation

jobs:
  explicit-client-class:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    env:
      CI: 'true'
      ORCHESTRATOR_MOCK_MODE: 'true'
    steps:
      - name: Define runner-local locked environment path
        run: |
          test ! -e "$RUNNER_TEMP/ni10-unavailable-binary-directory"
          test ! -e "$RUNNER_TEMP/ni10-unavailable-mtmd-binary"
          test ! -e "$RUNNER_TEMP/ni10-unavailable-llama-server"
          printf 'UV_PROJECT_ENVIRONMENT=%s/ni10-client-class-venv\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          printf 'ORCHESTRATOR_PATHS_LLAMA_CPP_BIN=%s/ni10-unavailable-binary-directory\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          printf 'ORCHESTRATOR_PATHS_LLAMA_MTMD=%s/ni10-unavailable-mtmd-binary\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          printf 'ORCHESTRATOR_PATHS_LLAMA_SERVER=%s/ni10-unavailable-llama-server\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"

      - name: Checkout immutable workflow candidate
        uses: actions/checkout@v4
        with:
          ref: ${{ github.sha }}
          path: ci-control

      - name: Checkout pinned native receipt producer
        uses: actions/checkout@v4
        with:
          repository: pestopoppa/epyc-root
          ref: ${{ env.ROOT_PRODUCER_SHA }}
          path: root-producer

      - name: Checkout ordinary app source candidate
        uses: actions/checkout@v4
        with:
          repository: pestopoppa/epyc-orchestrator
          ref: ${{ env.APP_SOURCE_SHA }}
          fetch-depth: 2
          path: app-ordinary

      - name: Checkout synthetic-only fixture candidate
        uses: actions/checkout@v4
        with:
          repository: pestopoppa/epyc-orchestrator
          ref: ${{ env.APP_SYNTHETIC_SHA }}
          fetch-depth: 2
          path: app-synthetic

      - name: Verify source ancestry and bounded fixture-only delta
        id: compare
        run: |
          test "$(git -C ci-control rev-parse HEAD)" = "${GITHUB_SHA}"
          test "$(git -C root-producer rev-parse HEAD)" = "$ROOT_PRODUCER_SHA"
          test "$(git -C app-ordinary rev-parse HEAD)" = "$APP_SOURCE_SHA"
          test "$(git -C app-ordinary rev-parse HEAD^)" = "$APP_BASE_SHA"
          test "$(git -C app-synthetic rev-parse HEAD)" = "$APP_SYNTHETIC_SHA"
          test "$(git -C app-synthetic rev-parse HEAD^)" = "$APP_SOURCE_SHA"
          changed="$(git -C app-synthetic diff --name-only "$APP_SOURCE_SHA" "$APP_SYNTHETIC_SHA")"
          test "$changed" = "tests/fixtures/offhost_unit_bootstrap.py"
          python - <<'PY'
          import hashlib
          import json
          import subprocess
          from pathlib import Path

          ordinary = Path("app-ordinary")
          synthetic = Path("app-synthetic")
          expected_ni10_source_delta = sorted([
              "src/api/models/openai.py",
              "src/api/routes/openai_compat.py",
              "src/llm_primitives/inference.py",
              "tests/unit/test_openai_client_tool_mode.py",
              "tests/unit/test_serving_calls.py",
          ])
          source_delta = subprocess.check_output(
              ["git", "-C", str(ordinary), "diff", "--name-only",
               "300cf5817edccc4f82089f0faa477828496068b6",
               "37e3cd507c78dbb76a458282c30b00aafee71706"],
              text=True,
          )
          if sorted(path for path in source_delta.splitlines() if path) != expected_ni10_source_delta:
              raise SystemExit("ordinary NI10 source candidate differs from the reviewed five-file manifest")
          paths = [
              "src/api/models/openai.py",
              "src/api/routes/openai_compat.py",
              "src/llm_primitives/inference.py",
              "tests/unit/test_openai_client_tool_mode.py",
              "tests/unit/test_serving_calls.py",
              "tests/conftest.py",
              "tests/unit/conftest.py",
              "pyproject.toml",
              "uv.lock",
              "scripts/server/stack_manifest.py",
              "scripts/server/stack_paths.py",
              "src/registry/kernel_paths.py",
              "src/config/models.py",
              "orchestration/model_registry.yaml",
              "orchestration/stack_topology.yaml",
          ]
          records = []
          for relative in paths:
              left, right = ordinary / relative, synthetic / relative
              if not left.is_file() or not right.is_file():
                  raise SystemExit(f"missing declared comparison input: {relative}")
              left_bytes, right_bytes = left.read_bytes(), right.read_bytes()
              left_sha = hashlib.sha256(left_bytes).hexdigest()
              right_sha = hashlib.sha256(right_bytes).hexdigest()
              if left_sha != right_sha:
                  raise SystemExit(f"ordinary/synthetic source mismatch: {relative}")
              records.append({"path": relative, "sha256": left_sha, "identical": True})

          helper = synthetic / "tests/fixtures/offhost_unit_bootstrap.py"
          helper_sha = hashlib.sha256(helper.read_bytes()).hexdigest()
          if helper_sha != "9b1758788336d7d42d55171dbd463762f0a160a0efeb382db701194a3e0d7cda":
              raise SystemExit("synthetic bootstrap differs from reviewed donor bytes")
          native_producer = Path("root-producer/scripts/ci/native_conformance.py")
          if not native_producer.is_file():
              raise SystemExit("pinned root native producer is missing")
          comparison = {
              "schema": "ni10.client_class_source_comparison.v1",
              "ordinary_app_sha": "37e3cd507c78dbb76a458282c30b00aafee71706",
              "ordinary_app_parent_sha": "300cf5817edccc4f82089f0faa477828496068b6",
              "synthetic_app_sha": "8e0a1d4e8072df6787151abfc21ea9506fc4820c",
              "synthetic_app_parent_sha": "37e3cd507c78dbb76a458282c30b00aafee71706",
              "synthetic_only_changed_path": "tests/fixtures/offhost_unit_bootstrap.py",
              "synthetic_bootstrap_sha256": helper_sha,
              "native_producer_sha256": hashlib.sha256(native_producer.read_bytes()).hexdigest(),
              "ordinary_ni10_changed_paths": expected_ni10_source_delta,
              "compared_source_and_fixture_path_count": len(records),
              "ordinary_and_synthetic_paths_identical": True,
              "synthetic_bootstrap_scope": "explicit test-process-only 1 TiB host RAM; production validator unchanged",
              "inputs": records,
          }
          with Path("ci-control/ni10-source-comparison.json").open("x", encoding="utf-8") as output:
              output.write(json.dumps(comparison, sort_keys=True) + "\n")
          PY

      - name: Set up Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Set up uv
        uses: astral-sh/setup-uv@v5
        with:
          enable-cache: false

      - name: Install locked orchestrator test environment
        id: dependencies
        working-directory: app-synthetic
        run: uv sync --frozen --extra dev

      - name: Write the isolated actual-runner capacity guard fixture
        id: guard_fixture
        if: ${{ always() && steps.dependencies.outcome == 'success' && steps.compare.outcome == 'success' }}
        working-directory: app-ordinary
        run: |
          mkdir -p ni10_capacity_guard
          python - <<'PY'
          import hashlib
          import json
          import os
          from pathlib import Path

          test_path = Path("ni10_capacity_guard/test_actual_capacity_guard.py")
          kernel_path_override = Path(os.environ["ORCHESTRATOR_PATHS_LLAMA_CPP_BIN"])
          if kernel_path_override.exists():
              raise RuntimeError(f"actual capacity fixture kernel path must remain absent: {kernel_path_override}")
          mtmd_path_override = Path(os.environ["ORCHESTRATOR_PATHS_LLAMA_MTMD"])
          if mtmd_path_override.exists():
              raise RuntimeError(f"actual capacity fixture vision binary path must remain absent: {mtmd_path_override}")
          llama_server_path_override = Path(os.environ["ORCHESTRATOR_PATHS_LLAMA_SERVER"])
          if llama_server_path_override.exists():
              raise RuntimeError(f"actual capacity fixture llama server path must remain absent: {llama_server_path_override}")
          test_source = '''from pathlib import Path
          import subprocess
          import sys


          APP_ROOT = Path(__file__).resolve().parents[1]


          def test_actual_runner_capacity_guard_refuses_import_before_serving():
              result = subprocess.run(
                  [sys.executable, "-c", "import scripts.server.stack_manifest"],
                  cwd=APP_ROOT,
                  capture_output=True,
                  text=True,
                  timeout=60,
                  check=False,
              )
              output = result.stdout + result.stderr
              assert result.returncode != 0, "actual runner unexpectedly passed serving-capacity import"
              assert "Declared serving_shape lineup does not fit the hardware" in output, output
              assert "device host (CPU RAM) OVERSUBSCRIBED" in output, output
          '''
          with test_path.open("x", encoding="utf-8") as output:
              output.write(test_source)
          context = {
              "schema": "ni10.client_class_capacity_context.v1",
              "phase": "ordinary_actual_runner_capacity_guard",
              "synthetic_ram": False,
              "runner_meminfo": "actual /proc/meminfo through fresh stack_manifest import",
              "kernel_path_override": str(kernel_path_override),
              "kernel_path_intentionally_absent": True,
              "vision_binary_path_override": str(mtmd_path_override),
              "vision_binary_path_intentionally_absent": True,
              "llama_server_path_override": str(llama_server_path_override),
              "llama_server_path_intentionally_absent": True,
              "scope": "one expected refusal before app import or serving",
              "inference": "none; no kernel availability, linkage, or runtime claim",
              "pytest_rootdir": str(Path.cwd()),
              "pytest_junit_prefix": "ni10_actual_capacity_guard",
              "guard_fixture_sha256": hashlib.sha256(test_path.read_bytes()).hexdigest(),
          }
          with Path("ni10_capacity_guard/context.json").open("x", encoding="utf-8") as output:
              output.write(json.dumps(context, sort_keys=True) + "\n")
          PY
          mkdir -p artifacts/ni10-client-class-validation/capacity

      - name: Capture ordinary actual-runner capacity guard
        if: ${{ always() && steps.dependencies.outcome == 'success' && steps.compare.outcome == 'success' && steps.guard_fixture.outcome == 'success' }}
        working-directory: app-ordinary
        run: |
          timeout --verbose --signal=TERM --kill-after=15s 150s \
            python "$GITHUB_WORKSPACE/root-producer/scripts/ci/native_conformance.py" \
              --cwd "$PWD" \
              --junit ni10_capacity_guard/original-pytest.xml \
              --output "$GITHUB_WORKSPACE/$CAPTURE_ROOT/capacity/native" \
              --repo "root_workflow=$GITHUB_WORKSPACE/ci-control" \
              --repo "root_producer=$GITHUB_WORKSPACE/root-producer" \
              --repo "orchestrator_ordinary=$PWD" \
              --read-path "$GITHUB_WORKSPACE/ci-control/.github/workflows/ni10-client-class-validation.yml" \
              --read-path "$GITHUB_WORKSPACE/ci-control/ni10-source-comparison.json" \
              --read-path "$GITHUB_WORKSPACE/root-producer/scripts/ci/native_conformance.py" \
              --read-path "$GITHUB_WORKSPACE/app-ordinary/ni10_capacity_guard/test_actual_capacity_guard.py" \
              --read-path "$GITHUB_WORKSPACE/app-ordinary/ni10_capacity_guard/context.json" \
              --read-path scripts/server/stack_manifest.py \
              --read-path scripts/server/stack_paths.py \
              --read-path src/registry/kernel_paths.py \
              --read-path src/config/models.py \
              --read-path orchestration/model_registry.yaml \
              --read-path orchestration/stack_topology.yaml \
              --read-path pyproject.toml --read-path uv.lock \
              --generated-output ni10_capacity_guard/pytest.log \
              --select 'ni10_capacity_guard/test_actual_capacity_guard.py::test_actual_runner_capacity_guard_refuses_import_before_serving' \
              -- timeout --verbose --signal=TERM --kill-after=10s 90s \
                "$UV_PROJECT_ENVIRONMENT/bin/python" -m pytest -q --noconftest -c /dev/null \
                    --rootdir="$PWD" --junit-prefix=ni10_actual_capacity_guard \
                    ni10_capacity_guard/test_actual_capacity_guard.py \
                    --junitxml=ni10_capacity_guard/original-pytest.xml \
                    --log-file=ni10_capacity_guard/pytest.log
      - name: Upload immutable ordinary capacity prefix
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: ni10-client-class-${{ github.run_id }}-${{ github.run_attempt }}-capacity-prefix
          path: |
            artifacts/ni10-client-class-validation/capacity/native/
            ci-control/ni10-source-comparison.json
            ci-control/.github/workflows/ni10-client-class-validation.yml
            app-ordinary/ni10_capacity_guard/
          if-no-files-found: warn

      - name: Write synthetic client-class fixture context
        if: ${{ always() && steps.dependencies.outcome == 'success' && steps.compare.outcome == 'success' }}
        working-directory: ci-control
        run: |
          python - <<'PY'
          import json
          import os
          from pathlib import Path
          kernel_path_override = Path(os.environ["ORCHESTRATOR_PATHS_LLAMA_CPP_BIN"])
          if kernel_path_override.exists():
              raise RuntimeError(f"synthetic kernel path override must remain absent: {kernel_path_override}")
          mtmd_path_override = Path(os.environ["ORCHESTRATOR_PATHS_LLAMA_MTMD"])
          if mtmd_path_override.exists():
              raise RuntimeError(f"synthetic vision binary path override must remain absent: {mtmd_path_override}")
          llama_server_path_override = Path(os.environ["ORCHESTRATOR_PATHS_LLAMA_SERVER"])
          if llama_server_path_override.exists():
              raise RuntimeError(f"synthetic llama server path override must remain absent: {llama_server_path_override}")
          context = {
              "schema": "ni10.client_class_fixture_context.v1",
              "phase": "explicit_synthetic_bootstrap_route_and_native_record",
              "synthetic_app_sha": "8e0a1d4e8072df6787151abfc21ea9506fc4820c",
              "ordinary_app_sha": "37e3cd507c78dbb76a458282c30b00aafee71706",
              "bootstrap_sha256": "9b1758788336d7d42d55171dbd463762f0a160a0efeb382db701194a3e0d7cda",
              "runner_fact": "declared synthetic 1024 GiB only inside the explicit fixture process",
              "kernel_path_override": str(kernel_path_override),
              "kernel_path_intentionally_absent": True,
              "vision_binary_path_override": str(mtmd_path_override),
              "vision_binary_path_intentionally_absent": True,
              "llama_server_path_override": str(llama_server_path_override),
              "llama_server_path_intentionally_absent": True,
              "selection": "three route tests and one parametrized route-to-native-record test",
              "inference": "none",
              "claim_scope": "selected NI10 request metadata fixtures only",
          }
          with Path("ni10-synthetic-context.json").open("x", encoding="utf-8") as output:
              output.write(json.dumps(context, sort_keys=True) + "\n")
          PY
          test ! -e "$GITHUB_WORKSPACE/$CAPTURE_ROOT/synthetic/native"

      - name: Capture synthetic route-to-native-record fixtures
        if: ${{ always() && steps.dependencies.outcome == 'success' && steps.compare.outcome == 'success' }}
        working-directory: app-synthetic
        run: |
          mkdir -p artifacts/ni10-client-class-validation/synthetic
          timeout --verbose --signal=TERM --kill-after=15s 180s \
            python "$GITHUB_WORKSPACE/root-producer/scripts/ci/native_conformance.py" \
              --cwd "$PWD" \
              --junit artifacts/ni10-client-class-validation/synthetic/original-pytest.xml \
              --output "$GITHUB_WORKSPACE/$CAPTURE_ROOT/synthetic/native" \
              --repo "root_workflow=$GITHUB_WORKSPACE/ci-control" \
              --repo "root_producer=$GITHUB_WORKSPACE/root-producer" \
              --repo "orchestrator_synthetic=$PWD" \
              --repo "orchestrator_ordinary=$GITHUB_WORKSPACE/app-ordinary" \
              --read-path "$GITHUB_WORKSPACE/ci-control/.github/workflows/ni10-client-class-validation.yml" \
              --read-path "$GITHUB_WORKSPACE/ci-control/ni10-source-comparison.json" \
              --read-path "$GITHUB_WORKSPACE/ci-control/ni10-synthetic-context.json" \
              --read-path "$GITHUB_WORKSPACE/root-producer/scripts/ci/native_conformance.py" \
              --read-path tests/fixtures/offhost_unit_bootstrap.py \
              --read-path pyproject.toml --read-path uv.lock \
              --read-path tests/conftest.py --read-path tests/unit/conftest.py \
              --read-path src/api/models/openai.py \
              --read-path src/api/routes/openai_compat.py \
              --read-path src/llm_primitives/inference.py \
              --read-path tests/unit/test_openai_client_tool_mode.py \
              --read-path tests/unit/test_serving_calls.py \
              --read-path scripts/server/stack_manifest.py \
              --read-path scripts/server/stack_paths.py \
              --read-path src/registry/kernel_paths.py \
              --read-path src/config/models.py \
              --read-path orchestration/model_registry.yaml \
              --read-path orchestration/stack_topology.yaml \
              --generated-output artifacts/ni10-client-class-validation/synthetic/pytest.log \
              --select 'tests/unit/test_openai_client_tool_mode.py::test_bad_request_key_values_are_422' \
              --select 'tests/unit/test_openai_client_tool_mode.py::test_explicit_client_class_is_echoed_and_bound_to_trace_keys' \
              --select 'tests/unit/test_openai_client_tool_mode.py::test_keys_are_echoed_in_nonstream_metadata_and_trace' \
              --select 'tests/unit/test_serving_calls.py::test_explicit_client_class_reaches_native_record_without_inference' \
              -- timeout --verbose --signal=TERM --kill-after=10s 120s \
                "$UV_PROJECT_ENVIRONMENT/bin/python" tests/fixtures/offhost_unit_bootstrap.py \
                  -q \
                  tests/unit/test_openai_client_tool_mode.py::test_bad_request_key_values_are_422 \
                  tests/unit/test_openai_client_tool_mode.py::test_explicit_client_class_is_echoed_and_bound_to_trace_keys \
                  tests/unit/test_openai_client_tool_mode.py::test_keys_are_echoed_in_nonstream_metadata_and_trace \
                  tests/unit/test_serving_calls.py::test_explicit_client_class_reaches_native_record_without_inference \
                  --junitxml=artifacts/ni10-client-class-validation/synthetic/original-pytest.xml \
                  --log-file=artifacts/ni10-client-class-validation/synthetic/pytest.log
      - name: Upload immutable synthetic fixture prefix
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: ni10-client-class-${{ github.run_id }}-${{ github.run_attempt }}-synthetic-prefix
          path: |
            artifacts/ni10-client-class-validation/synthetic/native/
            ci-control/ni10-source-comparison.json
            ci-control/ni10-synthetic-context.json
            ci-control/.github/workflows/ni10-client-class-validation.yml
            app-synthetic/artifacts/ni10-client-class-validation/synthetic/
            app-synthetic/tests/fixtures/offhost_unit_bootstrap.py
          if-no-files-found: warn
