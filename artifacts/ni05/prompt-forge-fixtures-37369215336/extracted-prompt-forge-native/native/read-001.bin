name: NI57-58 bounded fixture matrix custody

on:
  push:
    branches:
      - codex/ni57-58-fixture-workflow-20261005
    paths:
      - .github/workflows/ni57-58-fixture-matrix.yml

concurrency:
  group: ni57-58-fixture-matrix-20261005
  cancel-in-progress: false

permissions:
  contents: read

env:
  APP_BASE_SHA: 6bb8d860d410217895efb7806e9ef907a62a4350
  APP_SOURCE_SHA: 774fed8f0894482b5f48004a4ef9a5fdab0bf21f
  APP_SOURCE_PARENT_SHA: 6bb8d860d410217895efb7806e9ef907a62a4350
  APP_LOCK_SHA256: 7eae6b0447832155673e18f0e9f849fd4a65e3eb5839bf85f4165b13a4b06ca3
  ROOT_PRODUCER_SHA: ff8a6baa7e4bc86fc7318055d3fe1050f31422c7
  ROOT_RECIPE_BASE_SHA: 6793d952fa502094b09b5b34bfbf32c5988446a1
  EXPECTED_ROUTING_TEST_SHA256: b15105046ae8a52098f1d1db7b6bdf6b116fd881a4760e843279ade01f2a1480
  EXPECTED_PROMPT_FORGE_TEST_SHA256: 12e4a92989b16d4cba71ae25ae1ed7a80d9213ff6f090e211ddebf88c78718fa
  EXPECTED_ROUTING_SOURCE_SHA256: 0725bcd494cf7889602506c75d0121da388964789c29b63adf7a9bcb3f71b539
  EXPECTED_SAMPLING_SOURCE_SHA256: 08f515e6d670f252a7c81cbc09124c3ca5ef7adc2eef7f2383bb62239ff1f19b
  EXPECTED_PROMPT_FORGE_SOURCE_SHA256: 0ca9176f25e3137f695bf52a2710d8be531f235229a70da7f69b0cba7a232eec
  EXPECTED_PYPROJECT_SHA256: 1d2e9183e25aea8c55e902bebaf2703b9578d974d723fcad7709614a54b00e5b
  EXPECTED_TESTS_CONF_SHA256: 48312d00152f362b340374097e096c5341a6fdbaf9c48573b08fb64143f7b524
  EXPECTED_UNIT_CONF_SHA256: 56cdbb92652bee7155f44a834693281ec364b85abf9210dc6f37b5afa38dddfb

jobs:
  fixture-module:
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    env:
      CI: 'true'
      ORCHESTRATOR_MOCK_MODE: 'true'
      MODULE_ID: ${{ matrix.module_id }}
      MODULE_PATH: ${{ matrix.module_path }}
      EXPECTED_CASES: ${{ matrix.expected_cases }}
    strategy:
      fail-fast: false
      matrix:
        include:
          - module_id: routing-pool
            module_path: tests/unit/test_seed_specialist_routing_main_and_retry.py
            expected_cases: 72
          - module_id: prompt-forge
            module_path: tests/unit/test_td21_27_prompt_forge_extraction.py
            expected_cases: 9
    steps:
      - name: Establish absent dependencies, corpora, and private environment
        shell: bash
        run: |
          set -euo pipefail
          for target in \
            "$RUNNER_TEMP/ni57-58-unavailable-llama-cpp-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-$MODULE_ID" \
            "$RUNNER_TEMP/ni57-58-unavailable-mtmd-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-$MODULE_ID" \
            "$RUNNER_TEMP/ni57-58-unavailable-llama-server-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-$MODULE_ID" \
            "$RUNNER_TEMP/ni57-58-absent-research-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-$MODULE_ID" \
            "$RUNNER_TEMP/ni57-58-absent-eval-pool-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-$MODULE_ID.jsonl"; do
            if [[ -e "$target" || -L "$target" ]]; then
              echo "refusing preexisting kernel override: $target" >&2
              exit 1
            fi
          done
          printf 'ORCHESTRATOR_PATHS_LLAMA_CPP_BIN=%s/ni57-58-unavailable-llama-cpp-%s-%s-%s\n' "$RUNNER_TEMP" "$GITHUB_RUN_ID" "$GITHUB_RUN_ATTEMPT" "$MODULE_ID" >> "$GITHUB_ENV"
          printf 'ORCHESTRATOR_PATHS_LLAMA_MTMD=%s/ni57-58-unavailable-mtmd-%s-%s-%s\n' "$RUNNER_TEMP" "$GITHUB_RUN_ID" "$GITHUB_RUN_ATTEMPT" "$MODULE_ID" >> "$GITHUB_ENV"
          printf 'ORCHESTRATOR_PATHS_LLAMA_SERVER=%s/ni57-58-unavailable-llama-server-%s-%s-%s\n' "$RUNNER_TEMP" "$GITHUB_RUN_ID" "$GITHUB_RUN_ATTEMPT" "$MODULE_ID" >> "$GITHUB_ENV"
          printf 'EPYC_RESEARCH_ROOT=%s/ni57-58-absent-research-%s-%s-%s\n' "$RUNNER_TEMP" "$GITHUB_RUN_ID" "$GITHUB_RUN_ATTEMPT" "$MODULE_ID" >> "$GITHUB_ENV"
          printf 'AUTOPILOT_EVAL_ID_VOCAB_SOURCES=%s/ni57-58-absent-eval-pool-%s-%s-%s.jsonl\n' "$RUNNER_TEMP" "$GITHUB_RUN_ID" "$GITHUB_RUN_ATTEMPT" "$MODULE_ID" >> "$GITHUB_ENV"
          printf 'RECIPE_ROOT=%s/ci-control\n' "$GITHUB_WORKSPACE" >> "$GITHUB_ENV"
          printf 'NATIVE_ROOT=%s/root-producer\n' "$GITHUB_WORKSPACE" >> "$GITHUB_ENV"
          printf 'APP_CHECKOUT=%s/app-fixtures\n' "$GITHUB_WORKSPACE" >> "$GITHUB_ENV"

      - name: Checkout immutable workflow candidate
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          ref: ${{ github.sha }}
          fetch-depth: 2
          path: ci-control
          persist-credentials: false

      - name: Checkout pinned native receipt producer
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          repository: pestopoppa/epyc-root
          ref: ${{ env.ROOT_PRODUCER_SHA }}
          path: root-producer
          persist-credentials: false

      - name: Checkout pinned app fixture candidate
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          repository: pestopoppa/epyc-orchestrator
          ref: ${{ env.APP_SOURCE_SHA }}
          fetch-depth: 4
          path: app-fixtures
          persist-credentials: false

      - name: Verify source ancestry, fixture-only delta, lock, and absent targets
        shell: bash
        run: |
          set -euo pipefail
          test "$(git -C ci-control rev-parse HEAD)" = "$GITHUB_SHA"
          test "$(git -C root-producer rev-parse HEAD)" = "$ROOT_PRODUCER_SHA"
          test "$(git -C app-fixtures rev-parse HEAD)" = "$APP_SOURCE_SHA"
          test -z "$(git -C ci-control status --porcelain --untracked-files=no)"
          test -z "$(git -C root-producer status --porcelain --untracked-files=no)"
          test -z "$(git -C app-fixtures status --porcelain --untracked-files=no)"
          git -C app-fixtures merge-base --is-ancestor "$APP_BASE_SHA" "$APP_SOURCE_SHA"
          test "$(git -C app-fixtures rev-parse "$APP_SOURCE_SHA^")" = "$APP_SOURCE_PARENT_SHA"
          test "$(git -C app-fixtures rev-list --count "$APP_BASE_SHA..$APP_SOURCE_SHA")" = 1
          expected_paths="$(printf '%s\n' \
            tests/unit/test_seed_specialist_routing_main_and_retry.py \
            tests/unit/test_td21_27_prompt_forge_extraction.py | LC_ALL=C sort)"
          actual_paths="$(git -C app-fixtures diff --name-only "$APP_BASE_SHA" "$APP_SOURCE_SHA" | LC_ALL=C sort)"
          test "$actual_paths" = "$expected_paths"
          test "$(sha256sum app-fixtures/uv.lock | cut -d ' ' -f1)" = "$APP_LOCK_SHA256"
          test "$(sha256sum app-fixtures/tests/unit/test_seed_specialist_routing_main_and_retry.py | cut -d ' ' -f1)" = "$EXPECTED_ROUTING_TEST_SHA256"
          test "$(sha256sum app-fixtures/tests/unit/test_td21_27_prompt_forge_extraction.py | cut -d ' ' -f1)" = "$EXPECTED_PROMPT_FORGE_TEST_SHA256"
          test "$(sha256sum app-fixtures/scripts/benchmark/seed_specialist_routing.py | cut -d ' ' -f1)" = "$EXPECTED_ROUTING_SOURCE_SHA256"
          test "$(sha256sum app-fixtures/scripts/benchmark/seeding_sampling.py | cut -d ' ' -f1)" = "$EXPECTED_SAMPLING_SOURCE_SHA256"
          test "$(sha256sum app-fixtures/scripts/autopilot/species/prompt_forge.py | cut -d ' ' -f1)" = "$EXPECTED_PROMPT_FORGE_SOURCE_SHA256"
          test "$(sha256sum app-fixtures/pyproject.toml | cut -d ' ' -f1)" = "$EXPECTED_PYPROJECT_SHA256"
          test "$(sha256sum app-fixtures/tests/conftest.py | cut -d ' ' -f1)" = "$EXPECTED_TESTS_CONF_SHA256"
          test "$(sha256sum app-fixtures/tests/unit/conftest.py | cut -d ' ' -f1)" = "$EXPECTED_UNIT_CONF_SHA256"
          test "$(git -C app-fixtures rev-parse "$APP_SOURCE_SHA:tests/unit/test_seed_specialist_routing_main_and_retry.py")" = ed987da15cd6429c573b368579eb0d667fb26749
          test "$(git -C app-fixtures rev-parse "$APP_SOURCE_SHA:tests/unit/test_td21_27_prompt_forge_extraction.py")" = ea196355fff54192843327752cdf26edcac5d16e
          test "$(git -C app-fixtures rev-parse "$APP_SOURCE_SHA:scripts/benchmark/seed_specialist_routing.py")" = 9b4b607cea00c4a79d7301498c26fa8451c3e163
          test "$(git -C app-fixtures rev-parse "$APP_SOURCE_SHA:scripts/benchmark/seeding_sampling.py")" = bf1b0e57b2a489a083a99c754180fe0fe4dbd76a
          test "$(git -C app-fixtures rev-parse "$APP_SOURCE_SHA:scripts/autopilot/species/prompt_forge.py")" = 7711c700c4146173f17f08c147de27e7f546c067
          test "$(git -C app-fixtures rev-parse "$APP_SOURCE_SHA:tests/conftest.py")" = 3b87111c6bc4ec1f8c8840d204e337e12ae00851
          test "$(git -C app-fixtures rev-parse "$APP_SOURCE_SHA:tests/unit/conftest.py")" = 67752e81242ba51847cfae462b42f21981b9a5ad
          test "$(git -C app-fixtures rev-parse "$APP_SOURCE_SHA:pyproject.toml")" = b4fe6ccada3a1aee3e08aa860045a78d8b85c7b1
          test "$(git -C app-fixtures rev-parse "$APP_SOURCE_SHA:uv.lock")" = ef2306018773ff9a1e80389970d92f66fcf8d5b7
          test "$(git -C ci-control rev-parse HEAD^)" = "$ROOT_RECIPE_BASE_SHA"
          test "$(git -C root-producer rev-parse "$ROOT_PRODUCER_SHA:scripts/ci/native_conformance.py")" = d2d7bd90f86cffa23c51db803288641c5c6fe461
          test "$(git -C root-producer rev-parse "$ROOT_PRODUCER_SHA:scripts/vidya/adapters/ci_conformance.py")" = b5a521ef4debe7ad105830f5fa27bbf9c2168dcd
          test "$(git -C root-producer rev-parse "$ROOT_PRODUCER_SHA:scripts/vidya/claim_tuple.py")" = 309af769e45245fd1452482eb2e0592a86a4a79f
          test "$(git -C root-producer rev-parse "$ROOT_PRODUCER_SHA:scripts/vidya/canonical.py")" = e7c93a39804c3e1cf8107f7801c8c32a23f0b45b
          test "$(git -C root-producer rev-parse "$ROOT_PRODUCER_SHA:scripts/vidya/frames.py")" = 47e485d913271b72c9aaf1d9dfb526294ef0fd14
          test "$(git -C root-producer show "$ROOT_PRODUCER_SHA:scripts/ci/native_conformance.py" | sha256sum | cut -d ' ' -f1)" = 2b8c63121e1472d10849224911ee8f4035b7f758ce1aefca7c766e2de263aa0e
          test "$(git -C root-producer show "$ROOT_PRODUCER_SHA:scripts/vidya/adapters/ci_conformance.py" | sha256sum | cut -d ' ' -f1)" = aceba149c1b3386e2edd0f8ce5b0bd6bb1d4489d0fe3b3275f8984050aeeb19c
          test "$(git -C root-producer show "$ROOT_PRODUCER_SHA:scripts/vidya/claim_tuple.py" | sha256sum | cut -d ' ' -f1)" = 058749d2a1ce3487672e85cc5a18fd352b6f17e741a47d7f48bb55be278f4bfe
          test "$(git -C root-producer show "$ROOT_PRODUCER_SHA:scripts/vidya/canonical.py" | sha256sum | cut -d ' ' -f1)" = cda6809d24382cbbfa80308c9f8df4eca353f458039816753b1c20156adf1434
          test "$(git -C root-producer show "$ROOT_PRODUCER_SHA:scripts/vidya/frames.py" | sha256sum | cut -d ' ' -f1)" = f47f148218ae99d54c51b322bf4f3b0632d4458e49572843f5ed4aa424d15749
          test ! -e "$ORCHESTRATOR_PATHS_LLAMA_CPP_BIN" && test ! -L "$ORCHESTRATOR_PATHS_LLAMA_CPP_BIN"
          test ! -e "$ORCHESTRATOR_PATHS_LLAMA_MTMD" && test ! -L "$ORCHESTRATOR_PATHS_LLAMA_MTMD"
          test ! -e "$ORCHESTRATOR_PATHS_LLAMA_SERVER" && test ! -L "$ORCHESTRATOR_PATHS_LLAMA_SERVER"
          test ! -e "$EPYC_RESEARCH_ROOT" && test ! -L "$EPYC_RESEARCH_ROOT"
          test ! -e "$AUTOPILOT_EVAL_ID_VOCAB_SOURCES" && test ! -L "$AUTOPILOT_EVAL_ID_VOCAB_SOURCES"

      - name: Set up Python 3.11
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: '3.11.14'

      - name: Set up uv
        uses: astral-sh/setup-uv@22695119d769bdb6f7032ad67b9bca0ef8c4a174
        with:
          version: '0.8.15'
          enable-cache: false

      - name: Create private capture directory
        shell: bash
        run: |
          set -euo pipefail
          umask 077
          result_dir="$RUNNER_TEMP/ni57-58-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-$MODULE_ID"
          if [[ -e "$result_dir" || -L "$result_dir" ]]; then
            echo "refusing preexisting capture directory: $result_dir" >&2
            exit 1
          fi
          mkdir -m 700 "$result_dir"
          mkdir -m 700 "$result_dir/tmp" "$result_dir/cache" "$result_dir/cache/uv" "$result_dir/venv"
          for path in "$result_dir" "$result_dir/tmp" "$result_dir/cache" "$result_dir/cache/uv" "$result_dir/venv"; do
            test ! -L "$path"
            test "$(stat -c '%a' "$path")" = 700
            test "$(stat -c '%u' "$path")" = "$(id -u)"
            test "$(stat -c '%g' "$path")" = "$(id -g)"
          done
          printf 'RESULT_DIR=%s\n' "$result_dir" >> "$GITHUB_ENV"
          printf 'UV_PROJECT_ENVIRONMENT=%s/venv\n' "$result_dir" >> "$GITHUB_ENV"
          printf 'RUNNER_PRIVATE_TMP=%s/tmp\n' "$result_dir" >> "$GITHUB_ENV"
          printf 'RUNNER_PRIVATE_CACHE=%s/cache\n' "$result_dir" >> "$GITHUB_ENV"
          printf 'UV_CACHE_DIR=%s/cache/uv\n' "$result_dir" >> "$GITHUB_ENV"

      - name: Install frozen development dependencies
        id: dependencies
        working-directory: app-fixtures
        shell: bash
        run: |
          set -euo pipefail
          umask 077
          test "$(sha256sum uv.lock | cut -d ' ' -f1)" = "$APP_LOCK_SHA256"
          python --version | grep -Fx 'Python 3.11.14'
          uv --version | grep -Fx 'uv 0.8.15'
          set +e
          timeout --verbose --signal=TERM --kill-after=15s 900s uv sync --frozen --extra dev --no-install-project \
            2>&1 | tee "$RESULT_DIR/install.log"
          result=${PIPESTATUS[0]}
          set -e
          python - "$RESULT_DIR/install-status.json" "$result" <<'PY'
          import json
          import subprocess
          import sys
          from pathlib import Path

          target = Path(sys.argv[1])
          target.write_text(json.dumps({
              "schema": "ni57_58.install_status.v1",
              "exit_code": int(sys.argv[2]),
              "python": sys.version,
              "uv": subprocess.check_output(["uv", "--version"], text=True).strip(),
              "lock_sha256": subprocess.check_output(["sha256sum", "uv.lock"], text=True).split()[0],
          }, sort_keys=True) + "\n", encoding="utf-8")
          PY
          exit "$result"

      - name: Upload dependency installation prefix
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: ni57-58-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.module_id }}-install
          path: |
            ${{ runner.temp }}/ni57-58-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.module_id }}/install.log
            ${{ runner.temp }}/ni57-58-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.module_id }}/install-status.json
          if-no-files-found: warn

      - name: Write immutable fixture context
        id: context
        if: ${{ always() && steps.dependencies.outcome == 'success' }}
        working-directory: app-fixtures
        shell: bash
        run: |
          set -euo pipefail
          python - <<'PY'
          import json
          import hashlib
          import os
          import subprocess
          from datetime import datetime, timezone
          import stat
          import sys
          from pathlib import Path

          if sys.version_info[:3] != (3, 11, 14):
              raise SystemExit(f"unexpected Python version: {sys.version}")
          uv_version = subprocess.check_output(["uv", "--version"], text=True).strip()
          if uv_version != "uv 0.8.15":
              raise SystemExit(f"unexpected uv version: {uv_version}")
          lock_after_install = subprocess.check_output(
              ["sha256sum", "uv.lock"], text=True
          ).split()[0]
          if lock_after_install != os.environ["APP_LOCK_SHA256"]:
              raise SystemExit("frozen uv sync changed uv.lock; refusing fixture capture")
          result_root = Path(os.environ["RESULT_DIR"])
          meminfo_bytes = Path("/proc/meminfo").read_bytes()
          meminfo_text = meminfo_bytes.decode("utf-8")
          meminfo_values = {}
          for line in meminfo_text.splitlines():
              key, separator, value = line.partition(":")
              if separator and key in {"MemTotal", "MemAvailable", "SwapTotal", "SwapFree"}:
                  meminfo_values[key] = value.strip()
          if "MemTotal" not in meminfo_values:
              raise SystemExit("runner /proc/meminfo does not contain MemTotal")
          private_paths = [result_root, result_root / "tmp", result_root / "cache",
                           result_root / "cache" / "uv", Path(os.environ["UV_PROJECT_ENVIRONMENT"])]
          private_path_facts = {}
          for private_path in private_paths:
              metadata = private_path.lstat()
              ok = (stat.S_ISDIR(metadata.st_mode) and not stat.S_ISLNK(metadata.st_mode)
                    and stat.S_IMODE(metadata.st_mode) == 0o700
                    and metadata.st_uid == os.getuid() and metadata.st_gid == os.getgid())
              private_path_facts[str(private_path)] = {
                  "mode": oct(stat.S_IMODE(metadata.st_mode)), "uid": metadata.st_uid,
                  "gid": metadata.st_gid, "owned_private_0700": ok,
              }
              if not ok:
                  raise SystemExit(f"private runner path is not owned mode 0700: {private_path}")
          context = {
              "schema": "ni57_58.fixture_matrix_context.v1",
              "phase": "whole_module_fixture_execution",
              "module_id": os.environ["MODULE_ID"],
              "module_path": os.environ["MODULE_PATH"],
              "expected_case_count": int(os.environ["EXPECTED_CASES"]),
              "app_base_sha": os.environ["APP_BASE_SHA"],
              "app_source_sha": os.environ["APP_SOURCE_SHA"],
              "app_source_parent_sha": os.environ["APP_SOURCE_PARENT_SHA"],
              "root_producer_sha": os.environ["ROOT_PRODUCER_SHA"],
              "root_recipe_base_sha": os.environ["ROOT_RECIPE_BASE_SHA"],
              "workflow_candidate_sha": os.environ["GITHUB_SHA"],
              "native_conformance_sha256": "2b8c63121e1472d10849224911ee8f4035b7f758ce1aefca7c766e2de263aa0e",
              "native_conformance_git_blob": "d2d7bd90f86cffa23c51db803288641c5c6fe461",
              "native_adapter_sha256": "aceba149c1b3386e2edd0f8ce5b0bd6bb1d4489d0fe3b3275f8984050aeeb19c",
              "native_adapter_git_blob": "b5a521ef4debe7ad105830f5fa27bbf9c2168dcd",
              "shared_claim_tuple_sha256": "058749d2a1ce3487672e85cc5a18fd352b6f17e741a47d7f48bb55be278f4bfe",
              "shared_claim_tuple_git_blob": "309af769e45245fd1452482eb2e0592a86a4a79f",
              "shared_canonical_git_blob": "e7c93a39804c3e1cf8107f7801c8c32a23f0b45b",
              "shared_canonical_sha256": "cda6809d24382cbbfa80308c9f8df4eca353f458039816753b1c20156adf1434",
              "shared_frames_git_blob": "47e485d913271b72c9aaf1d9dfb526294ef0fd14",
              "shared_frames_sha256": "f47f148218ae99d54c51b322bf4f3b0632d4458e49572843f5ed4aa424d15749",
              "lock_sha256_before_install": os.environ["APP_LOCK_SHA256"],
              "lock_sha256_after_install": lock_after_install,
              "install_log_sha256": hashlib.sha256((result_root / "install.log").read_bytes()).hexdigest(),
              "install_status_sha256": hashlib.sha256((result_root / "install-status.json").read_bytes()).hexdigest(),
              "source_pins": {
                  "tests/unit/test_seed_specialist_routing_main_and_retry.py": {
                      "git_blob": "ed987da15cd6429c573b368579eb0d667fb26749",
                      "sha256": os.environ["EXPECTED_ROUTING_TEST_SHA256"],
                  },
                  "tests/unit/test_td21_27_prompt_forge_extraction.py": {
                      "git_blob": "ea196355fff54192843327752cdf26edcac5d16e",
                      "sha256": os.environ["EXPECTED_PROMPT_FORGE_TEST_SHA256"],
                  },
                  "scripts/benchmark/seed_specialist_routing.py": {
                      "git_blob": "9b4b607cea00c4a79d7301498c26fa8451c3e163",
                      "sha256": os.environ["EXPECTED_ROUTING_SOURCE_SHA256"],
                  },
                  "scripts/benchmark/seeding_sampling.py": {
                      "git_blob": "bf1b0e57b2a489a083a99c754180fe0fe4dbd76a",
                      "sha256": os.environ["EXPECTED_SAMPLING_SOURCE_SHA256"],
                  },
                  "scripts/autopilot/species/prompt_forge.py": {
                      "git_blob": "7711c700c4146173f17f08c147de27e7f546c067",
                      "sha256": os.environ["EXPECTED_PROMPT_FORGE_SOURCE_SHA256"],
                  },
                  "tests/conftest.py": {
                      "git_blob": "3b87111c6bc4ec1f8c8840d204e337e12ae00851",
                      "sha256": "48312d00152f362b340374097e096c5341a6fdbaf9c48573b08fb64143f7b524",
                  },
                  "tests/unit/conftest.py": {
                      "git_blob": "67752e81242ba51847cfae462b42f21981b9a5ad",
                      "sha256": "56cdbb92652bee7155f44a834693281ec364b85abf9210dc6f37b5afa38dddfb",
                  },
                  "pyproject.toml": {
                      "git_blob": "b4fe6ccada3a1aee3e08aa860045a78d8b85c7b1",
                      "sha256": os.environ["EXPECTED_PYPROJECT_SHA256"],
                  },
                  "uv.lock": {
                      "git_blob": "ef2306018773ff9a1e80389970d92f66fcf8d5b7",
                      "sha256": os.environ["APP_LOCK_SHA256"],
                  },
              },
              "frozen_original_module_outcomes": {
                  "routing-pool": {
                      "outcome": "FALSE",
                      "collected": 72,
                      "passed": 71,
                      "failure": 1,
                      "receipt_sha256": "06428d1d4c108cb04bd3164bf906b080b9b37fb86dfff90df04a31bb92a00feb",
                      "junit_sha256": "104184025d9c5347ab7a45ceea67fcd627d7a5a0d83f231238299ae2230c455f",
                  },
                  "prompt-forge": {
                      "outcome": "FALSE",
                      "collected": 9,
                      "passed": 8,
                      "failure": 1,
                      "receipt_sha256": "54aa7f27ce212685d3d37982f1f52b58e0a76c0ffc2fdd98eb89dc56de70a20e",
                      "junit_sha256": "158b3f4fe6b2f14f7142dcaa1539572c6ddadd34d0d5f6744773c7ce2e400f0f",
                  },
              },
              "python": sys.version,
              "uv": uv_version,
              "runner_meminfo": {
                  "source": "/proc/meminfo",
                  "captured_utc_before_test_execution": datetime.now(timezone.utc).isoformat(),
                  "raw_sha256": hashlib.sha256(meminfo_bytes).hexdigest(),
                  "raw_text": meminfo_text,
                  "selected_fields": meminfo_values,
                  "claim_scope": "actual ephemeral CI runner context only; no capacity assertion",
              },
              "private_path_facts": private_path_facts,
              "pytest_guard": {
                  "CI": os.environ["CI"],
                  "ORCHESTRATOR_MOCK_MODE": os.environ["ORCHESTRATOR_MOCK_MODE"],
                  "tests_conftest_100GiB_guard": "bypassed by declared CI/mock fixture mode",
                  "capacity_proof": "none; no synthetic RAM and no host-capacity claim",
              },
              "kernel_overrides": {
                  key: {"path": os.environ[key], "must_remain_absent_nonlink": True}
                  for key in (
                      "ORCHESTRATOR_PATHS_LLAMA_CPP_BIN",
                      "ORCHESTRATOR_PATHS_LLAMA_MTMD",
                      "ORCHESTRATOR_PATHS_LLAMA_SERVER",
                  )
              },
              "absent_external_inputs": {
                  "research_root": os.environ["EPYC_RESEARCH_ROOT"],
                  "prompt_forge_eval_pool": os.environ["AUTOPILOT_EVAL_ID_VOCAB_SOURCES"],
              },
              "offline_controls_by_module": {
                  "routing-pool": [
                      "test_main_question_ids_missing_file_exits",
                      "test_main_question_ids_invalid_json_shape_exits",
                      "test_main_question_ids_empty_lookup_exits",
                  ],
                  "prompt-forge": [
                      "test_propose_mutation_marks_extraction_failure_explicitly",
                      "test_no_fence_at_all_is_a_typed_failure_not_silent",
                      "test_propose_code_mutation_marks_extraction_failure_explicitly",
                  ],
              },
              "fixture_scope": {
                  "routing-pool": "empty research loader is mocked through path-bound seam; stale bare-import module raises; no corpus read",
                  "prompt-forge": "one synthetic row is injected through existing vocabulary seam; generation remains mocked; real leakage guard remains active",
              },
              "test_process_environment": {
                  "construction": "env -i explicit allowlist",
                  "allowlist": ["PATH", "TMPDIR", "XDG_CACHE_HOME", "CI", "ORCHESTRATOR_MOCK_MODE",
                      "MODULE_ID", "MODULE_PATH", "EXPECTED_CASES", "RESULT_DIR", "UV_PROJECT_ENVIRONMENT",
                      "ORCHESTRATOR_PATHS_LLAMA_CPP_BIN", "ORCHESTRATOR_PATHS_LLAMA_MTMD",
                      "ORCHESTRATOR_PATHS_LLAMA_SERVER", "EPYC_RESEARCH_ROOT",
                      "AUTOPILOT_EVAL_ID_VOCAB_SOURCES", "PYTHONUNBUFFERED", "PYTHONNOUSERSITE"],
                  "provider_secrets": "not inherited by child test process",
                  "home_override": False,
              },
              "execution_scope": "whole selected modules only; offline fixtures; no host data, corpus, inference, serving, or production promotion",
              "exclusions": ["capacity proof", "inference", "performance", "kernel linkage", "production promotion", "live research corpus"],
          }
          path = Path(os.environ["RESULT_DIR"]) / "context.json"
          path.write_text(json.dumps(context, sort_keys=True) + "\n", encoding="utf-8")
          PY

      - name: Capture whole selected module with native producer
        id: capture
        if: ${{ always() && steps.dependencies.outcome == 'success' && steps.context.outcome == 'success' }}
        working-directory: app-fixtures
        shell: bash
        run: |
          set -euo pipefail
          junit="$RESULT_DIR/original-pytest.xml"
          native="$RESULT_DIR/native"
          timeout --verbose --signal=TERM --kill-after=20s 600s \
            python "$GITHUB_WORKSPACE/root-producer/scripts/ci/native_conformance.py" \
              --cwd "$PWD" \
              --junit "$junit" \
              --output "$native" \
              --repo "root_workflow=$GITHUB_WORKSPACE/ci-control" \
              --repo "root_producer=$GITHUB_WORKSPACE/root-producer" \
              --repo "orchestrator_candidate=$PWD" \
              --read-path "$GITHUB_WORKSPACE/ci-control/.github/workflows/ni57-58-fixture-matrix.yml" \
              --read-path "$GITHUB_WORKSPACE/root-producer/scripts/ci/native_conformance.py" \
              --read-path "$GITHUB_WORKSPACE/root-producer/scripts/vidya/adapters/__init__.py" \
              --read-path "$GITHUB_WORKSPACE/root-producer/scripts/vidya/adapters/ci_conformance.py" \
              --read-path "$GITHUB_WORKSPACE/root-producer/scripts/vidya/claim_tuple.py" \
              --read-path "$GITHUB_WORKSPACE/root-producer/scripts/vidya/canonical.py" \
              --read-path "$GITHUB_WORKSPACE/root-producer/scripts/vidya/frames.py" \
              --read-path "$RESULT_DIR/install.log" \
              --read-path "$RESULT_DIR/install-status.json" \
              --read-path "$RESULT_DIR/context.json" \
              --read-path tests/conftest.py \
              --read-path tests/unit/conftest.py \
              --read-path tests/unit/test_seed_specialist_routing_main_and_retry.py \
              --read-path tests/unit/test_td21_27_prompt_forge_extraction.py \
              --read-path scripts/benchmark/seed_specialist_routing.py \
              --read-path scripts/benchmark/seed_specialist_routing_v2.py \
              --read-path scripts/benchmark/seeding_sampling.py \
              --read-path scripts/benchmark/seeding_types.py \
              --read-path scripts/benchmark/seeding_rewards.py \
              --read-path scripts/benchmark/seeding_infra.py \
              --read-path scripts/benchmark/seeding_checkpoint.py \
              --read-path scripts/benchmark/seeding_scoring.py \
              --read-path scripts/benchmark/seeding_orchestrator.py \
              --read-path scripts/benchmark/seeding_injection.py \
              --read-path scripts/benchmark/seeding_eval.py \
              --read-path scripts/benchmark/seeding_legacy.py \
              --read-path scripts/benchmark/seeding_cli_config.py \
              --read-path scripts/benchmark/seeding_telemetry.py \
              --read-path scripts/autopilot/species/__init__.py \
              --read-path scripts/autopilot/species/seeder.py \
              --read-path scripts/autopilot/species/numeric_swarm.py \
              --read-path scripts/autopilot/species/structural_lab.py \
              --read-path scripts/autopilot/species/evolution_manager.py \
              --read-path scripts/autopilot/species/env_synth/__init__.py \
              --read-path scripts/autopilot/species/env_synth/etd_agent.py \
              --read-path scripts/autopilot/species/env_synth/boundary_contract.py \
              --read-path scripts/autopilot/species/env_synth/task_synthesizer.py \
              --read-path scripts/autopilot/species/env_synth/verifier_builder.py \
              --read-path scripts/autopilot/species/env_synth/mcp_tool_registry.py \
              --read-path scripts/autopilot/species/env_synth/species.py \
              --read-path scripts/autopilot/species/env_synth/gap_diagnosis.py \
              --read-path scripts/autopilot/species/env_synth/eval_integration.py \
              --read-path scripts/autopilot/species/prompt_forge.py \
              --read-path src/__init__.py \
              --read-path src/autopilot_core/__init__.py \
              --read-path src/autopilot_core/action_identity.py \
              --read-path src/autopilot_core/journal_reconstruction.py \
              --read-path src/autopilot_core/learning_exclusions.py \
              --read-path src/autopilot_core/multitier_decision.py \
              --read-path src/autopilot_core/pareto_math.py \
              --read-path src/autopilot_core/rlvr_tiers.py \
              --read-path src/autopilot_core/sequential_verdict.py \
              --read-path src/autopilot_core/tier_specs.py \
              --read-path src/roles.py \
              --read-path src/autopilot_core/measurement_guards.py \
              --read-path orchestration/repl_memory/__init__.py \
              --read-path orchestration/repl_memory/episodic_store.py \
              --read-path orchestration/repl_memory/embedder.py \
              --read-path orchestration/repl_memory/retriever.py \
              --read-path orchestration/repl_memory/progress_logger.py \
              --read-path orchestration/repl_memory/q_scorer.py \
              --read-path orchestration/repl_memory/memory_record.py \
              --read-path orchestration/model_registry.yaml \
              --read-path pyproject.toml \
              --read-path uv.lock \
              --select "$MODULE_PATH" \
              -- bash -c '
                set -euo pipefail
                timeout --verbose --signal=TERM --kill-after=15s 240s env -i \
                  PATH="$UV_PROJECT_ENVIRONMENT/bin:/usr/local/bin:/usr/bin:/bin" \
                  TMPDIR="$RUNNER_PRIVATE_TMP" XDG_CACHE_HOME="$RUNNER_PRIVATE_CACHE" \
                  CI=true ORCHESTRATOR_MOCK_MODE=true MODULE_ID="$MODULE_ID" \
                  MODULE_PATH="$MODULE_PATH" EXPECTED_CASES="$EXPECTED_CASES" \
                  RESULT_DIR="$RESULT_DIR" UV_PROJECT_ENVIRONMENT="$UV_PROJECT_ENVIRONMENT" \
                  ORCHESTRATOR_PATHS_LLAMA_CPP_BIN="$ORCHESTRATOR_PATHS_LLAMA_CPP_BIN" \
                  ORCHESTRATOR_PATHS_LLAMA_MTMD="$ORCHESTRATOR_PATHS_LLAMA_MTMD" \
                  ORCHESTRATOR_PATHS_LLAMA_SERVER="$ORCHESTRATOR_PATHS_LLAMA_SERVER" \
                  EPYC_RESEARCH_ROOT="$EPYC_RESEARCH_ROOT" \
                  AUTOPILOT_EVAL_ID_VOCAB_SOURCES="$AUTOPILOT_EVAL_ID_VOCAB_SOURCES" \
                  PYTHONUNBUFFERED=1 PYTHONNOUSERSITE=1 \
                  "$UV_PROJECT_ENVIRONMENT/bin/python" -m pytest -q -p no:cacheprovider \
                    --basetemp="$RESULT_DIR/pytest-tmp" --rootdir="$PWD" \
                    --junit-prefix="ni57_58_${MODULE_ID//-/_}" \
                    "$MODULE_PATH" --junitxml="$RESULT_DIR/original-pytest.xml" \
                    > "$RESULT_DIR/pytest.stdout" 2> "$RESULT_DIR/pytest.stderr"
              '

      - name: Upload original native module prefix
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: ni57-58-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.module_id }}-native
          path: |
            ${{ runner.temp }}/ni57-58-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.module_id }}/context.json
            ${{ runner.temp }}/ni57-58-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.module_id }}/original-pytest.xml
            ${{ runner.temp }}/ni57-58-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.module_id }}/pytest.stdout
            ${{ runner.temp }}/ni57-58-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.module_id }}/pytest.stderr
            ${{ runner.temp }}/ni57-58-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.module_id }}/native/
          if-no-files-found: warn

      - name: Verify trusted receipt, whole-module counts, and custody
        if: always()
        working-directory: app-fixtures
        shell: bash
        run: |
          set -euo pipefail
          umask 077
          python - "$RESULT_DIR/native/receipt.json" "$RESULT_DIR/postcheck.json" \
            > "$RESULT_DIR/postcheck.stdout" 2> "$RESULT_DIR/postcheck.stderr" <<'PY'
          import hashlib
          import json
          import os
          from pathlib import Path
          import stat
          import subprocess
          import sys
          root = Path(os.environ["NATIVE_ROOT"])
          sys.path.insert(0, str(root))
          from scripts.ci.native_conformance import read_receipt
          from scripts.vidya.adapters.ci_conformance import native_rows, project_ci_conformance
          from claim_tuple import grade
          receipt_path, post_path = map(Path, sys.argv[1:])
          if not receipt_path.is_file():
              post_path.write_text(json.dumps({"schema": "ni57_58.postcheck.v1",
                  "diagnostic": "native receipt missing"}, sort_keys=True, indent=2) + "\n")
              raise SystemExit("native receipt missing")
          record, receipt_digest = read_receipt(receipt_path)
          rows = native_rows(receipt_path)
          if len(rows) != 1:
              raise SystemExit("trusted adapter did not produce exactly one row")
          claim = project_ci_conformance(rows[0])
          grade_q, grade_t, grade_reasons = grade(claim)
          expected = int(os.environ["EXPECTED_CASES"])
          counts = (record.get("summary") or {}).get("counts", {})
          exact_counts = counts == {"collected": expected, "executed": expected,
              "passed": expected, "failure": 0, "error": 0, "skipped": 0}
          if os.environ["MODULE_ID"] == "routing-pool":
              expected_controls = {"test_main_question_ids_missing_file_exits",
                  "test_main_question_ids_invalid_json_shape_exits", "test_main_question_ids_empty_lookup_exits"}
          else:
              expected_controls = {"test_propose_mutation_marks_extraction_failure_explicitly",
                  "test_no_fence_at_all_is_a_typed_failure_not_silent",
                  "test_propose_code_mutation_marks_extraction_failure_explicitly"}
          cases = (record.get("summary") or {}).get("cases", [])
          passing_controls = {item["name"] for item in cases if item.get("status") == "passed"}
          controls_present_and_passing = expected_controls <= passing_controls
          expected_repos = {"root_workflow": os.environ["GITHUB_SHA"],
              "root_producer": os.environ["ROOT_PRODUCER_SHA"],
              "orchestrator_candidate": os.environ["APP_SOURCE_SHA"]}
          repo_pins_exact = record.get("repositories") == expected_repos
          selection_exact = record.get("selections") == [os.environ["MODULE_PATH"]]
          readset_names = {item.get("name") for item in record.get("readset", [])}
          result_dir = Path(os.environ["RESULT_DIR"])
          required_readset = {str(result_dir / name) for name in
              ("install.log", "install-status.json", "context.json")}
          required_readset |= {str(Path(os.environ["APP_CHECKOUT"]) / name) for name in
              ("tests/conftest.py", "tests/unit/conftest.py", "pyproject.toml", "uv.lock",
               os.environ["MODULE_PATH"])}
          readset_complete = required_readset <= readset_names
          private_paths = [result_dir, result_dir / "tmp", result_dir / "cache",
              result_dir / "cache" / "uv", Path(os.environ["UV_PROJECT_ENVIRONMENT"])]
          private_facts = {}
          for path in private_paths:
              info = path.lstat()
              private_facts[str(path)] = {"mode": oct(stat.S_IMODE(info.st_mode)),
                  "uid": info.st_uid, "gid": info.st_gid}
          private = all(path.is_dir() and not path.is_symlink()
              and stat.S_IMODE(path.lstat().st_mode) == 0o700
              and path.lstat().st_uid == os.getuid() and path.lstat().st_gid == os.getgid()
              for path in private_paths)
          absent_targets = [os.environ[key] for key in ("ORCHESTRATOR_PATHS_LLAMA_CPP_BIN",
              "ORCHESTRATOR_PATHS_LLAMA_MTMD", "ORCHESTRATOR_PATHS_LLAMA_SERVER",
              "EPYC_RESEARCH_ROOT", "AUTOPILOT_EVAL_ID_VOCAB_SOURCES")]
          absent = all(not Path(value).exists() and not Path(value).is_symlink() for value in absent_targets)
          install_status = json.loads((result_dir / "install-status.json").read_text(encoding="utf-8"))
          install_log_sha = hashlib.sha256((result_dir / "install.log").read_bytes()).hexdigest()
          install_status_sha = hashlib.sha256((result_dir / "install-status.json").read_bytes()).hexdigest()
          install_bound = (install_status.get("exit_code") == 0
              and install_status_sha == json.loads((result_dir / "context.json").read_text())["install_status_sha256"]
              and install_log_sha == json.loads((result_dir / "context.json").read_text())["install_log_sha256"])
          app = Path(os.environ["APP_CHECKOUT"])
          lock_sha = hashlib.sha256((app / "uv.lock").read_bytes()).hexdigest()
          pyproject_sha = hashlib.sha256((app / "pyproject.toml").read_bytes()).hexdigest()
          locks_pinned = lock_sha == os.environ["APP_LOCK_SHA256"]
          pyproject_pinned = pyproject_sha == os.environ["EXPECTED_PYPROJECT_SHA256"]
          source_clean = not subprocess.check_output(["git", "-C", str(app), "status", "--porcelain"], text=True).strip()
          recipe_clean = not subprocess.check_output(["git", "-C", os.environ["RECIPE_ROOT"], "status", "--porcelain"], text=True).strip()
          producer_clean = not subprocess.check_output(["git", "-C", os.environ["NATIVE_ROOT"], "status", "--porcelain"], text=True).strip()
          stdout_stderr = [result_dir / "pytest.stdout", result_dir / "pytest.stderr"]
          logs_present = all(path.is_file() and not path.is_symlink() for path in stdout_stderr)
          log_hashes = {path.name: hashlib.sha256(path.read_bytes()).hexdigest() for path in stdout_stderr} if logs_present else {}
          python_version = subprocess.check_output(["python", "--version"], text=True).strip()
          uv_version = subprocess.check_output(["uv", "--version"], text=True).strip()
          checks = {"native_true": record.get("fixture_execution_conformant") is True,
              "native_exit_zero": record.get("exit_code") == 0, "exact_full_module_counts": exact_counts,
              "selection_exact": selection_exact, "repo_pins_exact": repo_pins_exact,
              "shared_grade_judged_located": (grade_q, grade_t) == ("Judged", "Located"),
              "refusal_controls_collected_passing": controls_present_and_passing,
              "native_readset_includes_install_and_test_inputs": readset_complete,
              "private_owned_0700_paths": private, "all_declared_absences_hold": absent,
              "install_status_and_log_bound": install_bound, "lock_pinned": locks_pinned,
              "pyproject_pinned": pyproject_pinned, "tested_source_clean": source_clean,
              "recipe_clean": recipe_clean, "producer_clean": producer_clean,
              "original_stdout_stderr_present": logs_present,
              "python_pin": python_version == "Python 3.11.14", "uv_pin": uv_version == "uv 0.8.15"}
          result = {"schema": "ni57_58.postcheck.v1", "module_id": os.environ["MODULE_ID"],
              "receipt_sha256": receipt_digest, "native_exit_code": record.get("exit_code"),
              "observed_counts": counts, "expected_counts": {"collected": expected,
              "executed": expected, "passed": expected, "failure": 0, "error": 0, "skipped": 0},
              "selections": record.get("selections"), "repositories": record.get("repositories"),
              "shared_grade": {"Q": grade_q, "T": grade_t, "reasons": grade_reasons},
              "passing_refusal_controls": sorted(expected_controls & passing_controls),
              "native_readset_names": sorted(x for x in readset_names if x),
              "private_path_facts": private_facts, "install_log_sha256": install_log_sha,
              "install_status_sha256": install_status_sha, "stdout_stderr_sha256": log_hashes,
              "tested_source_clean": source_clean, "checks": checks}
          post_path.write_text(json.dumps(result, sort_keys=True, indent=2) + "\n", encoding="utf-8")
          if not all(checks.values()):
              raise SystemExit("native receipt or a post-run custody check failed")
          PY

      - name: Upload post-capture custody checks
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: ni57-58-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.module_id }}-postcheck
          path: |
            ${{ runner.temp }}/ni57-58-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.module_id }}/postcheck.json
            ${{ runner.temp }}/ni57-58-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.module_id }}/postcheck.stdout
            ${{ runner.temp }}/ni57-58-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.module_id }}/postcheck.stderr
          if-no-files-found: warn
