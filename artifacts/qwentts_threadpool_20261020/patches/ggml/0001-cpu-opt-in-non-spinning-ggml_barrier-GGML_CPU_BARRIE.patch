From 1310f48782b8a3d47d886bd201fc7d25c8d181f2 Mon Sep 17 00:00:00 2001
From: pestopoppa <72076821+pestopoppa@users.noreply.github.com>
Date: Tue, 20 Oct 2026 20:13:25 +0000
Subject: [PATCH 1/2] cpu: opt-in non-spinning ggml_barrier
 (GGML_CPU_BARRIER=spin|yield|futex, GGML_CPU_BARRIER_SPIN)

Default stays the stock pure _mm_pause spin. yield/futex spin a bounded budget then back off so a
core-sharing neighbour can run the descheduled pool thread.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/ggml-cpu/ggml-cpu.c | 100 +++++++++++++++++++++++++++++++++++++++-
 1 file changed, 98 insertions(+), 2 deletions(-)

diff --git a/src/ggml-cpu/ggml-cpu.c b/src/ggml-cpu/ggml-cpu.c
index 75d45016..b52a29f6 100644
--- a/src/ggml-cpu/ggml-cpu.c
+++ b/src/ggml-cpu/ggml-cpu.c
@@ -490,6 +490,11 @@ struct ggml_threadpool {
     atomic_int GGML_CACHE_ALIGN n_barrier_passed;
     atomic_int GGML_CACHE_ALIGN current_chunk; // currently processing chunk during Mat_Mul, shared between all the threads.
 
+    // barrier wait policy (see ggml_barrier). Read-only after pool creation, except n_barrier_sleepers.
+    int        barrier_mode;          // GGML_BARRIER_{SPIN,YIELD,FUTEX}
+    int        barrier_spin;          // _mm_pause iterations spent spinning before backing off (YIELD/FUTEX)
+    atomic_int GGML_CACHE_ALIGN n_barrier_sleepers; // threads currently parked in a futex wait on n_barrier_passed
+
     // these are atomic as an annotation for thread-sanitizer
     atomic_bool stop;         // Used for stopping the threadpool altogether
     atomic_bool pause;        // Used for pausing the threadpool or individual threads
@@ -572,6 +577,77 @@ struct ggml_state {
 
 static struct ggml_state g_state = {0};
 
+// ---------------------------------------------------------------------------
+// Barrier wait policy.
+//
+// Stock ggml spins on n_barrier_passed with _mm_pause forever (GGML_BARRIER_SPIN). When another
+// runnable task shares a core with one of the pool threads, the descheduled thread cannot reach
+// the barrier until its scheduler slice comes back, and every other thread burns its own core
+// waiting: on a loaded host an 8-thread pool measured ~100x slower per op than 1 thread.
+//
+//   GGML_CPU_BARRIER=spin   stock behaviour, pure _mm_pause spin (default until validated)
+//   GGML_CPU_BARRIER=yield  spin GGML_CPU_BARRIER_SPIN iterations, then sched_yield() between re-checks
+//   GGML_CPU_BARRIER=futex  spin GGML_CPU_BARRIER_SPIN iterations, then park in a futex wait on
+//                           n_barrier_passed; the last arriving thread wakes sleepers (Linux only,
+//                           falls back to yield elsewhere)
+//   GGML_CPU_BARRIER_SPIN=N spin budget in _mm_pause iterations (default 2000, i.e. a few tens of us
+//                           on Zen; the uncontended barrier wait is far shorter, so the fast path is
+//                           the same load/pause loop as stock, plus one counter compare per iteration)
+// ---------------------------------------------------------------------------
+enum { GGML_BARRIER_SPIN = 0, GGML_BARRIER_YIELD = 1, GGML_BARRIER_FUTEX = 2 };
+#define GGML_BARRIER_SPIN_DEFAULT 2000
+
+static void ggml_barrier_policy_from_env(int * mode, int * spin) {
+    *mode = GGML_BARRIER_SPIN;
+    *spin = GGML_BARRIER_SPIN_DEFAULT;
+    const char * m = getenv("GGML_CPU_BARRIER");
+    if (m) {
+        if      (strcmp(m, "yield") == 0) { *mode = GGML_BARRIER_YIELD; }
+        else if (strcmp(m, "futex") == 0) {
+#if defined(__linux__)
+            *mode = GGML_BARRIER_FUTEX;
+#else
+            *mode = GGML_BARRIER_YIELD;
+#endif
+        }
+    }
+    const char * n = getenv("GGML_CPU_BARRIER_SPIN");
+    if (n) {
+        long v = strtol(n, NULL, 10);
+        if (v > 0 && v < INT_MAX) { *spin = (int) v; }
+    }
+}
+
+#if defined(__linux__)
+#include <linux/futex.h>
+static inline void ggml_futex_wait(atomic_int * addr, int expected) {
+    syscall(SYS_futex, (int *) addr, FUTEX_WAIT_PRIVATE, expected, NULL, NULL, 0);
+}
+static inline void ggml_futex_wake_all(atomic_int * addr) {
+    syscall(SYS_futex, (int *) addr, FUTEX_WAKE_PRIVATE, INT_MAX, NULL, NULL, 0);
+}
+#endif
+
+// slow path of the barrier wait: called after the spin budget is exhausted
+static void ggml_barrier_backoff(struct ggml_threadpool * tp, int n_passed) {
+#if defined(__linux__)
+    if (tp->barrier_mode == GGML_BARRIER_FUTEX) {
+        // Dekker pairing with the last thread: it bumps n_barrier_passed (seq_cst) and then reads
+        // n_barrier_sleepers (seq_cst); we bump n_barrier_sleepers (seq_cst) and futex_wait only
+        // if n_barrier_passed is still the value we saw. Either the wait returns immediately
+        // or the last thread sees us and wakes us.
+        atomic_fetch_add_explicit(&tp->n_barrier_sleepers, 1, memory_order_seq_cst);
+        if (atomic_load_explicit(&tp->n_barrier_passed, memory_order_seq_cst) == n_passed) {
+            ggml_futex_wait(&tp->n_barrier_passed, n_passed);
+        }
+        atomic_fetch_sub_explicit(&tp->n_barrier_sleepers, 1, memory_order_seq_cst);
+        return;
+    }
+#endif
+    GGML_UNUSED(n_passed);
+    sched_yield();
+}
+
 void ggml_barrier(struct ggml_threadpool * tp) {
     int n_threads = atomic_load_explicit(&tp->n_graph, memory_order_relaxed) & GGML_THREADPOOL_N_THREADS_MASK;
     if (n_threads == 1) {
@@ -592,12 +668,30 @@ void ggml_barrier(struct ggml_threadpool * tp) {
 
         // exit barrier (full seq-cst fence)
         atomic_fetch_add_explicit(&tp->n_barrier_passed, 1, memory_order_seq_cst);
+#if defined(__linux__)
+        if (tp->barrier_mode == GGML_BARRIER_FUTEX &&
+            atomic_load_explicit(&tp->n_barrier_sleepers, memory_order_seq_cst) > 0) {
+            ggml_futex_wake_all(&tp->n_barrier_passed);
+        }
+#endif
         return;
     }
 
     // wait for other threads
-    while (atomic_load_explicit(&tp->n_barrier_passed, memory_order_relaxed) == n_passed) {
-        ggml_thread_cpu_relax();
+    if (tp->barrier_mode == GGML_BARRIER_SPIN) {
+        while (atomic_load_explicit(&tp->n_barrier_passed, memory_order_relaxed) == n_passed) {
+            ggml_thread_cpu_relax();
+        }
+    } else {
+        const int spin = tp->barrier_spin;
+        int i = 0;
+        while (atomic_load_explicit(&tp->n_barrier_passed, memory_order_relaxed) == n_passed) {
+            ggml_thread_cpu_relax();
+            if (++i >= spin) {
+                ggml_barrier_backoff(tp, n_passed);
+                i = 0;
+            }
+        }
     }
 
     // exit barrier (full seq-cst fence)
@@ -3339,6 +3433,8 @@ static struct ggml_threadpool * ggml_threadpool_new_impl(
         threadpool->poll             = tpp->poll;
         threadpool->prio             = tpp->prio;
         threadpool->ec               = GGML_STATUS_SUCCESS;
+        threadpool->n_barrier_sleepers = 0;
+        ggml_barrier_policy_from_env(&threadpool->barrier_mode, &threadpool->barrier_spin);
     }
 
     // Allocate and init workers state
-- 
