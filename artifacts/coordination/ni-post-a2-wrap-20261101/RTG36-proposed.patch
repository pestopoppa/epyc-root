+def stack_prior_default_launched(record: dict[str, Any]) -> bool:
+    """Whether a default ``start`` launches the role represented by this record.
+
+    WARM roles remain ``live_stack`` (declared and routable once started), but do
+    not count as expected after default start. Older artifacts fall back to tier.
+    """
+    serving = record.get("serving") if isinstance(record, dict) else None
+    if not isinstance(serving, dict):
+        return False
+    flag = serving.get("default_launch")
+    if isinstance(flag, bool):
+        return flag
+    return serving.get("tier") != "warm"
+
+
+def live_stack_default_launch_role_records(
+    path: Path = DEFAULT_OUTPUT,
+) -> dict[str, dict[str, Any]]:
+    """Live stack role records whose serving process starts by default."""
+    return {
+        role: record
+        for role, record in live_stack_role_records(path).items()
+        if stack_prior_default_launched(record)
+    }
+
