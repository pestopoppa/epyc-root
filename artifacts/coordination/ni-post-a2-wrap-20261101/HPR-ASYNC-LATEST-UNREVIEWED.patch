+#!/usr/bin/env python3
+"""Unapplied native-v3 async CPU qualifier supervisor entry point."""
+from __future__ import annotations
+import argparse,fcntl,hashlib,importlib.util,json,os,sys,time,traceback
+from pathlib import Path
+
+def qualifier_command(region_lock,qualifier,manifest,flags,nonce,pair,task_id,timeout):
+ # This is the same cross-role region-lock namespace used by canonical
+ # filler_run14 ordinary CPU jobs. Its WS58_QUAL branch tasksets the row but
+ # skips filler_run14's normal run_one region-lock wrapper, so qualification
+ # must hold the shared region lock around q.run itself.
+ return [str(region_lock),'run','--cpu-list',str(pair),'--role','build',
+         '--timeout-s',str(timeout),'--tag','async-qual-'+str(task_id),'--',
+         sys.executable,'-B',str(qualifier),'run','--manifest',str(manifest),
+         '--flags',str(flags),'--nonce',str(nonce),'--timeout',str(timeout)]
+
+def atomic(path,obj):
+ path=Path(path);tmp=path.with_name(path.name+'.tmp.'+str(os.getpid()))
+ tmp.write_text(json.dumps(obj,sort_keys=True,indent=2)+'\n')
+ with tmp.open('rb') as f:os.fsync(f.fileno())
+ os.replace(tmp,path)
+
+def finish_terminal(state_path,rec):
+ lock=state_path.with_name(state_path.stem+'.lock')
+ with lock.open('a+') as fd:
+  fcntl.flock(fd,fcntl.LOCK_EX)
+  current=json.loads(state_path.read_text())
+  if current.get('status')=='terminal-fail':return current
+  owner=current.get('owner') or {}
+  try:birth=int(Path(f'/proc/{os.getpid()}/stat').read_text().rsplit(') ',1)[1].split()[19])
+  except (OSError,ValueError,IndexError):return current
+  if owner.get('supervisor_pid')!=os.getpid() or owner.get('supervisor_birth_ticks')!=birth:return current
+  if rec.get('status')=='terminal-pass' and time.time()>=current.get('deadline_epoch',0):
+   rec.update(status='terminal-fail',reason='hard deadline elapsed before durable pass',cleanup_verified=True)
+  current.update({k:v for k,v in rec.items() if k not in ('owner','manifest_sha256','fixture_sha256','source_manifest_sha256','resource_pair','deadline_epoch','task_id','schema')})
+  atomic(state_path,current)
+  return current
+
+def main(argv=None):
+ p=argparse.ArgumentParser()
+ for name in ('manifest','flags','qualifier','nonce','pair','region-lock','state','active-state','pair-lock'):
+  p.add_argument('--'+name,required=True)
+ p.add_argument('--deadline',type=float,required=True);p.add_argument('--lock-fd',type=int,required=True);p.add_argument('--gate-fd',type=int,required=True)
+ a=p.parse_args(argv);manifest=Path(a.manifest);flags=Path(a.flags);state_path=Path(a.state);active=Path(a.active_state);lock_path=Path(a.pair_lock)
+ try:
+  fdstat=os.fstat(a.lock_fd);pathstat=lock_path.stat()
+  if (fdstat.st_dev,fdstat.st_ino)!=(pathstat.st_dev,pathstat.st_ino):raise RuntimeError('inherited pair lock inode changed')
