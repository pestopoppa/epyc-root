+#!/usr/bin/env python3
+"""Unapplied v3 helper: hold launcher before execution until owner state is durable."""
+from __future__ import annotations
+import os,sys
+
+def main(argv=None):
+ argv=sys.argv[1:] if argv is None else argv
+ if len(argv)!=2:return 64
+ try:fd=int(argv[0]);launcher=argv[1]
+ except (TypeError,ValueError):return 64
+ try:
+  token=os.read(fd,1)
+ finally:
+  try:os.close(fd)
+  except OSError:pass
+ if token!=b'G':return 75
+ os.execv('/bin/bash',['/bin/bash',launcher])
+ return 127
+if __name__=='__main__':raise SystemExit(main())
