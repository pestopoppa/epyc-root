+ if type(pid) is not int or pid<=0 or type(birth) is not int or birth<=0:return 'unknown'
+ path=Path(f'/proc/{pid}')
+ try:
+  raw=path.joinpath('stat').read_text()
+ except FileNotFoundError:return 'gone'
+ except OSError:return 'unknown'
+ try:
+  row=raw.rsplit(') ',1)[1].split()
