+def _live(pid,birth):
+ try:
+  row=Path(f'/proc/{pid}/stat').read_text().rsplit(') ',1)[1].split()
+  return int(row[19])==birth and row[0] not in ('Z','X','x') and int(row[2])==pid and int(row[3])==pid and Path(f'/proc/{pid}').stat().st_uid==os.getuid()
+ except (OSError,ValueError,IndexError):return False
