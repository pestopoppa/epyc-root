+import pathlib,tempfile,unittest
+import sys
+sys.path.insert(0,str(pathlib.Path(__file__).resolve().parent/'fixtures/r22-custody'))
+import custody_guard as g
+class Tests(unittest.TestCase):
+ def test_exact_legacy_whitespace_and_duplicates(self):
+  with tempfile.TemporaryDirectory() as d:
+   p=pathlib.Path(d)/'FILLERS.md'
+   for ident in (g.OLD_ID,g.PREVIOUS_V2_ID):
+    def row(state,space='  '):return '|'+space+' | '.join([ident]+['-']*6+[state]+['-']*10)+' |\n'
+    for state in ('RUNNING','BACKLOG','ARMED'):
+     p.write_text(row(state))
+     with self.assertRaises(g.Refused):g.check_retired_registry_row(p,ident)
+    p.write_text(row('WITHDRAWN'));g.check_retired_registry_row(p,ident)
+    p.write_text(row('WITHDRAWN')+row('WITHDRAWN'))
+    with self.assertRaises(g.Refused):g.check_retired_registry_row(p,ident)
+    p.write_text('| '+ident+' | bad |\n')
+    with self.assertRaises(g.Refused):g.check_retired_registry_row(p,ident)
+    p.write_text('| unrelated |\n');g.check_retired_registry_row(p,ident)
+ def test_prior_v3_staged_artifacts_fail_closed(self):
+  from unittest.mock import patch
+  with tempfile.TemporaryDirectory() as d:
+   root=pathlib.Path(d)
+   with patch.object(g,'PRIOR_V3_ROOT',root/'prior'):
+    (root/'prior').mkdir()
+    for name in ('full','custody','qualification'):
+     x=root/'prior'/name;x.mkdir()
+     with self.assertRaisesRegex(g.Refused,'prior v3'):g.no_previous_v2(root,commands=[])
+     x.rmdir()
+if __name__=='__main__':unittest.main()
