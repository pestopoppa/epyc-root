+def parse(stdout, stderr, *, parallel, prompt, generation, flash_attn):
+    rows = []
+    for line in (stdout + '\n' + stderr).splitlines():
+        try:
+            item = json.loads(line.strip())
+        except (ValueError, TypeError):
+            continue
+        if isinstance(item, dict) and (item.get('pl'), item.get('pp'), item.get('tg')) == (parallel, prompt, generation):
+            rows.append(item)
+    if len(rows) != 1:
+        raise ValueError('expected exactly one matching native JSON row')
+    row = rows[0]
+    expected = {'n_gpu_layers': 99, 'flash_attn': flash_attn, 'n_threads': 8, 'n_threads_batch': 8, 'n_kv_max': 2048, 'n_batch': 512, 'n_ubatch': 512, 'is_pp_shared': 0, 'n_kv': parallel * (prompt + generation)}
+    if any(row.get(key) != value for key, value in expected.items()):
+        raise ValueError('unexpected native execution geometry')
+    for key in ('speed_tg', 't_tg'):
+        v = row.get(key)
+        if isinstance(v, bool) or not isinstance(v, (float, int)) or not math.isfinite(v) or v <= 0:
+            raise ValueError('invalid ' + key)
+    return row
