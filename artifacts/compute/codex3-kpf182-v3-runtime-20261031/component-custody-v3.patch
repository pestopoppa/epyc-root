+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+extern "C" void kpf182_sha256_hash(unsigned char * out, const unsigned char * data, size_t size);
+inline std::string kpf182_digest(const std::vector<uint8_t> & bytes) {
+    unsigned char digest[32];
+    kpf182_sha256_hash(digest, bytes.data(), bytes.size());
+    static constexpr char hex[] = "0123456789abcdef";
+    std::string out(64, '0');
+    for (size_t i = 0; i < 32; ++i) { out[2*i] = hex[digest[i] >> 4]; out[2*i+1] = hex[digest[i] & 15]; }
+    return out;
+}
