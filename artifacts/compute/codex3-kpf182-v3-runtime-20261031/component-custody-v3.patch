+#pragma once
+
+// Internal, read-only diagnostic. Intervals describe metadata membership only:
+// they are not tensor validity, a prefix-hit count, or a clause-2 minimum.
+#include "llama-kv-cells.h"
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+enum class kpf182_coverage_status { unsupported, invalid_sequence, pending_shift, full_cells, windowed_cells };
+enum class kpf182_cache_kind { unknown, ordinary, base, swa };
+struct kpf182_interval { int64_t begin; int64_t end; }; // half-open
+struct kpf182_coverage {
+    kpf182_coverage_status status = kpf182_coverage_status::unsupported;
+    kpf182_cache_kind cache = kpf182_cache_kind::unknown;
+    std::vector<kpf182_interval> intervals;
+    bool duplicate_positions = false;
+    bool interior_holes = false;
+};
+
+inline kpf182_coverage kpf182_inspect_cells(const llama_kv_cells & cells, llama_seq_id seq, bool windowed) {
+    kpf182_coverage result;
+    if (seq < 0 || seq >= LLAMA_MAX_SEQ) {
+        result.status = kpf182_coverage_status::invalid_sequence;
+        return result;
+    }
+    if (cells.get_has_shift()) {
+        result.status = kpf182_coverage_status::pending_shift;
+        return result;
+    }
+    std::vector<llama_pos> positions;
+    for (uint32_t i = 0; i < cells.size(); ++i) {
+        if (cells.seq_has(i, seq)) {
+            if (cells.is_empty(i) || cells.pos_get(i) < 0) return result;
+            positions.push_back(cells.pos_get(i));
+        }
+    }
+    std::sort(positions.begin(), positions.end());
+    for (auto pos : positions) {
+        const int64_t p = pos;
+        if (!result.intervals.empty() && p < result.intervals.back().end) {
+            result.duplicate_positions = true;
+        } else if (!result.intervals.empty() && p == result.intervals.back().end) {
+            ++result.intervals.back().end;
+        } else {
+            result.intervals.push_back({p, p + 1});
+        }
+    }
+    result.interior_holes = result.intervals.size() > 1;
+    result.status = windowed ? kpf182_coverage_status::windowed_cells : kpf182_coverage_status::full_cells;
+    return result;
+}
+
+// Recurrent cell positions are boundary metadata, not evidence of token-prefix coverage.
+enum class kpf182_recurrent_status { unsupported, invalid_sequence, observed, inconsistent };
+struct kpf182_recurrent_observation {
+    kpf182_recurrent_status status = kpf182_recurrent_status::unsupported;
+    std::vector<llama_pos> positions;
+};
+template<class Cell>
+kpf182_recurrent_observation kpf182_inspect_recurrent(const std::vector<Cell> & cells, llama_seq_id seq) {
+    kpf182_recurrent_observation result;
+    if (seq < 0 || seq >= LLAMA_MAX_SEQ) { result.status = kpf182_recurrent_status::invalid_sequence; return result; }
+    for (const auto & cell : cells) {
+        if (cell.has_seq_id(seq)) {
+            if (cell.pos < 0) { result.positions.clear(); result.status = kpf182_recurrent_status::inconsistent; return result; }
+            result.positions.push_back(cell.pos);
+        }
+    }
+    std::sort(result.positions.begin(), result.positions.end());
+    result.status = kpf182_recurrent_status::observed;
+    return result;
+}
