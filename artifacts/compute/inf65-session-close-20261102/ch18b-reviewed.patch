+++ b/tools/server/server-swa-reuse.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <cstddef>
+#include <vector>
+
+// A snapshot is armed only after a successful cold text prefill and is consumed
+// at the next task. Matching endpoints alone say nothing about token provenance.
+template<class Token, class OldTokens, class NewTokens>
+bool server_swa_prefix_matches(const std::vector<Token> & snapshot,
+                               const OldTokens & old_tokens, const NewTokens & new_tokens,
+                               size_t n) {
+    if (n == 0 || snapshot.size() < n || old_tokens.size() < n || new_tokens.size() < n) {
+        return false;
+    }
+    for (size_t i = 0; i < n; ++i) {
+        if (snapshot[i] != old_tokens[i] || snapshot[i] != new_tokens[i]) {
+            return false;
+        }
+    }
+    return true;
+}
+
+struct server_swa_reuse_gates {
+    bool standard_window;
+    bool shift_disabled;
+    bool no_draft_or_speculation;
+    bool text_only;
+    bool no_adapters;
+    bool unshared_task;
+    bool no_chunk_reuse;
+    bool unit_positions;
+    bool nonempty_prior;
+    bool matching_provenance;
+    bool native_coverage_and_removal;
+};
+
+inline bool server_swa_reuse_allowed(const server_swa_reuse_gates & g) {
+    return g.standard_window && g.shift_disabled && g.no_draft_or_speculation &&
+           g.text_only && g.no_adapters && g.unshared_task && g.no_chunk_reuse &&
+           g.unit_positions && g.nonempty_prior && g.matching_provenance &&
+           g.native_coverage_and_removal;
+}
