+#include "src/llama-kv-cells.h"
+#include <cassert>
+#include <cstdio>
+
+int main() {
+    llama_kv_cells c;
+    c.resize(10);
+    for (int i = 0; i < 6; ++i) { c.pos_set(i, i); c.seq_add(i, 0); }
+    assert(c.seq_pos_covers_unique(0, 0, 6));
+    assert(c.seq_pos_covers_unique(0, 2, 5));
+    assert(c.seq_pos_covers_unique(0, 0, 0));
+    assert(!c.seq_pos_covers_unique(0, -1, 1));
+    assert(!c.seq_pos_covers_unique(0, 4, 3));
+    assert(!c.seq_pos_covers_unique(-1, 0, 1));
+    assert(!c.seq_pos_covers_unique(LLAMA_MAX_SEQ, 0, 1));
+    assert(!c.seq_pos_covers_unique(1, 0, 1));
+    assert(!c.seq_pos_covers_unique(0, 0, 7));
+    c.seq_add(0, 1);
+    assert(c.seq_pos_covers_unique(1, 0, 1));
+    assert(!c.seq_pos_covers_unique(1, 0, 2));
+    c.seq_rm(2, 0);
+    assert(c.seq_pos_min(0) == 0 && c.seq_pos_max(0) == 5);
+    assert(!c.seq_pos_covers_unique(0, 0, 6));
+    c.pos_set(6, 1); c.seq_add(6, 0);
+    assert(!c.seq_pos_covers_unique(0, 0, 2));
+    assert(c.seq_pos_covers_unique(0, 3, 6));
+    c.seq_rm(6, 0);
+    assert(c.seq_pos_covers_unique(0, 0, 2));
+    puts("CH-18.b occupancy controls passed");
+}
