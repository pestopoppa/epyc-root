+
+// A checkpoint can only describe tokens in the pre-restore shared prefix.
+// Position and token counts may differ for multimodal input.
+template<class Position, class Count>
+inline bool server_checkpoint_within_prefix(Position checkpoint_pos_max, Position pos_next,
+                                            Count checkpoint_tokens, Count prefix_tokens) {
+    return checkpoint_pos_max <= pos_next && checkpoint_tokens >= 0 && checkpoint_tokens <= prefix_tokens;
+}
