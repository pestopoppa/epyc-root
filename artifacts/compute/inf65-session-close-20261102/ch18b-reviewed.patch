+    assert(!server_swa_prefix_matches(snapshot, wrong, same, 4));
+    assert(!server_swa_prefix_matches(snapshot, old, same, 5));
+    assert(!server_swa_prefix_matches(snapshot, old, shortv, 3));
+    assert(!server_swa_prefix_matches(snapshot, old, same, 0));
