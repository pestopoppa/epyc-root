+mint_receipt_index() {
+    # C39 keyed receipt-index contract (2026-08-11): the coordinator-daemon's
+    # spent-gate check stats exactly artifacts/operator/receipts/<TOKEN>.json;
+    # a signature without this index is invisible to it. Idempotent to match
+    # mint_receipt: verify-if-present, write-if-absent, atomic rename.
+    local index_dir="$ROOT/artifacts/operator/receipts"
+    local index="$index_dir/$TOKEN.json"
+    if [[ -e "$index" ]]; then
+        grep -q '"status": "ratified"' "$index" ||
+            fail "existing receipt index is malformed: $index"
+        return
+    fi
+    mkdir -p -- "$index_dir"
+    local tmp
+    tmp="$(mktemp "${index}.tmp.XXXXXX")"
+    trap 'rm -f -- "$tmp"' RETURN
+    printf '{\n  "gate_id": "%s",\n  "indexed_by": "attest",\n  "receipt": "%s",\n  "schema_version": "session_bus.receipt_index.v1",\n  "status": "ratified"\n}\n' "$TOKEN" "$RECEIPT" > "$tmp"
+    mv -- "$tmp" "$index"
+}
