From ca0beb4bf7007206b84bbabaa5629b2d0a1b04af Mon Sep 17 00:00:00 2001
From: pestopoppa <72076821+pestopoppa@users.noreply.github.com>
Date: Thu, 22 Oct 2026 19:40:19 +0000
Subject: [PATCH 2/2] launch_affinity: record operator decision D1 (refuse on a
 stray thread, no warn mode)

STACKCHG-GPUPIN-20261022, operator 2026-10-22: D1 = REFUSE the launch when a task
still escapes the declared placement after re-pin. The gate already refused;
this records the decision in the code and adds a test that no flag or env
downgrades it to a warning.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 scripts/server/launch_affinity.py    |  3 ++-
 scripts/server/orchestrator_stack.py |  4 ++++
 tests/unit/test_launch_affinity.py   | 12 ++++++++++++
 3 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/scripts/server/launch_affinity.py b/scripts/server/launch_affinity.py
index 4dfd62de..5839ef8b 100644
--- a/scripts/server/launch_affinity.py
+++ b/scripts/server/launch_affinity.py
@@ -281,7 +281,8 @@ def enforce_launch_affinity(
     declared no placement) and for a pid that is not a direct child of this
     launcher (it is never touched: prove OUR pid before acting on it -- a recycled
     pid or a test double must not get another process re-pinned). Otherwise the
-    PinResult; the caller treats ``not result.ok`` as a failed launch.
+    PinResult; the caller treats ``not result.ok`` as a failed launch (operator
+    decision D1, 2026-10-22: refuse, no warn-only mode).
 
     The spawn is ``taskset -c ... [numactl ...] llama-server``: both wrappers
     exec, so the Popen pid IS the server and its parent is this launcher.
diff --git a/scripts/server/orchestrator_stack.py b/scripts/server/orchestrator_stack.py
index 3f77aad1..c02d0408 100644
--- a/scripts/server/orchestrator_stack.py
+++ b/scripts/server/orchestrator_stack.py
@@ -1873,6 +1873,10 @@ def _post_health_affinity_gate(
     placement. An unpinned spawn, or a pid that is not this launcher's child, is
     never touched (returns True). Read by `status` again later
     (stack_commands -> launch_affinity.affinity_attestation_warnings).
+
+    OPERATOR DECISION D1 (STACKCHG-GPUPIN-20261022, 2026-10-22): REFUSE. There is
+    deliberately no warn-only mode, flag or env override: a launch that cannot hold
+    its declared placement does not come up.
     """
     try:
         result = enforce_launch_affinity(pid, spawn_prefix, label=label)
diff --git a/tests/unit/test_launch_affinity.py b/tests/unit/test_launch_affinity.py
index 12275b35..6923c95b 100644
--- a/tests/unit/test_launch_affinity.py
+++ b/tests/unit/test_launch_affinity.py
@@ -350,3 +350,15 @@ def test_aux_launch_source_applies_env_and_gate():
     assert "apply_pinned_launch_env(env, spawn_prefix)" in src
     assert "_post_health_affinity_gate(" in src
     assert src.index("apply_pinned_launch_env") < src.index("subprocess.Popen")
+
