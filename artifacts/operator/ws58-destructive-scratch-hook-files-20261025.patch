+#!/bin/bash
+set -euo pipefail
+# Test for scripts/hooks/check_destructive_scratch.sh (origin: 2026-10-20 E2 purge, NIB2-108).
+# Cases are generated by destructive_scratch_cases.py with the dangerous strings assembled
+# from pieces, so running this under Claude Code is not blocked by the hook it tests.
+# Fixtures live under a mktemp dir that is removed on exit.
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+HOOK="$HERE/../check_destructive_scratch.sh"
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+FAKE="$TMP/fakeroot"
+mkdir -p "$FAKE/full/sub" "$FAKE/empty"
+RT="shutil"".rmtree"
+printf 'import %s\nRT=%s\n%s("/mnt/raid0/llm/.trash/b1")\n' shutil "x" "$RT" > "$TMP/purge_batch.py"
+printf 'print("hello")\n' > "$TMP/harmless.py"
+
+python3 "$HERE/destructive_scratch_cases.py" "$TMP" "$FAKE" > "$TMP/cases.json"
+N=$(python3 -c 'import json,sys; print(len(json.load(open(sys.argv[1]))))' "$TMP/cases.json")
+PASS=0; FAIL=0
+for ((i=0; i<N; i++)); do
+  python3 - "$TMP/cases.json" "$i" "$TMP" <<'PY'
+import json, sys
+c = json.load(open(sys.argv[1]))[int(sys.argv[2])]
+d = sys.argv[3]
+open(f"{d}/in", "w").write(c["raw"] if "raw" in c else json.dumps(c["input"]))
+open(f"{d}/meta", "w").write(c["name"] + "\n" + c["expect"] + "\n" + "\n".join(f"{k}={v}" for k, v in c["env"].items()) + "\n")
+PY
+  NAME=$(sed -n 1p "$TMP/meta"); EXPECT=$(sed -n 2p "$TMP/meta")
+  ENVARGS=(); while IFS= read -r l; do [[ -n "$l" ]] && ENVARGS+=("$l"); done < <(sed -n '3,$p' "$TMP/meta")
+  set +e
+  env -u EPYC_ALLOW_SCRATCH_DELETE -u EPYC_DESTRUCTIVE_SCRATCH_ROOTS "${ENVARGS[@]}" bash "$HOOK" < "$TMP/in" > /dev/null 2> "$TMP/err"
+  RC=$?
+  set -e
+  GOT=allow; [[ $RC -eq 2 ]] && GOT=block
