new file mode 100644
index 00000000..4dd32180
--- /dev/null
+++ b/scripts/voice/speech_layouts.yaml
@@ -0,0 +1,32 @@
+# Measured CPU layouts for the speech aux services (whisper.cpp STT :9000, qwentts.cpp TTS :9002).
+#
+# ACCEPTANCE RULE (operator, 2026-09-24): a layout may be declared in
+# orchestration/launch_manifest.yaml aux_services only if it was measured SAFE with the
+# CPU frontdoor IDLE: solo (STT: healthy 3/3 in the encoder matrix) or, when both speech
+# servers are declared, as a CONCURRENT pair. tests/unit/test_aux_service_env.py enforces it.
+#
+# FRONTDOOR-CONTENTION CAVEAT (measured, not a rule of this file): every core in 0-95 is in
+# the CPU frontdoor's -t 96 set. With a frontdoor generation running, STT RTF went to 1.5-2.9,
+# TTS RTF to 7.8-9.4 and the frontdoor to 0.3-7.4 tok/s. Voice turns must therefore reason on
+# the GPU (architect_general); that routing is the voice pipeline's requirement.
+#
+# Evidence: epyc-inference-research artifacts/speech_cpu_realtime_20260924/
+#   (README.md; raw/whisper_bench_encoder_matrix.txt; raw/concurrent*.stdout)
+stt_solo_ok:            # whisper-server -t N under taskset -c CPUSET, healthy 3/3, frontdoor idle
