+"""Pure parts of the DAR-LAT-3h gate driver: argv rewrite, env arms, decision rule."""
+
+from __future__ import annotations
+
+import pytest
+
+from scripts.server import critic_thread_gate as g
+
+LIVE = ["/k/llama-server", "-m", "/m.gguf", "--port", "8074", "-np", "1", "-t", "96",
+        "--slot-save-path", "/cache/architect_critic", "--mlock"]
+
+
+def test_rewrite_changes_only_threads_and_port_and_drops_slot_dir() -> None:
+    out = g.rewrite_argv(LIVE, 48)
+    assert out == ["/k/llama-server", "-m", "/m.gguf", "--port", "18074", "-np", "1", "-t", "48", "--mlock"]
+
+
+def test_rewrite_refuses_argv_without_threads() -> None:
+    with pytest.raises(ValueError):
+        g.rewrite_argv(["/k/llama-server", "--port", "8074"], 48)
+
+
+def test_arm_env_adds_recipe_knobs_only_for_recipe_arms() -> None:
+    live = {"OMP_PLACES": "cores", "GGML_IQK": "1", "GGML_FA_SPLIT_KV": "1"}
+    assert g.arm_env(live, "L") == {"OMP_PLACES": "cores", "GGML_IQK": "1"}
+    assert g.arm_env(live, "R48") == {"OMP_PLACES": "cores", "GGML_IQK": "1", **g.RECIPE_ENV}
+
+
+def test_schedule_is_balanced() -> None:
+    assert sorted(g.SCHEDULE) == sorted(["L", "R96", "R48"] * 4)
+    for block in range(4):
+        assert sorted(g.SCHEDULE[block * 3:block * 3 + 3]) == ["L", "R48", "R96"]
+
+
+def _stats(wall: float, ttft: float, coherent: int = 24) -> dict:
+    return {"wall_s_median": wall, "ttft_ms_median": ttft, "coherent": coherent, "decode_tps_tokw": 30.0}
+
+
+def _arms(live: float, r96: float, r48: float, ttft48: float = 100.0) -> dict:
+    return {"L": [_stats(live, 100)] * 4, "R96": [_stats(r96, 100)] * 4, "R48": [_stats(r48, ttft48)] * 4}
+
+
+def test_r48_wins_at_parity() -> None:
+    assert g.decide(_arms(10.0, 10.0, 10.25))["outcome"] == "R48"
+
+
+def test_r48_loses_on_wall_time_then_r96() -> None:
+    assert g.decide(_arms(10.0, 10.0, 10.5))["outcome"] == "R96"
+
+
+def test_r48_loses_on_ttft() -> None:
+    assert g.decide(_arms(10.0, 10.0, 10.0, ttft48=115.0))["outcome"] == "R96"
+
+
+def test_everything_loses_keeps_live() -> None:
+    assert g.decide(_arms(10.0, 10.5, 10.5))["outcome"] == "L"
+
+
+def test_too_few_launches_is_inconclusive() -> None:
+    arms = _arms(10.0, 10.0, 10.0)
+    arms["R48"] = arms["R48"][:2]
+    assert g.decide(arms)["outcome"] == "INCONCLUSIVE"
+
+
+def test_coherence_regression_blocks() -> None:
+    arms = _arms(10.0, 10.0, 9.0)
+    arms["R48"] = [_stats(9.0, 100, coherent=20)] * 4
+    assert g.decide(arms)["outcome"] == "R96"
+
+
+def test_coherent_classifier() -> None:
+    assert g.coherent("The plan fails because step two assumes the cache is warm.", "stop")
+    assert not g.coherent("", "stop")
+    assert not g.coherent("a b c d " * 50, "length")
