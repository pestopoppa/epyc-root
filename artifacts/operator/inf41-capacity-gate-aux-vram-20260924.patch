diff --git a/tests/unit/test_aux_gpu_capacity_visibility.py b/tests/unit/test_aux_gpu_capacity_visibility.py
new file mode 100644
index 00000000..e99ac5de
--- /dev/null
+++ b/tests/unit/test_aux_gpu_capacity_visibility.py
@@ -0,0 +1,99 @@
+"""The GPU capacity gate must see VRAM held by GPU aux_services (whisper, tts).
+
+Found 2026-08-02, closed 2026-09-24 (INF-41 S-11/S-12). `whisper` (STT,
+whisper.cpp large-v3-turbo, HIP/gfx90a) and `tts` (qwentts.cpp, Qwen3-TTS
+12Hz-0.6B) are BOTH GPU-resident, always-on aux_services — never
+`role_launch_meta` x `NUMA_CONFIG` roles — so `serving_shape_instances()`
+structurally could not enumerate them and `serving_shape_capacity_report()`
+could PASS a lineup that, together with these two services, does not actually
+fit the 64 GiB MI210. Measured 2026-09-22 from live
+`/sys/class/kfd/kfd/proc/<pid>/vram_57300` DURING the serving stack: whisper
+2,210,533,376 B = 2.06 GiB, qwentts 2,815,950,848 B = 2.62 GiB, total 4.68 GiB
+(epyc-inference-research orchestration/model_registry.yaml,
+server_mode.architect_general.serving_shape comment).
+
+The fix: `AuxService.vram_gib` (declared per aux service in
+`launch_manifest.yaml`) is summed by `aux_gpu_reserved_gib()` and folded into
+`vram_fit`'s `headroom_gib` by `serving_shape_capacity_report()`. These tests
+pin the two measured figures and prove the report actually uses them, rather
+than asserting a headroom_gib that could pass with either summed in or left
+out.
+"""
+
+from __future__ import annotations
+
+import importlib
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT))
+sys.path.insert(0, str(ROOT / "scripts" / "server"))
+
+
+@pytest.fixture(scope="module")
+def sm():
+    return importlib.import_module("stack_manifest")
+
+
+def test_whisper_and_tts_declare_the_measured_vram(sm) -> None:
+    """Regression guard for the two measured 2026-09-22 figures, not estimates."""
+    whisper = sm.AUX_SERVICES["whisper"]
+    tts = sm.AUX_SERVICES["tts"]
+    assert whisper.vram_gib == pytest.approx(2.06)
+    assert tts.vram_gib == pytest.approx(2.62)
+
+
+def test_aux_gpu_reserved_gib_sums_only_gpu_resident_services(sm) -> None:
+    """document_formalizer/sd_server declare no `vram_gib` and must not count."""
+    total = sm.aux_gpu_reserved_gib()
+    assert total == pytest.approx(4.68)
+    for name in ("document_formalizer", "sd_server"):
+        assert sm.AUX_SERVICES[name].vram_gib is None
+
+
+def test_capacity_report_headroom_includes_the_aux_reservation(sm) -> None:
+    """The GPU leg's headroom must be the BASE headroom plus the aux reservation,
+    never just one of the two — that disjunction is exactly how the blind spot
+    shipped the first time (a headroom that silently covered only one figure).
+    """
+    from src.scheduling.device_model import vram_headroom_gib
+
+    report = sm.serving_shape_capacity_report()
+    gpu = report["gpu"]
+    assert gpu["aux_gpu_reserved_gib"] == pytest.approx(4.68)
+    expected_headroom = vram_headroom_gib() + 4.68
+    assert gpu["fit"].headroom_gib == pytest.approx(expected_headroom)
+    # Sanity: the declared lineup must still fit WITH the reservation counted —
+    # if this ever flips to False, that is real news about the fleet, not a
+    # test to relax.
+    assert gpu["fit"].ok is True
+
+
+def test_removing_the_aux_reservation_would_have_hidden_headroom(sm) -> None:
+    """Proves the fix actually changes the number, not just that a field exists.
+
+    Calls `device_model.vram_fit` directly with `headroom_gib` held at the base
+    value only, mirroring what `serving_shape_capacity_report()` computed BEFORE
+    this fix, and asserts the reported budget was more optimistic by exactly the
+    aux reservation.
+    """
+    from src.scheduling.device_model import vram_fit, vram_headroom_gib
+
+    rows = sm.serving_shape_instances()
+    gpu_rows = [row for row in rows if row["on_gpu"]]
+    synthetic_server_mode = {
+        row["role"]: {"vram_gib": round(float(row["vram_non_kv_gib"]) + row["kv_gib"], 4)}
+        for row in gpu_rows
+    }
+
+    fixed_report = sm.serving_shape_capacity_report()
+    pre_fix_fit = vram_fit(
+        [row["role"] for row in gpu_rows],
+        priors={},
+        server_mode=synthetic_server_mode,
+        headroom_gib=vram_headroom_gib(),
+    )
+    assert pre_fix_fit.budget_gib - fixed_report["gpu"]["fit"].budget_gib == pytest.approx(4.68)
