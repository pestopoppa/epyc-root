+import pytest
+from beam_memory_retrievers import TraceHybridPairChunkRetriever, TraceRetrieverUnavailable
+
+
+class Provider:
+    identity = {'model':'fake-v1', 'index':'fixture-v1', 'similarity':'cosine', 'normalization':'unit'}
+    def __init__(self):
+        self.built = {}
+        self.answer = []
+    def build(self, cid, rows):
+        self.built[cid] = rows
+    def search(self, question, cid, limit):
+        if isinstance(self.answer, Exception):
+            raise self.answer
+        return self.answer
+
+
+@pytest.fixture
+def fixture(tmp_path):
+    p = Provider()
+    r = TraceHybridPairChunkRetriever({'a':['alpha apple','beta banana','gamma grape'], 'b':['other']},
+        vector_provider=p, candidate_depth=3, db_dir=tmp_path,
+        orchestrator_root='/mnt/raid0/llm/epyc-orchestrator')
+    return r, p
+
+
+def test_overlap_vector_only_and_empty_query(fixture):
+    r,p=fixture
+    rows=p.built['a']
+    p.answer=[{'id':rows[2]['id'],'source_line':2}, {'id':rows[0]['id'],'source_line':0}]
+    assert r.search('alpha',conversation_id='a',top_k=1) == [0]
+    assert r.search('alpha',conversation_id='a',top_k=2) == [0,2]
+    assert r.search('?',conversation_id='a',top_k=1) == [2]
+    assert r.search('alpha',conversation_id='a',top_k=0) == []
+
+
+def test_reject_bad_or_foreign_candidates(fixture):
+    r,p=fixture
+    row=p.built['a'][0]; foreign=p.built['b'][0]
+    cases=[[{'id':foreign['id'],'source_line':0}],
+           [{'id':row['id'],'source_line':1}],
+           [{'id':row['id'],'source_line':0}]*2,
+           [{'id':999999,'source_line':0}], [{'id':True,'source_line':0}]]
+    for candidates in cases:
+        p.answer=candidates
+        with pytest.raises(TraceRetrieverUnavailable):
+            r.search('alpha', conversation_id='a', top_k=2)
+    p.answer=RuntimeError('provider failure')
+    with pytest.raises(RuntimeError,match='provider failure'):
+        r.search('alpha', conversation_id='a', top_k=2)
+
+
+def test_identity_and_empty_data(tmp_path):
+    p=Provider(); p.identity={}
+    with pytest.raises(ValueError,match='provider must declare'):
+        TraceHybridPairChunkRetriever({},vector_provider=p,candidate_depth=1,db_dir=tmp_path)
+    p=Provider()
+    r=TraceHybridPairChunkRetriever({'a':[]},vector_provider=p,candidate_depth=1,db_dir=tmp_path,
+        orchestrator_root='/mnt/raid0/llm/epyc-orchestrator')
+    assert r.search('?',conversation_id='a',top_k=1)==[]
