+class TraceHybridPairChunkRetriever(TracePairChunkRetriever):
+    """Opt-in RRF over the same private pair chunks. Provider is caller-owned.
+
+    Provider exposes ``identity`` (model, index, similarity, normalization) and
+    ``build(conversation_id, rows)`` / ``search(question, conversation_id,
+    limit)``. Build rows contain the actual event id, line and text. Search
+    returns ranked {id, source_line} mappings, never invented identifiers.
+    """
+
+    name = "trace_hybrid_rrf60"
+
+    def __init__(self, chunks_by_conversation, *, vector_provider, candidate_depth,
+                 **kwargs):
+        if not isinstance(candidate_depth, int) or isinstance(candidate_depth, bool) or candidate_depth < 1:
+            raise ValueError("candidate_depth must be a positive integer")
+        identity = getattr(vector_provider, "identity", None)
+        if not isinstance(identity, Mapping) or any(not identity.get(k) for k in
+                ("model", "index", "similarity", "normalization")):
+            raise ValueError("provider must declare model, index, similarity and normalization")
+        if not callable(getattr(vector_provider, "build", None)) or not callable(getattr(vector_provider, "search", None)):
+            raise ValueError("provider must implement build and search")
+        self.provider = vector_provider
+        self.candidate_depth = candidate_depth
+        self.provenance = {"retriever": self.name, "rrf_k": 60,
+                           "candidate_depth": candidate_depth, "vector": dict(identity)}
+        super().__init__(chunks_by_conversation, **kwargs)
+        # Read all IDs from the actual private trace store, scoped to the current run.
+        conn = sqlite3.connect(f"file:{self.db_path}?mode=ro", uri=True)
+        try:
+            rows = conn.execute("SELECT id, source_line, session_id FROM event WHERE source=?",
+                                (TRACE_SOURCE,)).fetchall()
+        finally:
+            conn.close()
+        self._indexed = {str(cid): {} for cid in self._chunks}
+        for event_id, line, cid in rows:
+            cid = str(cid)
+            if cid not in self._indexed or not isinstance(line, int) or not 0 <= line < len(self._chunks[cid]):
+                raise TraceRetrieverUnavailable("invalid private trace event coordinates")
+            self._indexed[cid][event_id] = line
+        for cid, chunks in self._chunks.items():
+            if len(self._indexed[str(cid)]) != len(chunks):
+                raise TraceRetrieverUnavailable("private trace index does not match pair chunks")
+            vector_provider.build(str(cid), [{"id": event_id, "source_line": line,
+                                             "text": chunks[line]}
+                                            for event_id, line in self._indexed[str(cid)].items()])
+
+    def search(self, question: str, *, conversation_id: str, top_k: int) -> list[int]:
+        from tulving_trace_retriever import fts_query
+
+        cid = str(conversation_id)
+        if cid not in self._indexed:
+            raise KeyError(conversation_id)
+        if top_k <= 0:
+            return []
+        candidates = self.provider.search(question, cid, self.candidate_depth)
+        if not isinstance(candidates, (list, tuple)) or len(candidates) > self.candidate_depth:
+            raise TraceRetrieverUnavailable("invalid vector candidate list")
+        ids = []
+        for candidate in candidates:
+            if not isinstance(candidate, Mapping):
+                raise TraceRetrieverUnavailable("invalid vector candidate")
+            event_id, line = candidate.get("id"), candidate.get("source_line")
+            if isinstance(event_id, bool) or not isinstance(event_id, int) or event_id in ids:
+                raise TraceRetrieverUnavailable("invalid or duplicate vector candidate id")
+            if isinstance(line, bool) or not isinstance(line, int) or self._indexed[cid].get(event_id) != line:
+                raise TraceRetrieverUnavailable("vector candidate not in conversation or line mismatch")
+            ids.append(event_id)
+        rows = self._navigation.get_records(ids, db_path=self.db_path)
+        if len(rows) != len(ids):
+            raise TraceRetrieverUnavailable("vector candidate missing from private trace store")
+        for row, event_id in zip(rows, ids):
+            if row["id"] != event_id or row["source"] != TRACE_SOURCE or str(row["session_id"]) != cid or row["source_line"] != self._indexed[cid][event_id]:
+                raise TraceRetrieverUnavailable("vector candidate private-store mismatch")
+        query = fts_query(question)
+        if query:
+            # Search each list at candidate_depth; trim only after fusion.
+            fused = self._navigation.search_records(
+                query, db_path=self.db_path, limit=self.candidate_depth,
+                order="relevance", source=TRACE_SOURCE, session_id=cid,
+                vector_rows=rows, rrf_k=60)
+        else:
+            # An empty lexical query still retains the vector arm.
+            fused = self._navigation.rrf_fuse([rows], k=60, limit=self.candidate_depth)
+        return sorted(int(row["source_line"]) for row in fused[:top_k])
+
+
 __all__ = [
     "CHUNKING", "BM25_RETRIEVER", "TRACE_RETRIEVER", "TRACE_SOURCE",
