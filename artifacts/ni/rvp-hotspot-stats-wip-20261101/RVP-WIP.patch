+@dataclass(frozen=True)
+class RocprofV1KernelStats:
+    kernel_name: str
+    calls: int
+    total_duration_ns: int
+    share_of_device_time: float
+
+
+ROCPROF_V1_CANDIDATES = (
+    "/mnt/raid0/llm/tools/rocm-profilers-6.2/opt/rocm-6.2.0/bin/rocprof",
