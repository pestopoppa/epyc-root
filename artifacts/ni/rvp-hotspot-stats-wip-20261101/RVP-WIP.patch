+def parse_rocprof_v1_stats(csv_text: str, *, limit: int = 12) -> list[RocprofV1KernelStats]:
+    """Parse native rocprof-v1 ``--stats`` rows and preserve whole-profile shares."""
+    if limit <= 0:
+        raise RocprofV1StatsError("rocprof v1 stats limit must be positive")
+    reader = csv.DictReader(io.StringIO(csv_text), strict=True)
+    try:
+        fieldnames = reader.fieldnames
+    except csv.Error as exc:
+        raise RocprofV1StatsError(f"malformed rocprof v1 stats CSV header: {exc}") from exc
+    if tuple(fieldnames or ()) != _ROCPROF_V1_STATS_COLUMNS:
+        raise RocprofV1StatsError(
+            "rocprof v1 stats CSV must have columns "
+            + ",".join(_ROCPROF_V1_STATS_COLUMNS))
+
+    def strict_rows():
+        try:
+            yield from reader
+        except csv.Error as exc:
+            raise RocprofV1StatsError(f"malformed rocprof v1 stats CSV: {exc}") from exc
+
+    totals: dict[str, list[int]] = {}
+    for row in strict_rows():
+        if all(value is None or not str(value).strip() for value in row.values()):
+            continue
+        if None in row or any(row.get(column) is None for column in _ROCPROF_V1_STATS_COLUMNS):
+            raise RocprofV1StatsError("rocprof v1 stats CSV has a malformed row")
+        if any(not str(row[column]).strip() for column in _ROCPROF_V1_STATS_COLUMNS):
+            raise RocprofV1StatsError("rocprof v1 stats CSV has an empty field")
+        name = str(row["Name"]).strip()
+        if not name:
+            raise RocprofV1StatsError("rocprof v1 stats CSV has an empty kernel name")
+        try:
+            calls = int(row["Calls"])
+            duration = int(row["TotalDurationNs"])
+            average = float(row["AverageNs"])
+            percentage = float(row["Percentage"])
+        except (TypeError, ValueError, OverflowError) as exc:
+            raise RocprofV1StatsError("rocprof v1 stats CSV has invalid numeric fields") from exc
+        if calls <= 0 or duration <= 0:
+            raise RocprofV1StatsError(
+                "rocprof v1 stats CSV requires positive Calls and TotalDurationNs")
+        if (not math.isfinite(average) or not math.isfinite(percentage)
+                or average < 0 or percentage < 0 or percentage > 100.000001):
+            raise RocprofV1StatsError("rocprof v1 stats CSV has an invalid numeric field")
+        bucket = totals.setdefault(name, [0, 0])
+        bucket[0] += duration
+        bucket[1] += calls
+
+    grand_total = sum(duration for duration, _ in totals.values())
+    if grand_total <= 0:
+        raise RocprofV1StatsError("rocprof v1 stats CSV contains no usable kernel rows")
+    rows = [RocprofV1KernelStats(name, calls, duration, duration / grand_total)
+            for name, (duration, calls) in totals.items()]
+    rows.sort(key=lambda row: (-row.total_duration_ns, row.kernel_name))
+    return rows[:limit]
+
+
+def _profiler_env_rocprof_v1(binary: Path) -> dict[str, str]:
+    """Pin the target's ggml first; the v1 wrapper supplies its own RPL paths."""
+    from .loop import residency
+
+    env = residency.loader_env(binary)
+    env.pop("ROCPROFILER_METRICS_PATH", None)
+    env.pop("ROCP_METRICS_PATH", None)
+    return env
+
+
+def _rocprof_process_info(pid: int) -> tuple[str, int, str] | None:
+    """Read one process's state, process group and start ticks from its proc stat."""
+    try:
+        raw = Path(f"/proc/{pid}/stat").read_text(encoding="ascii")
+    except (FileNotFoundError, ProcessLookupError, PermissionError, OSError):
+        return None
+    close = raw.rfind(")")
+    if close < 0:
+        return None
+    fields = raw[close + 2:].split()
+    if len(fields) <= 19:
+        return None
+    try:
+        return fields[0], int(fields[2]), fields[19]
+    except ValueError:
+        return None
+
+
+def _rocprof_group_has_live_members(pgid: int) -> bool:
+    """True while a non-zombie process remains in this captured profiler group."""
+    try:
+        entries = Path("/proc").iterdir()
+        for entry in entries:
+            if not entry.name.isdecimal():
+                continue
+            info = _rocprof_process_info(int(entry.name))
+            if info is not None and info[1] == pgid and info[0] != "Z":
+                return True
+    except OSError:
+        return True  # inability to verify the group is not a clean drain
+    return False
+
+
+def _terminate_rocprof_group(process: subprocess.Popen, *, pid: int,
+                             start_ticks: str, pgid: int,
+                             grace_s: float = 1.0) -> None:
+    """Terminate only the Popen-created session and prove its live members drained."""
+    leader = _rocprof_process_info(pid)
+    if leader is not None:
+        state, observed_pgid, observed_start = leader
+        if observed_start == start_ticks and observed_pgid != pgid:
+            raise RocprofV1StatsError("captured rocprof leader changed process group")
+        if observed_start != start_ticks and observed_pgid == pgid:
+            raise RocprofV1StatsError("rocprof process-group leader identity changed")
+
+    if _rocprof_group_has_live_members(pgid):
+        try:
+            os.killpg(pgid, signal.SIGTERM)
+        except ProcessLookupError:
+            pass
+        try:
+            process.communicate(timeout=grace_s)
+        except subprocess.TimeoutExpired:
+            pass
+
+    deadline = time.monotonic() + grace_s
+    while _rocprof_group_has_live_members(pgid) and time.monotonic() < deadline:
+        time.sleep(0.05)
+
+    if _rocprof_group_has_live_members(pgid):
+        try:
+            os.killpg(pgid, signal.SIGKILL)
+        except ProcessLookupError:
+            pass
+        try:
+            process.communicate(timeout=grace_s)
+        except subprocess.TimeoutExpired:
+            pass
+        deadline = time.monotonic() + grace_s
+        while _rocprof_group_has_live_members(pgid) and time.monotonic() < deadline:
+            time.sleep(0.05)
+
+    if _rocprof_group_has_live_members(pgid):
+        raise RocprofV1StatsError("rocprof process group did not drain after SIGKILL")
+    try:
+        process.wait(timeout=grace_s)
+    except subprocess.TimeoutExpired as exc:
+        raise RocprofV1StatsError("rocprof leader did not exit after process-group drain") from exc
+
+
+def _run_rocprof_v1(argv: Sequence[str], *, binary: Path,
+                    timeout_s: int) -> tuple[int, str, str]:
+    try:
+        process = subprocess.Popen(
+            argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE, text=True, start_new_session=True,
+            env=_profiler_env_rocprof_v1(binary))
+    except OSError as exc:
+        raise RocprofV1StatsError(f"rocprof v1 could not be started: {exc}") from exc
+
+    pid = process.pid
+    pgid = pid  # start_new_session makes the child its own process-group leader
+    identity = _rocprof_process_info(pid)
+    if identity is None or identity[1] != pgid:
+        _terminate_rocprof_group(process, pid=pid,
+                                 start_ticks=identity[2] if identity else "",
+                                 pgid=pgid)
+        raise RocprofV1StatsError("could not pin rocprof PID/start-time/process-group identity")
+    start_ticks = identity[2]
+
+    try:
+        stdout, stderr = process.communicate(timeout=timeout_s)
+    except subprocess.TimeoutExpired as exc:
+        _terminate_rocprof_group(process, pid=pid, start_ticks=start_ticks, pgid=pgid)
+        raise RocprofV1StatsError(
+            f"rocprof v1 timed out after {timeout_s}s; owned process group drained") from exc
+    except BaseException:
+        _terminate_rocprof_group(process, pid=pid, start_ticks=start_ticks, pgid=pgid)
+        raise
+
+    if _rocprof_group_has_live_members(pgid):
+        _terminate_rocprof_group(process, pid=pid, start_ticks=start_ticks, pgid=pgid)
+        raise RocprofV1StatsError(
+            "rocprof v1 exited while child processes remained; owned process group drained")
+    return process.returncode, stdout, stderr
+
+
+def capture_rocprof_v1_stats(binary: Path, model: Path, *, pp: int, tg: int,
+                             limit: int = 12,
+                             timeout_s: int = 1800) -> list[RocprofV1KernelStats]:
+    """Capture only the legacy loop's transient ROCm 6.2 v1 ``--stats`` profile."""
+    resolved = _resolve_rocprof_v1()
+    if resolved is None:
+        raise RocprofV1StatsError(
+            "no ROCm 6.2 rocprof v1 found; tried "
+            + ", ".join(ROCPROF_V1_CANDIDATES))
+    with tempfile.TemporaryDirectory() as tmp:
+        out = Path(tmp)
+        output = out / "profile.csv"
+        argv = [resolved, "--tool-version", "1", "-o", str(output), "--stats",
+                str(binary), "-m", str(model), "-p", str(pp), "-n", str(tg),
+                "-r", "1", "-ngl", "99", "-fa", "1", "-o", "json"]
+        returncode, stdout, stderr = _run_rocprof_v1(
+            argv, binary=binary, timeout_s=timeout_s)
+        if returncode != 0:
+            raise RocprofV1StatsError(
+                f"rocprof v1 rc={returncode} via {resolved}: "
+                f"{(stderr or stdout)[-400:]}")
+        stats = sorted(out.rglob("*.stats.csv"))
+        if len(stats) != 1:
+            raise RocprofV1StatsError(
+                f"rocprof v1 produced {len(stats)} stats CSV files; expected exactly one")
+        try:
+            csv_text = stats[0].read_text(encoding="utf-8")
+        except (OSError, UnicodeError) as exc:
+            raise RocprofV1StatsError(f"rocprof v1 stats CSV could not be read: {exc}") from exc
+        return parse_rocprof_v1_stats(csv_text, limit=limit)
+
