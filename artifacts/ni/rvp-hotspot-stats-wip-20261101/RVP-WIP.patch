+"""Hermetic coverage for the legacy ROCm 6.2 rocprof-v1 stats profile."""
+from pathlib import Path
+import json
+import sys
+import time
+
+import pytest
+
+from .. import prior_art
+from . import hotspots
+
+
+V1_STATS = """Name,Calls,TotalDurationNs,AverageNs,Percentage
+kernel_a,1,100,100,50.0
+kernel_b,2,60,30,30.0
+kernel_c,1,40,40,20.0
+"""
+
+
+def _fake_rocprof(tmp_path, monkeypatch, mode="success"):
+    script = tmp_path / "rocprof-v1-fixture"
+    script.write_text(
+        "#!" + sys.executable + "\n"
+        "import os, subprocess, sys, time\n"
+        "mode = os.environ['V1_TEST_MODE']\n"
+        "pidfile = os.environ.get('V1_TEST_PID_FILE')\n"
+        "record = os.environ.get('V1_TEST_RECORD')\n"
+        "if record:\n"
+        "    import json\n"
+        "    with open(record, 'w') as f: json.dump({'argv': sys.argv[1:], 'ld': os.environ.get('LD_LIBRARY_PATH'), 'metrics': [os.environ.get('ROCPROFILER_METRICS_PATH'), os.environ.get('ROCP_METRICS_PATH')]}, f)\n"
+        "if mode == 'success':\n"
+        "    out = sys.argv[sys.argv.index('-o') + 1]\n"
+        "    with open(out[:-4] + '.stats.csv', 'w') as f:\n"
+        f"        f.write({V1_STATS!r})\n"
+        "elif mode in ('timeout', 'exit_with_child'):\n"
+        "    child = subprocess.Popen([sys.executable, '-c', 'import time; time.sleep(60)'],\n"
+        "                             stdout=None if mode == 'timeout' else subprocess.DEVNULL,\n"
+        "                             stderr=None if mode == 'timeout' else subprocess.DEVNULL)\n"
+        "    if pidfile:\n"
+        "        with open(pidfile, 'w') as f: f.write(f'{os.getpid()} {child.pid}')\n"
+        "    if mode == 'timeout': time.sleep(60)\n"
+        "    time.sleep(0.2)\n"
+        "    sys.exit(7)\n",
+        encoding="utf-8")
+    script.chmod(0o755)
+    monkeypatch.setattr(prior_art, "_resolve_rocprof_v1", lambda: str(script))
+    monkeypatch.setenv("V1_TEST_MODE", mode)
+    return script
+
+
+def _wait_owned_pids_dead(pid_file):
+    deadline = time.monotonic() + 3
+    while time.monotonic() < deadline:
+        pids = [int(pid) for pid in pid_file.read_text().split()]
+        live = []
+        for pid in pids:
+            try:
+                stat = Path(f"/proc/{pid}/stat").read_text()
+            except FileNotFoundError:
+                continue
+            state = stat[stat.rfind(")") + 2:].split()[0]
+            if state != "Z":
+                live.append(pid)
+        if not live:
+            return
+        time.sleep(0.05)
+    raise AssertionError(f"owned fake profiler PIDs remain live: {live}")
+
+
+def test_v1_stats_share_uses_all_rows_before_limit_and_keeps_native_totals():
+    rows = prior_art.parse_rocprof_v1_stats(V1_STATS, limit=2)
+
+    assert [(row.kernel_name, row.calls, row.total_duration_ns) for row in rows] == [
+        ("kernel_a", 1, 100), ("kernel_b", 2, 60),
+    ]
+    assert [row.share_of_device_time for row in rows] == pytest.approx([0.5, 0.3])
+    assert sum(row.share_of_device_time for row in rows) == pytest.approx(0.8)
+
+
+@pytest.mark.parametrize("csv_text", [
+    "Name,Calls,TotalDurationNs,AverageNs\nk,1,10,10\n",
+    "Name,Calls,TotalDurationNs,AverageNs,Percentage\n",
+    "Name,Calls,TotalDurationNs,AverageNs,Percentage\nk,0,10,10,100.0\n",
+    "Name,Calls,TotalDurationNs,AverageNs,Percentage\nk,1,-1,-1,100.0\n",
+    "Name,Calls,TotalDurationNs,AverageNs,Percentage\nk,1,10,nan,100.0\n",
+    "Name,Calls,TotalDurationNs,AverageNs,Percentage\nk,1,10,-1,100.0\n",
+    "Name,Calls,TotalDurationNs,AverageNs,Percentage\nk,1,10,10,-1.0\n",
+    "Name,Calls,TotalDurationNs,AverageNs,Percentage\nk,1,10,10,100.1\n",
+    'Name,Calls,TotalDurationNs,AverageNs,Percentage\n"unterminated,1,10,10,100.0\n',
+    '"unterminated header\n',
+])
+def test_v1_stats_refuses_malformed_or_unusable_csv(csv_text):
+    with pytest.raises(prior_art.RocprofV1StatsError):
+        prior_art.parse_rocprof_v1_stats(csv_text)
+
+
+def test_profile_runs_pinned_v1_stats_and_reads_the_stats_suffix(tmp_path, monkeypatch):
+    binary = tmp_path / "build" / "bin" / "llama-bench"
+    model = tmp_path / "model.gguf"
+    binary.parent.mkdir(parents=True)
+    binary.touch()
+    model.touch()
+    _fake_rocprof(tmp_path, monkeypatch)
+    monkeypatch.setenv("ROCPROFILER_METRICS_PATH", "/v3/share")
+    monkeypatch.setenv("ROCP_METRICS_PATH", "/v3/share")
+    record = tmp_path / "invocation.json"
+    monkeypatch.setenv("V1_TEST_RECORD", str(record))
+    rows = hotspots.profile(binary, model, pp=512, tg=32, limit=2, timeout_s=123)
+    observed = json.loads(record.read_text())
+    argv = observed["argv"]
+    assert argv[:5] == ["--tool-version", "1", "-o", argv[3], "--stats"]
+    assert argv[3].endswith("/profile.csv")
