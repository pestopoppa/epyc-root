+    assert argv[11:] == ["32", "-r", "1", "-ngl", "99", "-fa", "1", "-o", "json"]
+    assert "--kernel-trace" not in argv and "-d" not in argv
+    assert observed["ld"].startswith(f"{binary.parent}:")
+    assert observed["metrics"] == [None, None]
+    assert [row.signature for row in rows] == ["kernel_a", "kernel_b"]
