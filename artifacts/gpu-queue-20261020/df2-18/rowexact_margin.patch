+// ---- DF2-18 additive instrumentation (does not change any comparison) -----------------------
+static uint64_t fnv1a(const uint8_t * p, size_t n, uint64_t h) {
+    for (size_t i = 0; i < n; i++) { h ^= p[i]; h *= 1099511628211ULL; }
+    return h;
+}
+static uint64_t digest_recs(const std::vector<rec> & v) {
+    uint64_t h = 1469598103934665603ULL;
+    for (const auto & r : v) { h = fnv1a((const uint8_t *) r.name.data(), r.name.size(), h); h = fnv1a(r.data.data(), r.data.size(), h); }
+    return h;
+}
+static void top2(const std::vector<float> & a, int & i1, int & i2, double & margin) {
+    i1 = 0; i2 = -1;
+    for (size_t i = 1; i < a.size(); i++) if (a[i] > a[i1]) i1 = i;
+    for (size_t i = 0; i < a.size(); i++) { if ((int) i == i1) continue; if (i2 < 0 || a[i] > a[i2]) i2 = i; }
+    margin = (double) a[i1] - (double) a[i2];
+}
