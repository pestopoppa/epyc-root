+#!/usr/bin/env python3
+"""Read the pinned original production banks and report exact pack refusals."""
+import argparse
+import base64
+import json
+from pathlib import Path
+
+import quality_parity as parity
+
+PINS = {
+    'frontdoor-cpu-moe-mtp': ('native', 'frontdoor_slice'),
+    'worker-general-cpu-moe-mtp': ('worker-general', 'worker_general_slice'),
+    'architect-critic-cpu-mtp': ('architect-critic', 'architect_critic_slice'),
+    'ingest-long-context-recurrent-no-spec': ('ingest-long-context', 'ingest_long_context_slice'),
+    'architect-general-hip': ('architect-general-hip-smoke', 'hip_slice'),
+    'worker-vision-hip-mmproj': ('worker-vision', 'hip_slice'),
+    'dspark-dflash': ('dspark-dflash', 'cpu_slice'),
+}
+
+
+def original_bytes(path):
+    if path.is_file():
+        return path.read_bytes()
+    envelope = json.loads(path.with_suffix(path.suffix + '.original-bytes.json').read_bytes())
+    raw = base64.b64decode(envelope['bytes_b64'], validate=True)
+    if parity._sha256(raw) != envelope['sha256']:
+        raise ValueError(f'original-bytes envelope mismatch for {path}')
+    return raw
+
+
+def checked_read(path, pin):
+    raw = original_bytes(path)
+    if parity._sha256(raw) != pin:
+        raise ValueError(f'receipt hash mismatch for {path}')
+    return raw
+
+
+def audit_profile(root, profile, recipe_key):
+    plan_path = root / ('successor' if profile == 'dspark-dflash' else '') / 'plan.json'
+    plan_raw = original_bytes(plan_path)
+    plan = json.loads(plan_raw)
+    plan_pin = parity._sha256(plan_raw)
+    facts = {
+        'plan_path': str(plan_path),
+        'plan_sha256': plan_pin,
+        'item_count': len(plan['items']),
+        'fixture_tags': sorted({i['fixture'] for i in plan['items'] if i.get('fixture')}),
+        'missing_expected_finish': [i['id'] for i in plan['items'] if 'expected_finish' not in i],
+        'missing_versioned_validator': [i['id'] for i in plan['items'] if 'validator' not in i],
+        'candidate_read': False,
+    }
+    full_capture = root / 'full-capture'
+    if not (full_capture / 'receipt.json').is_file():
+        return {**facts, 'status': 'no_filed_complete_production_bank'}
+    receipt_path = full_capture / 'receipt.json'
+    receipt = json.loads(receipt_path.read_bytes())
+    if receipt['rc'] != 0 or receipt['verdict'] != 'pass':
+        raise ValueError(f'original capture did not finish successfully: {receipt_path}')
+    files = receipt.get('files_sha256', receipt.get('files'))
+    bank_key = 'native/banked-capture.json'
+    bank_pin = receipt.get('bank_sha256') or receipt['original_files_sha256'][bank_key]
+    bank = json.loads(checked_read(full_capture / bank_key, bank_pin))
+    if bank['capture_identity']['request_plan_sha256'] != plan_pin:
+        raise ValueError(f'bank refers to another plan: {receipt_path}')
+    cleanup_path = 'native/production/cleanup.json'
+    cleanup = json.loads(checked_read(full_capture / cleanup_path, files[cleanup_path]))
+    if cleanup['dead'] is not True or cleanup['port_closed'] is not True:
+        raise ValueError(f'bank cleanup failed: {receipt_path}')
+    rows = {row['id']: row for row in bank['items']}
+    if len(rows) != len(bank['items']) or rows.keys() != {item['id'] for item in plan['items']}:
+        raise ValueError(f'bank items differ from filed plan: {receipt_path}')
+    endpoint = plan['recipes'][recipe_key]['endpoint']
+    checks = {}
+    for item in plan['items']:
+        name = item['id']
+        request_path = f'native/production/{name}.request.json'
+        response_path = f'native/production/{name}.response.json'
+        request = checked_read(full_capture / request_path, files[request_path])
+        response = checked_read(full_capture / response_path, files[response_path])
+        request_body = item.get('request_body', json.loads(request))
+        if request != parity.canonical_json(request_body):
+            raise ValueError(f'original request differs from canonical plan: {request_path}')
+        record = {key: value for key, value in rows[name].items() if key != 'id'}
+        if response != base64.b64decode(record['response_b64'], validate=True):
+            raise ValueError(f'original response differs from bank: {response_path}')
+        _, limit = parity._request(request_body, endpoint)
+        content, _, finish, tokens, count = parity._capture(
+            record, parity._sha256(request), endpoint, None, limit,
+        )
+        errors = []
+        if finish != item['expected_finish']:
+            errors.append('finish_mismatch')
+        if not parity._semantic_matches(item['validator'], content):
+            errors.append('semantic_validation_failed')
+        if tokens is None:
+            errors.append('missing_output_token_ids')
+        if count is None:
+            errors.append('missing_completion_count')
+        if item['output_format'] == 'json' and item['validator']['id'] != 'json-object-subset.v1':
+            errors.append('json_object_validator_required')
+        checks[name] = {
+            'expected_finish': item['expected_finish'],
+            'actual_finish': finish,
+            'completion_count': count,
+            'output_token_count': None if tokens is None else len(tokens),
+            'validator': item['validator'],
+            'response_sha256': record['response_sha256'],
+            'response_path': str(full_capture / response_path),
+            'problems': errors,
+        }
+    return {
+        **facts,
+        'receipt_path': str(receipt_path),
+        'receipt_sha256': parity._sha256(receipt_path.read_bytes()),
+        'bank_sha256': bank_pin,
+        'status': 'inadmissible_bank' if any(c['problems'] for c in checks.values()) else 'item_checks_passed',
+        'checks': checks,
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--repo', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+    profiles = {
+        profile: audit_profile(args.repo / f'data/vidya/quality-pack-{leaf}-20261118', profile, recipe)
+        for profile, (leaf, recipe) in PINS.items()
+    }
+    fixtures = {fixture for p in profiles.values() for fixture in p['fixture_tags']}
+    report = {
+        'status': 'pack_blocked',
+        'pack_created': False,
+        'candidate_collected': False,
+        'validator_source_sha256': parity.VALIDATOR_SOURCE_SHA256,
+        'candidate_order': 'full production pack must be built and pinned before any new candidate launch',
+        'missing_fixture_tags': sorted(parity.FIXTURES - fixtures),
+        'profiles': profiles,
+    }
+    with args.output.open('xb') as stream:
+        stream.write(parity.pack_bytes(report))
+
+
+if __name__ == '__main__':
+    main()
