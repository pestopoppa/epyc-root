diff --git a/scripts/kernel_rnd/autokernel/loop/test_belief_model_preflight.py b/scripts/kernel_rnd/autokernel/loop/test_belief_model_preflight.py
new file mode 100644
index 000000000..1ec403d5a
--- /dev/null
+++ b/scripts/kernel_rnd/autokernel/loop/test_belief_model_preflight.py
@@ -0,0 +1,51 @@
+import hashlib
+import os
+from pathlib import Path
+
+import pytest
+
+from . import belief_model_preflight as preflight
+from .resolved_recipe import ArtifactDigest
+
+
+def test_verified_receipt_binds_bytes_and_verifies_without_hashing(tmp_path, monkeypatch):
+    model = tmp_path / "test.gguf"
+    model.write_bytes(b"fixture bytes")
+    digest = hashlib.sha256(model.read_bytes()).hexdigest()
+    wrong = "0" * 64
+    with pytest.raises(ValueError, match="differ from expected"):
+        preflight.capture(model, wrong)
+    receipt = preflight.capture(model, digest)
+
+    def refuse_hash(*_args):
+        pytest.fail("runtime verification read model bytes")
+
+    monkeypatch.setattr(preflight.hashlib, "file_digest", refuse_hash)
+    alias = tmp_path / "model-alias.gguf"
+    alias.symlink_to(model)
+    launch = ArtifactDigest("model", str(model), digest)
+    assert preflight.verify(receipt, alias, launch) == digest
+    with pytest.raises(ValueError, match="differs"):
+        preflight.verify(receipt, alias, ArtifactDigest("model", str(model), wrong))
+    with pytest.raises(ValueError, match="differs"):
+        preflight.verify({}, alias, launch)
+
+    replacement = tmp_path / "replacement.gguf"
+    replacement.write_bytes(b"fixture bytes")
+    alias.unlink()
+    alias.symlink_to(replacement)
+    with pytest.raises(ValueError, match="path differs"):
+        preflight.verify(receipt, alias, launch)
+    original = model.stat()
+    model.write_bytes(b"changed bytes")
+    os.utime(model, ns=(original.st_atime_ns, original.st_mtime_ns))
+    with pytest.raises(ValueError, match="identity"):
+        preflight.verify(receipt, model, launch)
+
+
+def test_split_shard_cannot_be_promoted_as_the_full_model(tmp_path):
+    first = tmp_path / "claimed-00001-of-00002.gguf"
+    first.write_bytes(b"first")
+    (tmp_path / "claimed-00002-of-00002.gguf").write_bytes(b"second")
+    with pytest.raises(ValueError, match="whole-model"):
+        preflight.capture(first, hashlib.sha256(b"first").hexdigest())
