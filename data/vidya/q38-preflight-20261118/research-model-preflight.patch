diff --git a/scripts/kernel_rnd/autokernel/loop/belief_model_preflight.py b/scripts/kernel_rnd/autokernel/loop/belief_model_preflight.py
new file mode 100644
index 000000000..778c0848a
--- /dev/null
+++ b/scripts/kernel_rnd/autokernel/loop/belief_model_preflight.py
@@ -0,0 +1,80 @@
+"""Verify an enrolled single-file model before a grant; recheck its identity by stat."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import stat
+
+from ..controller import workload_contract
+
+SCHEMA = "epyc.autokernel.belief_model_preflight.v1"
+
+
+def _single_file(path: Path) -> Path:
+    resolved = path.resolve(strict=True)
+    for name in {path.absolute(), resolved}:
+        if workload_contract.split_shards(name) != [name]:
+            raise ValueError("split model requires a whole-model digest contract")
+    return resolved
+
+
+def _identity(info: os.stat_result) -> list[int]:
+    if not stat.S_ISREG(info.st_mode) or info.st_size <= 0:
+        raise ValueError("model must be a nonempty regular file")
+    return [info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns]
+
+
+def _receipt(path: Path, sha256: str, identity: list[int]) -> dict:
+    if not re.fullmatch(r"[a-f0-9]{64}", sha256):
+        raise ValueError("expected model SHA-256 must be 64 lowercase hex digits")
+    return {"schema": SCHEMA, "path": str(path), "sha256": sha256,
+            "identity": dict(zip(("device", "inode", "size", "mtime_ns", "ctime_ns"), identity))}
+
+
+def capture(model: Path, expected_sha256: str) -> dict:
+    """Hash once outside the grant and confirm the expected content and stable name."""
+    path = _single_file(model)
+    named = _identity(path.stat())
+    with os.fdopen(os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW), "rb") as stream:
+        before = _identity(os.fstat(stream.fileno()))
+        if before != named:
+            raise ValueError("model changed before preflight hash")
+        digest = hashlib.file_digest(stream, "sha256").hexdigest()
+        after = _identity(os.fstat(stream.fileno()))
+    if before != after or _single_file(model) != path or _identity(path.stat()) != before:
+        raise ValueError("model changed during preflight hash")
+    if digest != expected_sha256:
+        raise ValueError("model bytes differ from expected SHA-256")
+    return _receipt(path, digest, before)
+
+
+def verify(receipt: dict, model: Path, launch_model) -> str:
+    """Require the trusted preflight receipt to match the launch and current file."""
+    path = _single_file(model)
+    if _single_file(Path(launch_model.path)) != path:
+        raise ValueError("model preflight path differs from selected launch")
+    expected = _receipt(path, launch_model.sha256, _identity(path.stat()))
+    if receipt != expected:
+        raise ValueError("model preflight differs from selected launch or current file identity")
+    return expected["sha256"]
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("model", type=Path)
+    parser.add_argument("expected_sha256")
+    args = parser.parse_args()
+    try:
+        receipt = capture(args.model, args.expected_sha256)
+    except (OSError, ValueError, workload_contract.WorkloadContractError) as exc:
+        parser.error(str(exc))
+    print(json.dumps(receipt, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
