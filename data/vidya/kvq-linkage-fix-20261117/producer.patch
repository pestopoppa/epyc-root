+def _binary_identity_for_witness(binary: dict[str, Any]) -> dict[str, Any]:
+    """Ignore only ASLR load addresses printed by ldd; retain all identity evidence."""
+    normalized = copy.deepcopy(binary)
+    receipt = normalized.get("linkage_receipt")
+    ldd = receipt.get("ldd") if isinstance(receipt, dict) else None
+    if isinstance(ldd, dict) and isinstance(ldd.get("stdout"), str):
+        # ldd appends process-specific mappings as ``(0x...)``. Paths, SONAMEs,
+        # return code, stderr, verifier output, and stable file identities remain exact.
+        ldd["stdout"] = re.sub(r"(?m)(\s)\(0x[0-9a-fA-F]+\)(?=\s*$)", r"\1<ASLR>", ldd["stdout"])
+    return normalized
