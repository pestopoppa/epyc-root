 ACTOR_CALL_LOG = actor_metrics.CALL_LOG_NAME
 
 
+def _begin_vidya_campaign(backend: Backend, env):
+    """Take direct-server and offered context bytes while the owning call has them."""
+    import uuid
+    import urllib.request
+    from . import actor_serving
+
+    campaign = {"call_id": uuid.uuid4().hex, "metrics": None}
+    try:
+        endpoint = _provider_base_url(backend.model)
+        if not endpoint or not actor_serving.is_local(endpoint):
+            raise ValueError("direct actor endpoint must be loopback")
+        url = actor_serving.server_root(endpoint) + "/props"
+        # A native actor slot is local. Follow neither a system proxy nor a redirect.
+        class DirectProps(urllib.request.HTTPRedirectHandler):
+            def redirect_request(self, req, fp, code, msg, headers, newurl):
+                return None
+
+        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), DirectProps())
+        with opener.open(url, timeout=4) as response:
+            raw = response.read(1024 * 1024 + 1)
+            if not 0 < len(raw) <= 1024 * 1024:
+                raise ValueError("/props response exceeded the capture bound")
+        campaign["props_raw"] = raw
+        campaign["props_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+        campaign["endpoint"] = endpoint
+        manifest = (env or {}).get(SEAT_ENV_BUNDLE_MANIFEST)
+        if manifest:
+            with Path(manifest).open("rb") as stream:
+                campaign["bundle_raw"] = stream.read(1024 * 1024 + 1)
+    except (OSError, TypeError, ValueError) as exc:
+        campaign["capture_error"] = f"{type(exc).__name__}: {exc}"
+    campaign["started"] = time.time()
+    campaign["started_monotonic"] = time.monotonic()
+    return campaign
+
