{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "fdisk*": "deny",
      "sudo fdisk*": "deny",
      "mke2fs*": "deny",
      "sudo mke2fs*": "deny",
      "mkswap*": "deny",
      "sudo mkswap*": "deny",
      "modprobe*": "deny",
      "sudo modprobe*": "deny",
      "mount*": "deny",
      "sudo mount*": "deny",
      "parted*": "deny",
      "sudo parted*": "deny",
      "reboot*": "deny",
      "sudo reboot*": "deny",
      "shutdown*": "deny",
      "sudo shutdown*": "deny",
      "systemctl*": "deny",
      "sudo systemctl*": "deny",
      "umount*": "deny",
      "sudo umount*": "deny",
      "mkfs*": "deny",
      "sudo mkfs*": "deny",
      "apt autoremove*": "deny",
      "apt install*": "deny",
      "apt purge*": "deny",
      "apt remove*": "deny",
      "apt-get autoremove*": "deny",
      "apt-get install*": "deny",
      "apt-get purge*": "deny",
      "apt-get remove*": "deny",
      "dpkg -i*": "deny",
      "dpkg --install*": "deny",
      "dpkg -r*": "deny",
      "dpkg --remove*": "deny",
      "dpkg -P*": "deny",
      "dpkg --purge*": "deny",
      "dd of=/dev/*": "deny"
    }
  }
