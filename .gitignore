# Repos (cloned by scripts/clone-repos.sh)
repos/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Runtime
logs/*.log
!logs/agent_audit.log
*.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude Code ephemeral
.claude/plans/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Temp
tmp/*
!tmp/.gitkeep
.gitnexus
core
.coverage
.last_compile

# Local test/compile cruft
.coverage
.coverage.*
coverage.json
.last_compile

# Backup artifacts (bundles, archives — never commit binaries)
backups/

# Compiler/profiling residue (PGO instrumented runs leave these)
*.profraw
*.profdata

# MkDocs — generated content populated by scripts/docs/build-site-src.sh
# Hand-written pages (index.md, topics/index.md, etc.) are tracked individually.
site/
site_src/topics/*.md
!site_src/topics/index.md
site_src/deep-dives/*.md
!site_src/deep-dives/index.md
site_src/stories/recent-results.md
site_src/subsystems/orchestrator/
site_src/subsystems/research/

# Handoff dashboard hub — derived timeline artifact (regenerated from git history
# by scripts/handoffs/build_handoff_timeline.py; never hand-authored or committed)
data/handoff_timeline.json
data/handoff_timeline.json.tmp.*

# Session bus: high-churn runtime state, not version-controlled.
# advisory.jsonl grows ~1 record/agent/tick; the coordinator-daemon heartbeat
# rewrites every tick. M3/M4 evidence is cited as a summary artifact, never the
# raw log. Agent-owned heartbeats stay tracked — they are written at task
# boundaries, not on a timer.
coordination/session-bus/advisory.jsonl
coordination/session-bus/heartbeats/coordinator-daemon.json
logs/bus_supervisor.out
logs/bus_supervisor.pid
logs/coordinator_daemon.log

# AutoPilot operator runtime snapshots and diagnostic payloads stay local.
# Human ratification receipts (`artifacts/operator/ratify_*.json`) remain tracked.
artifacts/operator/*.lock
artifacts/operator/autopilot_state.pre-*.json
artifacts/operator/instrument_eras.pre-*.yaml
artifacts/operator/*operational_diagnostic*.json
artifacts/operator/*operational_baseline_candidate*.json

# Vidya pilot (docs/design/vidya-pilot-spec.md §11.0)
# The ledger is the canonical record but is regenerable from its adapters and large (~7.7MB for a
# full intake ingest), so it is not committed. The CHECKPOINTS are — an externally held checkpoint
# is precisely what upgrades the ledger from tamper-evident to tamper-proof for prior history, and
# git is the external holder. Never add .vidya/checkpoints/ here.
.vidya/ledger.jsonl
.vidya/ledger.jsonl.repair
.vidya/state.sqlite
.vidya/projections/

# Generated handoff-index sidecars (A19). `scripts/handoffs/index_state.py` derives
# both of these from the index files and the handoffs themselves — they are a VIEW,
# never a source, and regenerating is a single command. Tracking them made every main
# that ran index_state.py collide with the other three on a file none of them authored,
# which is why index_state.py had to be restricted to one session. The dashboard already
# treats absence as "index_state.py has never run in this checkout" and degrades to
# "no graph" (dashboard/panels.py, absence_means), so untracking costs nothing there.
handoffs/active/.index-state.json
handoffs/active/.index-graph.json
